"""Bzlmod configuration for kitsunium/sdk.

Bazel 9 dropped WORKSPACE; this file is the single source of truth for
external dependencies. rules_go + gazelle read Go deps directly from the
workspace's go.work file so the 4 module-local go.mod files stay the
authoritative list for gopls / IDE tooling.
"""

module(
    name = "kitsunium_sdk",
    version = "0.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.50.0")

# ── Go SDK ─────────────────────────────────────────────────────────────
# `from_file(go_work=...)` reads the Go toolchain directive out of go.work
# so the SDK version stays in sync with the module declarations.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# The root go.mod advertises Go 1.26 (major.minor); rules_go expects a
# literal patch-version string for the SDK download, so we pin explicitly.
go_sdk.download(version = "1.26.2")

# ── Go dependencies ────────────────────────────────────────────────────
# `go_deps.from_file(go_work=...)` imports every direct + indirect
# dependency across all 4 go.mod files referenced by the workspace.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_work = "//:go.work")

# `bazel mod tidy` populates the use_repo block below with every direct
# import seen in the Go sources. Rerun after adding / removing a direct
# dependency; the drift check in bazel-ci.yml fails if this list goes
# out of sync with the sources.
use_repo(
    go_deps,
    "com_github_aws_aws_sdk_go_v2",
    "com_github_aws_aws_sdk_go_v2_service_cloudwatchlogs",
    "com_github_aws_aws_sdk_go_v2_service_s3",
    "com_github_aws_smithy_go",
    "com_github_clickhouse_clickhouse_go_v2",
    "com_github_fxamacker_cbor_v2",
    "com_github_go_sql_driver_mysql",
    "com_github_hashicorp_hcl_v2",
    "com_github_kitsunium_sdk_internal_core",
    "com_github_kitsunium_sdk_internal_kernel",
    "com_github_kitsunium_sdk_internal_service",
    "com_github_moby_moby_api",
    "com_github_pelletier_go_toml_v2",
    "com_github_redis_go_redis_v9",
    "com_github_testcontainers_testcontainers_go",
    "com_github_testcontainers_testcontainers_go_modules_clickhouse",
    "com_github_testcontainers_testcontainers_go_modules_mysql",
    "com_github_testcontainers_testcontainers_go_modules_redis",
    "com_github_vmihailenco_msgpack_v5",
    "in_gopkg_yaml_v3",
    "org_golang_google_protobuf",
    "org_golang_x_crypto",
    "org_mongodb_go_mongo_driver",
)
