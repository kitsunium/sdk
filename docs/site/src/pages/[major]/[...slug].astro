---
// Dynamic route for versioned docs (plan B9).
// `getStaticPaths()` enumerates every markdown file the prebuild
// script materialised under src/content/docs/<major>/**, and Astro
// statically renders one HTML page per (major, slug) tuple. The
// landing page for a major is `/<major>/` — rendered when the slug is
// empty or `index`.
import { getCollection, render } from "astro:content";
import Default from "../../layouts/Default.astro";

export async function getStaticPaths() {
  const all = await getCollection("docs");
  return all.map(entry => {
    //: entry.slug is e.g. "v1/index" or "v1/adr/0001-…".
    //: First segment is the major; everything else is the doc slug.
    const segments = entry.slug.split("/");
    const major = segments[0];
    const rest = segments.slice(1).join("/");
    return {
      params: { major, slug: rest === "" || rest === "index" ? undefined : rest },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = entry.data?.title ?? entry.slug.split("/").slice(-1)[0] ?? "Docs";
const description = entry.data?.description;
---

<Default title={title} description={description}>
  <article class="md-body">
    <Content />
  </article>
  {headings && headings.length > 0 && (
    <aside class="toc" aria-label="Table of contents">
      <h3>On this page</h3>
      <ul>
        {headings
          .filter(h => h.depth <= 3)
          .map(h => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
      </ul>
    </aside>
  )}
</Default>
