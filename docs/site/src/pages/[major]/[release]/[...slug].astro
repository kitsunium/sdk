---
// Dynamic route for the entire versioned documentation tree.
// URLs are /<major>/<release>/<slug?> — every page is fed by a
// markdown file the prebuild script materialised from the real
// source repository (no hand-authored prose in this Astro tree).
import { getCollection, render } from "astro:content";
import Default from "../../../layouts/Default.astro";

export async function getStaticPaths() {
  const all = await getCollection("docs");
  return all.map(entry => {
    //: entry.id (Astro 5 glob loader) looks like "v1/local/index",
    //: "v1/local/codec", "v1/local/adr/0001-foo". First two segments
    //: are the major + release; everything else is the page slug.
    const segments = entry.id.split("/");
    const major = segments[0];
    const release = segments[1];
    const rest = segments.slice(2).join("/");
    const slug = rest === "" || rest === "index" ? undefined : rest;
    return {
      params: { major, release, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
//: Title precedence:
//:   1. explicit YAML frontmatter `title:` (lets sync-versions hand-stamp it)
//:   2. first H1 in the markdown body (e.g. gomarkdoc's "# codec", or
//:      pkg/v1/CLAUDE.md's "# pkg/v1/")
//:   3. last path segment as a deliberate-fallback (only fires if a
//:      page has neither — should not happen in practice)
//: The slug fallback used to win for landing pages because their
//: id is "v1/local" (Astro strips trailing /index), giving the
//: useless "local" h1 — fixed by reading the first H1 here.
const firstH1 = (headings ?? []).find(h => h.depth === 1);
const slugFallback = entry.id.split("/").slice(-1)[0] ?? "Docs";
const title = entry.data?.title ?? firstH1?.text ?? slugFallback;
const description = entry.data?.description;
//: Filter to H2/H3 — H4+ headings clutter the TOC without helping
//: navigation. The full hierarchy stays in the rendered article.
const tocHeadings = (headings ?? []).filter(h => h.depth >= 2 && h.depth <= 3);
---

<Default title={title} description={description} headings={tocHeadings}>
  <article class="md-body md-body--strip-first-h1">
    <Content />
  </article>
</Default>
