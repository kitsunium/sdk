---
import Default from "../../layouts/Default.astro";
import { readSourceMarkdown, renderMarkdown, stripTopHeading } from "../../utils/markdown.ts";

const md = readSourceMarkdown("pkg/v1/codec/README.md");
const body = renderMarkdown(stripTopHeading(md));
---

<Default
  title="pkg/v1/codec"
  subtitle="Universal codec dispatch — 18 Format names across 13 packages. One Marshal/Unmarshal surface, runtime format swap, streaming + appender extensions opt-in by interface assertion."
>
  <article class="md-body" set:html={body} />

  <p style="margin-top:2rem">
    <a href="/benchmarks/">→ See the benchmarks</a> for ns/op, B/op and allocs/op per
    (Format × payload size) — 324 measurements pivoted by codec, mean-baseline ranked.
  </p>
</Default>
