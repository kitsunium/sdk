---
import Default from "../layouts/Default.astro";
import {
  readSourceMarkdown,
  renderMarkdown,
  extractEnvelopeField,
} from "../utils/markdown.ts";

const md = readSourceMarkdown("pkg/v1/codec/BENCH.md");
const body = renderMarkdown(md);

const generated = extractEnvelopeField(md, "Generated \\(UTC\\)");
const branch = extractEnvelopeField(md, "Git branch");
const commit = extractEnvelopeField(md, "Git commit");
const cpu = extractEnvelopeField(md, "CPU");
const cores = extractEnvelopeField(md, "CPU cores");
const benchtime = extractEnvelopeField(md, "Bench wall-clock");
---

<Default
  title="Benchmarks"
  subtitle="324 codec benchmarks pivoted by Format, ranked by ns/op, with mean-baseline deltas. Numbers vary across machines — the reproducibility envelope below stamps the box that produced these."
>
  <article class="md-body">
    <dl class="provenance">
      <div><dt>Generated</dt><dd><code>{generated}</code></dd></div>
      <div><dt>Branch</dt><dd><code>{branch}</code></dd></div>
      <div><dt>Commit</dt><dd><code>{commit}</code></dd></div>
      <div><dt>CPU</dt><dd>{cpu}</dd></div>
      <div><dt>Cores</dt><dd>{cores}</dd></div>
      <div><dt>Wall-clock</dt><dd>{benchtime}</dd></div>
    </dl>

    <div set:html={body} />
  </article>
</Default>
