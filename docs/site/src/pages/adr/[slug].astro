---
import Default from "../../layouts/Default.astro";
import { renderMarkdown, stripTopHeading } from "../../utils/markdown.ts";

//: Astro static-site dynamic routes — emit one HTML file per ADR.
//: Top-level imports + helpers must live INSIDE getStaticPaths so Astro
//: can serialise the function for its route-cache module loader.
export async function getStaticPaths() {
  const fs = await import("node:fs");
  const path = await import("node:path");
  //: workspace root — Astro runs from docs/site/, so ../../ lands at
  //: the repo root. Matches the helper in src/utils/markdown.ts.
  const WORKSPACE = path.resolve(process.cwd(), "../..");
  const adrDir = path.join(WORKSPACE, "docs/adr");
  const files = fs
    .readdirSync(adrDir)
    .filter((f) => /^\d{4}-.+\.md$/.test(f));
  return files.map((file) => {
    const slug = file.replace(/\.md$/, "");
    const raw = fs.readFileSync(path.join(adrDir, file), "utf-8");
    const titleMatch = raw.match(/^#\s+(?:ADR\s+\d+[:.\s—-]+)?(.+)$/m);
    const title = titleMatch ? titleMatch[1].trim() : slug;
    return {
      params: { slug },
      props: { raw, title },
    };
  });
}

interface Props {
  raw: string;
  title: string;
}
const { raw, title } = Astro.props as Props;
const body = renderMarkdown(stripTopHeading(raw));
const numberMatch = title.match(/^(\d{4})/) ?? Astro.params.slug?.match(/^(\d{4})/);
const number = numberMatch ? numberMatch[1] : "";
---

<Default
  title={title}
  subtitle={`ADR ${number} · accepted record from /workspace/docs/adr/${Astro.params.slug}.md.`}
>
  <article class="md-body">
    <p>
      <a href="/adr/">← Back to the ADR index</a>
    </p>
    <div set:html={body} />
  </article>
</Default>
