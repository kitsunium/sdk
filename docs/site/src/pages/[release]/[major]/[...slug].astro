---
// Dynamic route for the entire versioned documentation tree.
// URLs are /<release>/<major>/<slug?> — release is the time-axis
// (e.g. local / v0.1.0), major is the API-surface axis (v1 / v2).
// Every page is fed by a markdown file the prebuild script
// materialised from the real source repository (no hand-authored
// prose in this Astro tree).
import { getCollection, getEntry, render } from "astro:content";
import Default from "../../../layouts/Default.astro";
import WhatsNew from "../../../components/WhatsNew.astro";
import ApiSection from "../../../components/ApiSection.astro";
import { blobBase, sourceRef } from "../../../../scripts/lib/api.mjs";
import { pagePath } from "../../../../scripts/lib/page-catalog.mjs";

export async function getStaticPaths() {
  const all = await getCollection("docs");
  return all.map(entry => {
    //: entry.id (Astro 5 glob loader) looks like "local/v1/index",
    //: "local/v1/codec", "local/v1/adr/0001-foo". First two segments
    //: are the release + major; everything else is the page slug, served
    //: at its directory: "local/v1/index" at /local/v1/ and the ADR index
    //: "local/v1/adr/index" at /local/v1/adr/, where its relative links to
    //: the ADRs (./0001-foo/) and the contributors page's ../adr/ resolve.
    const segments = pagePath(entry.id).split("/");
    const release = segments[0];
    const major = segments[1];
    const rest = segments.slice(2).join("/");
    const slug = rest === "" ? undefined : rest;
    return {
      params: { release, major, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
//: Title precedence:
//:   1. explicit YAML frontmatter `title:` (lets sync-versions hand-stamp it)
//:   2. first H1 in the markdown body (e.g. gomarkdoc's "# codec", or
//:      pkg/v1/CLAUDE.md's "# pkg/v1/")
//:   3. last path segment as a deliberate-fallback (only fires if a
//:      page has neither — should not happen in practice)
//: The slug fallback used to win for landing pages because their
//: id is "v1/local" (Astro strips trailing /index), giving the
//: useless "local" h1 — fixed by reading the first H1 here.
const firstH1 = (headings ?? []).find(h => h.depth === 1);
const slugFallback = entry.id.split("/").slice(-1)[0] ?? "Docs";
const title = entry.data?.title ?? firstH1?.text ?? slugFallback;
const description = entry.data?.description;
//: `source` is repo-relative path to the original file the docs page
//: was materialised from. sync-versions writes it into frontmatter
//: (e.g. pkg/v1/data/codec/README.md). Default.astro feeds it to the
//: EditLink component so readers can deep-link to GitHub.
const source = (entry.data as { source?: string | null } | undefined)?.source ?? null;
//: A package page of a release with docs/api has an API section (its
//: frontmatter says `api: true`), from the model sync-versions wrote at the
//: page's own id, and — when the package has a BENCH.md — its benchmarks
//: apart, so they render after the API. A page that promises an API and
//: has none fails the build rather than ship without its reference.
const promisesApi = (entry.data as { api?: boolean } | undefined)?.api === true;
const api = promisesApi ? ((await getEntry("api", entry.id))?.data ?? null) : null;
if (promisesApi && !api) {
  throw new Error(`${entry.id}: the page has api: true and no entry in the api collection`);
}
//: getCollection, not getEntry: most packages have no benchmarks, and
//: getEntry warns on every id it does not find.
const benchEntry = api ? (await getCollection("bench", e => e.id === entry.id))[0] : undefined;
const bench = benchEntry ? await render(benchEntry) : null;
const BenchContent = bench?.Content ?? null;

//: Source links of the API point at the release's own tree: its tag, or for
//: the working tree the branch (else the commit) build-info names.
interface BuildInfo {
  repoUrl?: string | null;
  branch?: string | null;
  commitFull?: string | null;
}
interface Release {
  version: string;
  tag?: string | null;
}
let sourceBase: string | null = null;
if (api) {
  let build: BuildInfo = {};
  let versions: { releases: Release[] }[] = [];
  try {
    build = ((await import("../../../data/build-info.json")).default as BuildInfo) ?? {};
    versions = (await import("../../../data/versions.json")).default ?? [];
  } catch { /* prebuild not run */ }
  const tag = versions.flatMap(v => v.releases).find(r => r.version === entry.id.split("/")[0])?.tag ?? null;
  sourceBase = blobBase(build.repoUrl, sourceRef(build, tag));
}

//: TOC shows H2 only by default. For dense gomarkdoc pages (logger
//: with 18 H2 + 12 H3) showing every H3 would flood the rail. H3+
//: are reachable via in-page scroll / fragment links from the body.
//: The API section and the benchmarks after it are rendered apart from the
//: body, so their H2s join in the order the page shows them.
const tocHeadings = [
  ...(headings ?? []),
  ...(api ? [{ depth: 2, slug: "api", text: "API" }] : []),
  ...(bench?.headings ?? []),
].filter(h => h.depth === 2);

//: Home page detection — the landing page's id is "<release>/<major>/index"
//: (content.config.ts keeps the file path), served at "<release>/<major>".
//: On that page we inject the <WhatsNew /> banner ABOVE the article
//: (returning users see recent changes immediately; drive-by visitors get
//: the README pitch right under the banner).
const segments = pagePath(entry.id).split("/");
const isHome = segments.length === 2;
const release = segments[0];
const major = segments[1];
//: WhatsNew prefixes the deploy base itself: an absolute path without it.
const changelogHref = `/${release}/${major}/changelog/`;
---

<Default title={title} description={description} headings={tocHeadings} source={source}>
  {isHome && <WhatsNew release={release} major={major} changelogHref={changelogHref} />}
  <article class="md-body md-body--strip-first-h1">
    <Content />
    {api && <ApiSection model={api as any} sourceBase={sourceBase} />}
    {BenchContent && <BenchContent />}
  </article>
</Default>
