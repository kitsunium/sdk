---
// Default layout — sidebar + page chrome. Every page wraps its content
// in this layout so the navigation + footer stay consistent. The
// project name shown in <title> and the footer is derived from
// build-info.json (which itself extracts it from the git repoUrl
// at prebuild time) — no hardcoded "kitsunium/sdk" string survives.
import Sidebar from "../components/Sidebar.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description?: string;
  subtitle?: string;
  headings?: Heading[];
}
const { title, description, subtitle, headings = [] } = Astro.props;
const url = new URL(Astro.request.url);
const currentPath = url.pathname;

interface BuildInfo {
  repoUrl?: string | null;
}
let build: BuildInfo = {};
try {
  build = ((await import("../data/build-info.json")).default as BuildInfo) ?? {};
} catch { /* prebuild not run yet */ }

//: derive "<org>/<repo>" from build-info.repoUrl (e.g.
//: https://github.com/kitsunium/sdk → "kitsunium/sdk"). Falls back
//: to a neutral "documentation" string if build-info is absent
//: (fresh clone, dev probe).
function projectName(repoUrl: string | null | undefined): string {
  if (!repoUrl) return "documentation";
  const m = repoUrl.match(/[/:]([^/]+\/[^/]+?)(?:\.git)?\/?$/);
  return m?.[1] ?? "documentation";
}
const project = projectName(build.repoUrl);
const pageTitle = title === project ? `${project} — documentation` : `${title} — ${project}`;
const descFallback = `Documentation portal for ${project}.`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? descFallback} />
    <link rel="icon" type="image/jpeg" href="/brand/kitsunium.jpg" />
    <link rel="apple-touch-icon" href="/brand/kitsunium.jpg" />
  </head>
  <body>
    <div class="app">
      <Sidebar currentPath={currentPath} />
      <div class="content">
        <Header currentPath={currentPath} />
        <header class="page-header">
          <div class="container">
            <h1>{title}</h1>
            {subtitle && <p class="subtitle">{subtitle}</p>}
          </div>
        </header>
        <div class="page-body">
          <main class="container">
            <slot />
          </main>
          {headings.length > 0 && (
            <div class="toc-rail">
              <aside class="page-toc" aria-label="On this page">
                <h3>On this page</h3>
                <ul>
                  {headings.map(h => (
                    <li class={`toc-d${h.depth}`}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </aside>
            </div>
          )}
        </div>
        <footer>
          <div class="container">
            <p>
              {project} · documentation portal · regenerate with <code>make docs</code>
              · serve with <code>make serve</code>
            </p>
          </div>
        </footer>
      </div>
    </div>
    <script>
      // Shared combobox controller. Activates every [data-combobox]
      // root once; idempotent — running the script a second time
      // (e.g. when two components both emit it) bails out via the
      // dataset.comboInit flag.
      function initCombobox(root: HTMLElement) {
        if (root.dataset.comboInit === "1") return;
        root.dataset.comboInit = "1";
        const btn = root.querySelector<HTMLButtonElement>("button[aria-haspopup='listbox']");
        const list = root.querySelector<HTMLElement>("[role='listbox']");
        if (!btn || !list) return;
        const options = Array.from(
          list.querySelectorAll<HTMLLIElement>("[role='option']"),
        );
        let focusIdx = options.findIndex(
          o => o.getAttribute("aria-selected") === "true",
        );
        if (focusIdx < 0) focusIdx = 0;

        const open = () => {
          list.hidden = false;
          btn.setAttribute("aria-expanded", "true");
          options[focusIdx]?.querySelector("a")?.focus();
        };
        const close = () => {
          list.hidden = true;
          btn.setAttribute("aria-expanded", "false");
        };
        btn.addEventListener("click", e => {
          e.stopPropagation();
          list.hidden ? open() : close();
        });
        btn.addEventListener("keydown", e => {
          if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            open();
          }
        });
        list.addEventListener("keydown", e => {
          if (e.key === "Escape") {
            e.preventDefault();
            close();
            btn.focus();
            return;
          }
          if (e.key === "ArrowDown") {
            e.preventDefault();
            focusIdx = Math.min(focusIdx + 1, options.length - 1);
            options[focusIdx]?.querySelector("a")?.focus();
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            focusIdx = Math.max(focusIdx - 1, 0);
            options[focusIdx]?.querySelector("a")?.focus();
          } else if (e.key === "Home") {
            e.preventDefault();
            focusIdx = 0;
            options[focusIdx]?.querySelector("a")?.focus();
          } else if (e.key === "End") {
            e.preventDefault();
            focusIdx = options.length - 1;
            options[focusIdx]?.querySelector("a")?.focus();
          }
        });
        document.addEventListener("click", e => {
          if (list.hidden) return;
          if (!root.contains(e.target as Node)) close();
        });
      }
      document
        .querySelectorAll<HTMLElement>("[data-combobox]")
        .forEach(initCombobox);
    </script>
  </body>
</html>
