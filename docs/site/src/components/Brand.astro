---
// Brand block — logo + literal "SDK" + two dropdowns (API axis,
// Release axis). The earlier version wrapped the <select> in the
// <a href="/"> brand link; that made every click on the dropdown
// bubble up to the anchor and navigate to "/", giving the user the
// "ça rafraîchit la page" symptom. The fix is structural: the anchor
// only covers the logo + text, the dropdowns are siblings.
import ApiDropdown from "./ApiDropdown.astro";
import { findDefaults, LOCAL_RELEASE } from "../../scripts/lib/tag-format.mjs";

interface Props {
  currentPath: string;
}

let versions: Array<{
  major: string;
  default: boolean;
  eol: boolean;
  releases: Array<{ version: string; tag: string | null; label: string; default: boolean; publishedAt: string | null }>;
}> = [];
try {
  versions = (await import("../data/versions.json")).default ?? [];
} catch {
  versions = [];
}

const { currentPath } = Astro.props;

//: extract the current major + release from the URL. URLs follow
//: /<major>/<release>/...; anything that doesn't match falls back to
//: the site defaults computed from versions.json.
const m = currentPath.match(/^\/(v\d+)(?:\/([^/]+))?(?:\/|$)/);
const fallback = findDefaults(versions);
const currentMajor = m?.[1] ?? fallback.major;
const currentRelease = m?.[2] ?? fallback.release;
const homeHref = `/${fallback.major}/${fallback.release}/`;
---

<div class="brand-block">
  <a href={homeHref} class="brand" aria-label="kitsunium SDK — home">
    <img
      src="/brand/kitsunium.jpg"
      alt="Kitsunium"
      width="28"
      height="28"
      class="brand-mark-img"
    />
    <span class="brand-text">SDK</span>
  </a>
  {versions.length > 1 && (
    <div class="version-row" role="group" aria-label="API major selector">
      <ApiDropdown currentMajor={currentMajor} versions={versions} />
    </div>
  )}
</div>

<style>
  .brand-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
  }
  .brand-mark-img {
    border-radius: 6px;
    display: block;
  }
  .brand-text {
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .version-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
</style>
