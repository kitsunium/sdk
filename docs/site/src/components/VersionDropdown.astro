---
// VersionDropdown — vanilla <select> hydrated by inline JS (plan B3).
// No client framework: the dropdown is a static HTML control whose
// onchange handler navigates the browser. The list of versions is read
// from src/data/versions.json at build time, regenerated by the
// `prebuild` npm script (sync-versions.mjs).
//
// Accessibility: aria-label on the <select> + visible association via
// .sr-only label (plan M15 — refine lens L8 / axe-core gate).

interface Props {
  current: string | null;
}

let versions: Array<{ major: string; latest: string; default: boolean; eol: boolean }> = [];
try {
  //: dynamic import — keeps the build green when versions.json hasn't
  //: been generated yet (e.g. fresh clone before `npm run prebuild`).
  versions = (await import("../data/versions.json")).default ?? [];
} catch {
  versions = [];
}

const { current } = Astro.props;
const fallback = versions.find(v => v.default)?.major ?? versions[0]?.major ?? "v1";
const activeMajor = current ?? fallback;
---

{versions.length > 0 && (
  <label class="version-wrap">
    <span class="sr-only">Select documentation version</span>
    <select
      aria-label="Select documentation version"
      class="version-select"
      onchange="if(this.value)window.location.href=this.value"
    >
      {versions.map(v => (
        <option value={`/${v.major}/`} selected={v.major === activeMajor}>
          {v.major}{v.eol ? " (EOL)" : ""} · latest {v.latest}
        </option>
      ))}
    </select>
  </label>
)}

<style>
  .version-wrap {
    display: inline-flex;
    align-items: center;
  }
  .version-select {
    margin-left: 0.5rem;
    padding: 0.15rem 0.4rem;
    font: inherit;
    background: transparent;
    color: inherit;
    border: 1px solid currentColor;
    border-radius: 4px;
    cursor: pointer;
    opacity: 0.85;
  }
  .version-select:hover,
  .version-select:focus-visible {
    opacity: 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
