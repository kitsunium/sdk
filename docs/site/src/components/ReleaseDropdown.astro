---
// ReleaseDropdown — picks a release within the current API major.
// Lists "local" first (when the major has unreleased HEAD content),
// then every published tag in descending semver order. Switching
// navigates to that release's root page; the slug after the
// (major, release) pair is not preserved across releases (a future
// release may not have the same slug).
interface Release {
  version: string;
  label: string;
  default: boolean;
  publishedAt: string | null;
}
interface Version {
  major: string;
  releases: Release[];
}

interface Props {
  currentMajor: string;
  currentRelease: string;
  versions: Version[];
}

const { currentMajor, currentRelease, versions } = Astro.props;

const current = versions.find(v => v.major === currentMajor);
const releases = current?.releases ?? [];
---

{releases.length > 0 && (
  <label class="release-inline">
    <span class="sr-only">Select release</span>
    <select
      aria-label="Select release"
      class="release-select"
      onchange="if(this.value)window.location.assign(this.value)"
    >
      {releases.map(r => (
        <option value={`/${currentMajor}/${r.version}/`} selected={r.version === currentRelease}>
          {r.label}
        </option>
      ))}
    </select>
  </label>
)}

<style>
  /* Top-right release picker — larger than the commit-SHA metadata
     so the active release reads as the primary "build coordinate"
     of the page. Anchored to the far right via margin-left: auto
     (works even when the header band wraps to two lines). */
  .release-inline {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
  }
  .release-select {
    padding: 0.25rem 0.65rem;
    font-size: 0.95rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.04);
    color: inherit;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 5px;
    cursor: pointer;
    opacity: 0.95;
    letter-spacing: 0.02em;
  }
  .release-select:hover,
  .release-select:focus-visible {
    opacity: 1;
    border-color: currentColor;
    background: rgba(255, 255, 255, 0.08);
  }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0);
    white-space: nowrap; border: 0;
  }
</style>
