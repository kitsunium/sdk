---
// ReleaseDropdown — the page's primary "build coordinate" pill.
// Renders the build commit SHA + active release version inside a
// green pill; clicking opens the <select> that switches release.
// Pill style intentionally vibrant (--color-accent green) so it
// reads as the live, switchable coordinate, not passive metadata.
interface Release {
  version: string;
  label: string;
  default: boolean;
  publishedAt: string | null;
}
interface Version {
  major: string;
  releases: Release[];
}

interface Props {
  currentMajor: string;
  currentRelease: string;
  versions: Version[];
  buildSha?: string | null;
  buildDirty?: boolean;
}

const { currentMajor, currentRelease, versions, buildSha, buildDirty } =
  Astro.props;

const current = versions.find(v => v.major === currentMajor);
const releases = current?.releases ?? [];
const shaText = buildSha ? buildSha + (buildDirty ? "+" : "") : null;
---

{releases.length > 0 && (
  <label class="release-pill" aria-label="Release picker">
    <span class="dot" aria-hidden="true" />
    {shaText && (
      <span class="pill-sha">
        {shaText}
        <span class="pill-sep" aria-hidden="true">·</span>
      </span>
    )}
    <span class="pill-version">{releases.find(r => r.version === currentRelease)?.label ?? currentRelease}</span>
    <span class="pill-caret" aria-hidden="true">▾</span>
    <select
      aria-label="Select release"
      class="release-select"
      onchange="if(this.value)window.location.assign(this.value)"
    >
      {releases.map(r => (
        <option value={`/${currentMajor}/${r.version}/`} selected={r.version === currentRelease}>
          {shaText ? `${shaText} · ${r.label}` : r.label}
        </option>
      ))}
    </select>
  </label>
)}

<style>
  /* Pill = the visible chrome; the real <select> is overlaid
     transparent on top of it so the click hit-area matches the
     pill exactly. Green accent + readable monospace so the
     active coordinate pops against the page-meta band. */
  .release-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    padding: 0.3rem 0.7rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.86rem;
    font-weight: 600;
    color: #c5f6c5;
    background: rgba(46, 160, 67, 0.18);
    border: 1px solid rgba(46, 160, 67, 0.5);
    border-radius: 999px;
    cursor: pointer;
    transition: background 80ms ease, border-color 80ms ease, transform 80ms ease;
  }
  .release-pill:hover,
  .release-pill:focus-within {
    background: rgba(46, 160, 67, 0.28);
    border-color: rgba(46, 160, 67, 0.85);
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #2ea043;
    box-shadow: 0 0 6px rgba(46, 160, 67, 0.7);
    flex-shrink: 0;
  }
  .pill-sha {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    opacity: 0.85;
  }
  .pill-sep { opacity: 0.5; }
  .pill-version {
    letter-spacing: 0.02em;
    color: #e2ffe2;
  }
  .pill-caret {
    opacity: 0.65;
    font-size: 0.75em;
    margin-left: 0.1rem;
  }
  /* Real <select> stretched to cover the pill, fully transparent
     so the user sees only our styling but native dropdown behavior
     is preserved (keyboard nav, OS native dropdown UI). */
  .release-select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: transparent;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    opacity: 0;
  }
  .release-select:focus-visible {
    /* Surface focus on the parent pill via :focus-within; keep the
       select itself outline-free. */
    outline: none;
  }
  /* Native option list takes the OS default but we tint values
     where supported (Firefox / Chromium honour `color`). */
  .release-select option {
    color: #0d1117;
    background: #fff;
  }
</style>
