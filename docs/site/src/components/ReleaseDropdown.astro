---
// ReleaseDropdown — custom combobox (no browser <select>). The button
// renders the PAGE'S OWN release coordinate (the version it was built
// for); clicking (or Enter / Space / ArrowDown) reveals a styled
// listbox of every release for the current major. Closes on
// click-outside or Escape.
//
// The build SHA is build provenance, not a release coordinate: it is
// the commit the WHOLE site was generated from (always HEAD). Stamping
// it next to a historical tag (e.g. "7b00a34 · v0.1.1") wrongly implies
// that commit produced that release. So the SHA is only shown for the
// "local" coordinate — the one snapshot that genuinely IS HEAD. Every
// tagged release shows just its own label, derived from the page
// coordinate, never a single global "latest" constant.
//
// Accessibility: roles + aria-expanded + aria-activedescendant follow
// the WAI-ARIA combobox / listbox pattern. Keyboard: Up / Down move
// focus, Enter activates, Escape closes.
import { withBase } from "../../scripts/lib/base.mjs";
import { LOCAL_RELEASE } from "../../scripts/lib/tag-format.mjs";

interface Release {
  version: string;
  label: string;
  default: boolean;
  publishedAt: string | null;
}
interface Version {
  major: string;
  releases: Release[];
}

interface Props {
  currentMajor: string;
  currentRelease: string;
  versions: Version[];
  buildSha?: string | null;
  buildDirty?: boolean;
}

const { currentMajor, currentRelease, versions, buildSha, buildDirty } =
  Astro.props;

const current = versions.find(v => v.major === currentMajor);
const releases = current?.releases ?? [];
const shaText = buildSha ? buildSha + (buildDirty ? "+" : "") : null;
const activeLabel =
  releases.find(r => r.version === currentRelease)?.label ?? currentRelease;
//: SHA is only meaningful for "local" (it IS HEAD). Show it on the
//: active pill only when the page being viewed is the local snapshot;
//: tagged releases render their version label alone.
const pillSha = currentRelease === LOCAL_RELEASE ? shaText : null;
---

{releases.length > 0 && (
  <div class="release-combo" data-combobox>
    <button
      type="button"
      class="release-pill"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label={`Release: ${activeLabel}. Click to switch.`}
    >
      {pillSha && (
        <span class="pill-sha">
          {pillSha}
          <span class="pill-sep" aria-hidden="true">·</span>
        </span>
      )}
      <span class="pill-version">{activeLabel}</span>
      <span class="pill-caret" aria-hidden="true">▾</span>
    </button>
    <ul class="release-listbox" role="listbox" tabindex="-1" hidden>
      {releases.map((r, idx) => (
        <li
          role="option"
          id={`release-opt-${idx}`}
          aria-selected={r.version === currentRelease}
          class:list={[r.version === currentRelease && "active"]}
        >
          <a href={withBase(`/${r.version}/${currentMajor}/`)}>
            {shaText && r.version === LOCAL_RELEASE && (
              <>
                <span class="opt-sha">{shaText}</span>
                <span class="opt-sep" aria-hidden="true">·</span>
              </>
            )}
            <span class="opt-version">{r.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .release-combo {
    position: relative;
    margin-left: auto;
    display: inline-block;
  }

  /* Pill = the visible button. Clean green accent — no decorative
     extras. Active state on focus / hover so the user sees the
     pill is interactive. */
  .release-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.86rem;
    font-weight: 600;
    color: #c5f6c5;
    background: rgba(46, 160, 67, 0.18);
    border: 1px solid rgba(46, 160, 67, 0.5);
    border-radius: 999px;
    cursor: pointer;
    transition:
      background 80ms ease,
      border-color 80ms ease;
  }
  .release-pill:hover,
  .release-pill:focus-visible {
    background: rgba(46, 160, 67, 0.28);
    border-color: rgba(46, 160, 67, 0.85);
    outline: none;
  }
  .pill-sha {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    opacity: 0.85;
  }
  .pill-sep {
    opacity: 0.5;
  }
  .pill-version {
    letter-spacing: 0.02em;
    color: #e2ffe2;
  }
  .pill-caret {
    opacity: 0.7;
    font-size: 0.75em;
    margin-left: 0.1rem;
    transform: translateY(-1px);
  }
  .release-pill[aria-expanded="true"] .pill-caret {
    transform: rotate(180deg) translateY(1px);
  }

  /* Listbox: floating panel below the pill. Subtle drop shadow,
     dark surface matching the page chrome, monospace items so the
     SHA + version columns align. */
  .release-listbox {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 100%;
    max-height: 360px;
    overflow-y: auto;
    margin: 0;
    padding: 0.25rem 0;
    list-style: none;
    background: #1a1f24;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    z-index: 50;
  }
  .release-listbox[hidden] {
    display: none;
  }
  .release-listbox li {
    margin: 0;
  }
  .release-listbox a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    color: rgba(255, 255, 255, 0.85);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .release-listbox a:hover,
  .release-listbox a:focus-visible {
    background: rgba(46, 160, 67, 0.18);
    color: #e2ffe2;
    outline: none;
  }
  .release-listbox li.active a {
    color: #b9f5b9;
  }
  .release-listbox li.active a::before {
    content: "✓";
    color: #2ea043;
    margin-right: 0.1rem;
  }
  .opt-sha {
    opacity: 0.65;
  }
  .opt-sep {
    opacity: 0.4;
  }
  .opt-version {
    letter-spacing: 0.02em;
  }
</style>
