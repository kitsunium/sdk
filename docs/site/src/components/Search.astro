---
// Search — ⌘K over two indexes behind one input: Pagefind's full text of the
// built site (every release's pages), and the symbol index of the page's own
// release, which gen-symbols.mjs wrote from that release's docs/api — every
// exported symbol of pkg/<major>/, and every method an alias reaches at its
// owner. Both are fetched on first use, under the deploy base.
//
// Trigger: click the input OR press ⌘K / Ctrl+K anywhere on the page.
// The popover opens, fetches <base>/_pagefind/pagefind-ui.{js,css} on demand,
// and renders results inline. Closes on Escape or click-outside.
//
// Empty-state suggestions: when the search input is empty, the modal
// shows a curated "Quick links" panel pointing at the current major's
// landing, services, ADR index, etc. As soon as the user types, the
// quick-links panel hides and Pagefind results take over.
//
// A release with no docs/api (cut before it existed) has no symbol index:
// its pages are found through Pagefind alone. On `npm run dev` Pagefind has
// not indexed yet, so the panel says the full-text index is missing — no
// console error, just a graceful degradation.
//
// A result is rendered as text: every field of a symbol lands in a text
// node, built element by element — no HTML is parsed from a string.
import { getCollection } from "astro:content";
import { findDefaults } from "../../scripts/lib/tag-format.mjs";
import { buildCatalog } from "../../scripts/lib/page-catalog.mjs";
import { DEPLOY_BASE } from "../../scripts/lib/base.mjs";

interface VersionEntry {
  major: string;
  default: boolean;
  releases: { version: string; default: boolean; api?: boolean }[];
}

let versions: VersionEntry[] = [];
try {
  versions = (await import("../data/versions.json")).default ?? [];
} catch { /* bootstrap */ }

//: URL layout is /<release>/<major>/<page> — see Sidebar.astro for
//: the rationale (release is time-axis, major is API surface).
const { major, release } = findDefaults(versions);
const base = `${DEPLOY_BASE}/${release}/${major}`;
const root = `${release}/${major}`;

let entries: Awaited<ReturnType<typeof getCollection>> = [];
try {
  entries = await getCollection("docs", e => e.id === root || e.id.startsWith(`${root}/`));
} catch { /* collection empty in bootstrap */ }

//: shared with Sidebar.astro — buildCatalog auto-discovers every
//: top-level page under <major>/<release>/, categorises reserved
//: slugs into Overview / Reference and routes everything else into
//: "services" (the gomarkdoc-generated pkg/<m>/<sub>/README.md set).
const quickLinks = buildCatalog(entries as any, root, base);

//: The "<release>/<major>" pairs gen-symbols wrote a symbol index for:
//: those sync-versions flagged `api` (their tree has docs/api). The client
//: loads the one of the page it is on, and never asks for one that is not.
const symbolIndexes = versions.flatMap(v =>
  v.releases.filter(r => r.api).map(r => `${r.version}/${v.major}`),
);
---

<div
  class="search"
  data-search
  data-symbol-indexes={JSON.stringify(symbolIndexes)}
  data-symbol-default={root}
>
  <button type="button" class="search-trigger" aria-label="Open search (⌘K / Ctrl+K)">
    <svg
      aria-hidden="true"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    <span class="search-label">Search</span>
    <kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
  </button>

  <div class="search-overlay" hidden role="dialog" aria-modal="true" aria-label="Search documentation">
    <div class="search-panel">
      <div id="pagefind-search"></div>
      <section class="symbol-results" data-symbol-results hidden aria-label="Symbol matches">
        <h4>Symbols <span class="result-count" data-symbol-count></span></h4>
        <ul data-symbol-list></ul>
      </section>
      <div class="search-suggestions" data-suggestions>
        <p class="suggestions-hint">Start typing to search · or jump to:</p>
        {quickLinks.map(group => (
          <section class="suggestion-group">
            <h4>{group.group}</h4>
            <ul>
              {group.items.map(item => (
                <li>
                  <a href={item.href}>
                    <span class="suggestion-label">{item.label}</span>
                    {item.hint && <span class="suggestion-hint">{item.hint}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="search-fallback" hidden>
        Search index unavailable. Run <code>npm run build</code> to generate
        <code>/_pagefind/</code> — the indexer runs after Astro build.
      </p>
    </div>
  </div>
</div>

<script>
  // Lazy-init the Pagefind UI on first open. Module + stylesheet are
  // injected via <script type="module"> / <link> so the search payload
  // (~50KB JS + the index chunks) only loads when the user actually
  // triggers the search — no cost on cold page loads.
  //
  // Every URL carries the deploy base (the site is a project page served
  // under /<repo>/), and the page position is read with the base stripped.
  //
  // The view-transition router swaps the page body on navigation, so the
  // search root is re-bound on every astro:page-load, and the global keys act
  // on the root of the page currently shown.
  const BASE = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "");
  const PAGEFIND_JS = `${BASE}/_pagefind/pagefind-ui.js`;
  const PAGEFIND_CSS = `${BASE}/_pagefind/pagefind-ui.css`;
  //: the shape of a symbol index gen-symbols.mjs writes; any other is
  //: refused, so a skew reads as "no symbols", loudly, not as no match.
  const INDEX_SCHEMA = 2;

  //: Symbol search runs in parallel with Pagefind, sharing the same
  //: input element. MiniSearch is bundled (6 KB) so the index is
  //: ready as soon as symbols-<release>-<major>.json downloads.
  type SymbolEntry = {
    kind: "func" | "type" | "alias" | "method" | "const" | "var";
    name: string;
    qualified: string;
    package: string;
    packageShort: string;
    signature: string;
    doc?: string;
    url: string;
    id: string;
    via?: string;
    receiver?: string;
    deprecated?: boolean;
    sourceUrl?: string;
  };
  type SymbolIndex = { search: any; entries: Map<string, SymbolEntry> };
  //: one load per index URL for the whole session: a navigation to another
  //: release loads that release's index, and coming back reuses the first.
  const symbolIndexes = new Map<string, Promise<SymbolIndex | null>>();
  let pagefindLoad: Promise<boolean> | null = null;

  //: The page's "<release>/<major>", from the path with the base stripped —
  //: /<base>/<release>/<major>/… — or null on a page outside the tree.
  function pagePosition(): string | null {
    let path = window.location.pathname;
    if (BASE && path.startsWith(BASE)) path = path.slice(BASE.length);
    const m = path.match(/^\/([^/]+)\/(v\d+)(?:\/|$)/);
    return m ? `${m[1]}/${m[2]}` : null;
  }

  //: The URL of the symbol index of the page's release, or null when that
  //: release has none (no docs/api in its tree).
  function symbolIndexURL(root: HTMLElement): string | null {
    let available: string[] = [];
    try {
      available = JSON.parse(root.dataset.symbolIndexes ?? "[]");
    } catch { /* no list: no index */ }
    const here = pagePosition() ?? root.dataset.symbolDefault ?? "";
    if (!available.includes(here)) return null;
    const [release, major] = here.split("/");
    return `${BASE}/_search/symbols-${release}-${major}.json`;
  }

  function loadSymbolIndex(url: string): Promise<SymbolIndex | null> {
    let pending = symbolIndexes.get(url);
    if (pending) return pending;
    pending = (async () => {
      try {
        const [{ default: MiniSearch }, payload] = await Promise.all([
          import("minisearch"),
          fetch(url).then(r => {
            if (!r.ok) throw new Error(`symbols ${r.status}`);
            return r.json() as Promise<{ schema: number; symbols: SymbolEntry[] }>;
          }),
        ]);
        if (payload.schema !== INDEX_SCHEMA) {
          throw new Error(`symbol index schema ${payload.schema}, want ${INDEX_SCHEMA}`);
        }
        const ms = new MiniSearch({
          //: the url is unique per entry: one anchor per record the page
          //: renders, an alias's members under the alias's name.
          idField: "url",
          fields: ["name", "qualified", "doc", "signature", "packageShort"],
          storeFields: ["url"],
          searchOptions: {
            //: heavy boost on name + qualified — what users type most.
            boost: { name: 6, qualified: 4, packageShort: 2, signature: 1, doc: 1 },
            fuzzy: 0.2,
            prefix: true,
            combineWith: "AND",
          },
        });
        const symbols = payload.symbols ?? [];
        ms.addAll(symbols);
        return { search: ms, entries: new Map(symbols.map(s => [s.url, s])) };
      } catch (err) {
        console.warn("[search] symbol index unavailable:", err);
        symbolIndexes.delete(url);
        return null;
      }
    })();
    symbolIndexes.set(url, pending);
    return pending;
  }

  const KIND_LABELS: Record<string, string> = {
    func: "func", type: "type", alias: "alias", method: "fn", const: "const", var: "var",
  };

  //: an element holding text, never parsed markup.
  function textEl<K extends keyof HTMLElementTagNameMap>(
    tag: K, className: string, text: string,
  ): HTMLElementTagNameMap[K] {
    const el = document.createElement(tag);
    el.className = className;
    el.textContent = text;
    return el;
  }

  function symbolRow(e: SymbolEntry): HTMLLIElement {
    const li = document.createElement("li");
    const a = document.createElement("a");
    a.href = `${BASE}${e.url}`;
    a.dataset.symbolLink = "";
    const kind = textEl("span", `sym-kind sym-kind--${e.kind}`, KIND_LABELS[e.kind] ?? e.kind);
    const name = textEl("span", "sym-name", e.qualified);
    if (e.deprecated) name.append(textEl("span", "sym-chip sym-chip--deprecated", "Deprecated"));
    a.append(kind, name, textEl("span", "sym-sig", e.signature));
    if (e.doc) a.append(textEl("span", "sym-doc", e.doc));
    li.append(a);
    //: the source link is the row's sibling, so a click on the row is not
    //: hijacked, and no anchor nests in another.
    if (e.sourceUrl) {
      const src = textEl("a", "sym-source", "Source ↗");
      src.href = e.sourceUrl;
      src.target = "_blank";
      src.rel = "noopener";
      li.append(src);
    }
    return li;
  }

  function renderSymbols(panel: HTMLElement, query: string, index: SymbolIndex | null) {
    const wrap = panel.querySelector<HTMLElement>("[data-symbol-results]");
    const list = panel.querySelector<HTMLElement>("[data-symbol-list]");
    const count = panel.querySelector<HTMLElement>("[data-symbol-count]");
    if (!wrap || !list || !count) return;
    const q = query.trim();
    const hits = q && index ? index.search.search(q, { fuzzy: 0.2, prefix: true }).slice(0, 8) : [];
    const rows = hits
      .map((h: { id: string }) => index!.entries.get(h.id))
      .filter((e: SymbolEntry | undefined): e is SymbolEntry => e !== undefined)
      .map(symbolRow);
    list.replaceChildren(...rows);
    count.textContent = rows.length > 0 ? `(${rows.length})` : "";
    wrap.hidden = rows.length === 0;
  }

  function loadPagefind(): Promise<boolean> {
    pagefindLoad ??= (async () => {
      try {
        // Probe the script URL first so a 404 (dev mode) is a clean reject.
        const head = await fetch(PAGEFIND_JS, { method: "HEAD" });
        if (!head.ok) throw new Error("pagefind-ui.js not found");
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = PAGEFIND_CSS;
        document.head.appendChild(link);
        await import(/* @vite-ignore */ PAGEFIND_JS);
        return true;
      } catch {
        return false;
      }
    })();
    return pagefindLoad;
  }

  //: Mounts Pagefind's UI into this page's panel, once per page: a swapped
  //: body brings an empty panel of its own.
  async function ensurePagefind(panel: HTMLElement): Promise<boolean> {
    if (panel.dataset.pagefindMounted === "1") return true;
    const host = panel.querySelector<HTMLElement>("#pagefind-search");
    if (!host || !(await loadPagefind())) {
      const fb = panel.querySelector<HTMLElement>(".search-fallback");
      if (fb) fb.hidden = false;
      return false;
    }
    // PagefindUI is exposed on window when the module evaluates.
    // @ts-ignore — module assigns globally per Pagefind convention.
    new window.PagefindUI({
      element: host,
      bundlePath: `${BASE}/_pagefind/`,
      showSubResults: true,
      showImages: false,
      resetStyles: false,
      excerptLength: 22,
    });
    panel.dataset.pagefindMounted = "1";
    return true;
  }

  //: The search root of the page currently shown.
  function currentRoot(): HTMLElement | null {
    return document.querySelector<HTMLElement>("[data-search]");
  }

  function initSearch(root: HTMLElement) {
    if (root.dataset.searchInit === "1") return;
    root.dataset.searchInit = "1";
    const trigger = root.querySelector<HTMLButtonElement>(".search-trigger");
    const overlay = root.querySelector<HTMLElement>(".search-overlay");
    if (!trigger || !overlay) return;
    trigger.addEventListener("click", () => openSearch(root));
    overlay.addEventListener("click", e => {
      if (e.target === overlay) {
        closeSearch(root);
        return;
      }
      //: a result followed in this tab closes the modal: an anchor of the
      //: page shown (a symbol of this package) is scrolled to under it
      //: otherwise. A link opening another tab leaves it open.
      const link = (e.target as Element | null)?.closest?.("a[href]");
      if (link && link.getAttribute("target") !== "_blank") closeSearch(root, false);
    });
  }

  //: hide quick-links the moment the user starts typing; bring them back
  //: when the input goes empty again (no extra fetch). ALSO route the same
  //: query into the symbol panel so both indexes update together from a
  //: single keystroke. Bound once per input.
  function watchInput(root: HTMLElement, panel: HTMLElement) {
    const input = panel.querySelector<HTMLInputElement>(".pagefind-ui__search-input");
    const suggestions = panel.querySelector<HTMLElement>("[data-suggestions]");
    if (!input || !suggestions || input.dataset.symbolsBound === "1") return;
    input.dataset.symbolsBound = "1";
    const url = symbolIndexURL(root);
    const sync = async () => {
      const q = input.value.trim();
      suggestions.hidden = q.length > 0;
      const index = q.length > 0 && url ? await loadSymbolIndex(url) : null;
      //: the input may have moved on while the index loaded.
      if (input.value.trim() === q) renderSymbols(panel, q, index);
    };
    input.addEventListener("input", sync);
    sync();
  }

  async function openSearch(root: HTMLElement) {
    const overlay = root.querySelector<HTMLElement>(".search-overlay");
    const panel = root.querySelector<HTMLElement>(".search-panel");
    if (!overlay || !panel) return;
    overlay.hidden = false;
    document.body.style.overflow = "hidden";
    await ensurePagefind(panel);
    // Focus the Pagefind UI input once the script has rendered it.
    requestAnimationFrame(() => {
      const input = panel.querySelector<HTMLInputElement>(".pagefind-ui__search-input");
      input?.focus();
      watchInput(root, panel);
    });
  }

  function closeSearch(root: HTMLElement, refocus = true) {
    const overlay = root.querySelector<HTMLElement>(".search-overlay");
    const suggestions = root.querySelector<HTMLElement>("[data-suggestions]");
    if (!overlay) return;
    overlay.hidden = true;
    document.body.style.overflow = "";
    if (suggestions) suggestions.hidden = false;
    if (refocus) root.querySelector<HTMLButtonElement>(".search-trigger")?.focus();
  }

  //: Focus-trap — keep Tab/Shift+Tab cycling INSIDE the modal until
  //: it closes. WAI-ARIA dialog pattern (developer.mozilla.org →
  //: Web/Accessibility/ARIA/Roles/dialog_role). Without this, Tab
  //: leaks focus to the underlying page and the user can't see
  //: where it went (overlay hides the scroll).
  const focusableSelector =
    'a[href], button:not([disabled]), input:not([disabled]), ' +
    'select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
  function trapTab(e: KeyboardEvent, overlay: HTMLElement, panel: HTMLElement) {
    if (e.key !== "Tab" || overlay.hidden) return;
    const focusables = Array.from(
      panel.querySelectorAll<HTMLElement>(focusableSelector),
    ).filter(el => !el.hasAttribute("hidden") && el.offsetParent !== null);
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement as HTMLElement | null;
    if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  }

  //: One listener for the whole session, acting on the page shown.
  document.addEventListener("keydown", e => {
    const root = currentRoot();
    const overlay = root?.querySelector<HTMLElement>(".search-overlay");
    const panel = root?.querySelector<HTMLElement>(".search-panel");
    if (!root || !overlay || !panel) return;
    const cmd = e.metaKey || e.ctrlKey;
    if (cmd && e.key.toLowerCase() === "k") {
      e.preventDefault();
      overlay.hidden ? openSearch(root) : closeSearch(root);
      return;
    }
    if (e.key === "Escape" && !overlay.hidden) {
      e.preventDefault();
      closeSearch(root);
      return;
    }
    trapTab(e, overlay, panel);
  });

  function bindAll() {
    document.querySelectorAll<HTMLElement>("[data-search]").forEach(initSearch);
  }
  bindAll();
  document.addEventListener("astro:page-load", bindAll);
</script>

<style>
  /* Trigger pill — sits flush in the sidebar between brand and the
     first nav section. Mimics the API/release pill aesthetic
     (monospace, outlined) so the chrome reads as a coherent set. */
  .search {
    width: 100%;
    margin-bottom: 0.75rem;
  }
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.35rem 0.6rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
    transition: background 80ms ease, border-color 80ms ease, color 80ms ease;
  }
  .search-trigger:hover,
  .search-trigger:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.35);
    color: #fff;
    outline: none;
  }
  .search-label {
    flex: 1;
    letter-spacing: 0.02em;
  }
  .search-kbd {
    padding: 0.05rem 0.35rem;
    font-family: inherit;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }

  /* Modal overlay — full-viewport dim with the search panel centred. */
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 4rem 1rem 1rem;
    z-index: 200;
    backdrop-filter: blur(2px);
  }
  .search-overlay[hidden] { display: none; }
  .search-panel {
    width: min(640px, 100%);
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
    background: #1a1f24;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 0.5rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .search-fallback {
    margin: 1rem;
    padding: 0.75rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(240, 180, 0, 0.08);
    border: 1px solid rgba(240, 180, 0, 0.3);
    border-radius: 6px;
  }
  .search-fallback code {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.05rem 0.35rem;
    border-radius: 3px;
  }

  /* Symbol results — the rustdoc-style top-of-modal panel that lists
     matching exported symbols from the page release's docs/api
     (gen-symbols.mjs → symbols-<release>-<major>.json). Hidden when
     the query is empty so the empty-state suggestions show instead.
     The rows are built by the client script, so they carry no scope
     attribute: every selector below the list reaches them through
     :global(), or the rows would render unstyled. */
  .symbol-results {
    padding: 0.25rem 0.5rem 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 0.25rem;
  }
  .symbol-results[hidden] { display: none; }
  .symbol-results h4 {
    margin: 0.55rem 0.5rem 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .symbol-results .result-count {
    margin-left: 0.4rem;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 500;
  }
  .symbol-results ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .symbol-results ul :global(li) { margin: 0; }
  .symbol-results ul :global(a[data-symbol-link]) {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 0.6rem;
    row-gap: 0.15rem;
    align-items: baseline;
    padding: 0.4rem 0.6rem;
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    border-radius: 5px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.83rem;
  }
  .symbol-results ul :global(a[data-symbol-link]:hover),
  .symbol-results ul :global(a[data-symbol-link]:focus-visible) {
    background: rgba(46, 160, 67, 0.12);
    outline: none;
  }
  .symbol-results ul :global(.sym-kind) {
    grid-row: span 1;
    grid-column: 1;
    padding: 0.05rem 0.4rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
    align-self: center;
  }
  .symbol-results ul :global(.sym-kind--func)   { background: rgba(46, 160, 67, 0.22);   color: #c5f6c5; }
  .symbol-results ul :global(.sym-kind--method) { background: rgba(46, 160, 67, 0.18);   color: #b9e5b9; }
  .symbol-results ul :global(.sym-kind--type),
  .symbol-results ul :global(.sym-kind--alias)  { background: rgba(88, 128, 220, 0.22);  color: #cfdcff; }
  .symbol-results ul :global(.sym-kind--const)  { background: rgba(220, 160, 60, 0.20);  color: #ffdfa8; }
  .symbol-results ul :global(.sym-kind--var)    { background: rgba(180, 120, 200, 0.20); color: #e8c8ff; }
  .symbol-results ul :global(.sym-name) {
    grid-column: 2;
    font-weight: 600;
    color: #e2ffe2;
  }
  .symbol-results ul :global(.sym-sig) {
    grid-column: 2;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .symbol-results ul :global(.sym-doc) {
    grid-column: 2;
    color: rgba(255, 255, 255, 0.5);
    font-family: inherit;
    font-size: 0.78rem;
    font-style: italic;
  }
  /* The source link sits beside the row, under its name column. */
  .symbol-results ul :global(.sym-source) {
    display: inline-block;
    margin: 0 0 0.35rem 0.6rem;
  }

  /* Empty-state suggestions — visible until the user types in the
