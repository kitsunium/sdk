---
// Sidebar nav — every link inside the "services" / "reference" groups
// is built from the current (major, release) coordinate read off the
// URL. Switching major or release via the dropdowns re-renders the
// sidebar against the new coordinate, so every link points at the
// right snapshot of the docs tree.
import Brand from "./Brand.astro";
import { findDefaults, LOCAL_RELEASE } from "../../scripts/lib/tag-format.mjs";

interface Release {
  version: string;
  label: string;
  default: boolean;
}
interface Version {
  major: string;
  default: boolean;
  releases: Release[];
}

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

let versions: Version[] = [];
try {
  versions = ((await import("../data/versions.json")).default as Version[]) ?? [];
} catch {
  versions = [];
}

const m = currentPath.match(/^\/(v\d+)(?:\/([^/]+))?(?:\/|$)/);
const fallback = findDefaults(versions);
const currentMajor = m?.[1] ?? fallback.major;
const currentRelease = m?.[2] ?? fallback.release;

//: prefix every dynamic link with the active (major, release).
//: ALL items below are generated against this base — no hardcoded
//: pkg/v1 prefixes survive the build.
const base = `/${currentMajor}/${currentRelease}`;

//: discover service slugs from the page data. A "service" is any
//: pkg/<major>/<service>/README.md that the prebuild copied as
//: <m>/<r>/<service>.md. We probe a known service list (logger,
//: codec, errs) — the build will skip ones that didn't materialise.
const services = ["logger", "codec", "errs"];

interface NavItem { href: string; label: string }
interface NavSection { title: string; items: NavItem[] }

const sections: NavSection[] = [
  {
    title: "Overview",
    items: [
      { href: `${base}/`,                 label: "Home" },
      { href: `${base}/getting-started/`, label: "Getting started" },
      { href: `${base}/philosophy/`,      label: "Philosophy" },
    ],
  },
  {
    title: "services",
    items: services.map(name => ({ href: `${base}/${name}/`, label: name })),
  },
  {
    title: "Reference",
    items: [
      { href: `${base}/architecture/`, label: "Architecture" },
      { href: `${base}/adr/`,          label: "ADRs" },
      { href: `${base}/benchmarks/`,   label: "Benchmarks" },
      { href: `${base}/verification/`, label: "Verification" },
    ],
  },
];

function isActive(href: string): boolean {
  const a = href.replace(/\/$/, "");
  const b = currentPath.replace(/\/$/, "");
  return a === b;
}
---

<aside class="sidebar" aria-label="Site navigation">
  <div class="sidebar-inner">
    <Brand currentPath={currentPath} />

    {
      sections.map((section) => (
        <nav class="nav-section">
          <h3>{section.title}</h3>
          <ul>
            {section.items.map((item) => (
              <li>
                <a href={item.href} class={isActive(item.href) ? "active" : ""}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="sidebar-foot">
      <a href="https://github.com/kitsunium/sdk" target="_blank" rel="noopener">
        GitHub ↗
      </a>
      <a href="https://pkg.go.dev/github.com/kitsunium/sdk" target="_blank" rel="noopener">
        pkg.go.dev ↗
      </a>
    </div>
  </div>
</aside>
