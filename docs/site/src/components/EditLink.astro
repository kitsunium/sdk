---
// EditLink — "Edit on GitHub" affordance. Links straight to the
// source file recorded in the page frontmatter (sync-versions writes
// `source: <repo-relative-path>` on every materialised page). Renders
// nothing when the source is unknown or build-info has no repoUrl.
interface Props {
  source?: string | null;
}
const { source } = Astro.props;

interface BuildInfo {
  repoUrl?: string | null;
  branch?: string | null;
  commitFull?: string | null;
}
let build: BuildInfo = {};
try {
  build = ((await import("../data/build-info.json")).default as BuildInfo) ?? {};
} catch { /* prebuild not run */ }

//: Prefer linking to the branch tip (lets readers see follow-up
//: commits) but fall back to the exact commit SHA when no branch
//: is known. github.com URL shape — extend the regex to match
//: other forges (GitLab) if/when we adopt them.
let editHref: string | null = null;
if (source && build.repoUrl) {
  const ref = build.branch && build.branch !== "HEAD" ? build.branch : (build.commitFull ?? "main");
  editHref = `${build.repoUrl.replace(/\/$/, "")}/edit/${ref}/${source}`;
}
---

{editHref && (
  <a class="edit-link" href={editHref} rel="noopener" target="_blank">
    <svg
      aria-hidden="true"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 20h9"></path>
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
    </svg>
    Edit this page on GitHub
  </a>
)}
