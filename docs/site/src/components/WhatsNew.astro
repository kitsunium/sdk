---
// WhatsNew — banner injected at the TOP of the Home page (only).
// Lists the most recently ADDED public capabilities (the curated feature
// catalog) and links to the full catalog page. Hybrid pattern that serves
// returning users (recent capabilities visible immediately) without hurting
// drive-by visitors (the banner is COMPACT — a few lines + a CTA).
//
// Data source: scripts/sync-versions.mjs (and scripts/gen-features.mjs) write
// src/data/features-<release>-<major>.json at prebuild time from the curated
// registry src/data/features.mjs. Each feature's "added" date is derived from
// its anchor's first commit. Best-effort dynamic import; a missing file (fresh
// clone, no history) renders nothing.

interface Feature {
  id: string;
  domain: string;
  title: string;
  blurb: string;
  added: string;
  sha: string;
  short: string;
  breaking: boolean;
  links: { adr?: string; pr?: number } | null;
}
interface Payload {
  release: string;
  major: string;
  generatedAt: string;
  repoUrl: string | null;
  domains: { domain: string; label: string; features: Feature[] }[];
  recent: Feature[];
}

interface Props {
  release: string;
  major: string;
  changelogHref: string;
}
const { release, major, changelogHref } = Astro.props;

let payload: Payload | null = null;
try {
  //: Astro/Vite resolves these dynamic imports at build time when the
  //: pattern matches a known file. Missing file → caught + fall-through.
  payload = ((await import(`../data/features-${release}-${major}.json`)).default as Payload) ?? null;
} catch {
  payload = null;
}

const recent = payload?.recent ?? [];
const fmtDay = (iso: string) => (iso ?? "").slice(0, 10);
---

{recent.length > 0 && (
  <section class="whats-new" aria-labelledby="whats-new-heading">
    <header>
      <h2 id="whats-new-heading">What's new<span class="release-tag">in <code>{release}</code></span></h2>
      <a href={changelogHref} class="whats-new-cta">Full catalog →</a>
    </header>
    <ul>
      {recent.map(f => {
        const commitUrl = payload?.repoUrl ? `${payload.repoUrl}/commit/${f.sha}` : null;
        return (
          <li>
            <span class="wn-kind">{f.domain}</span>
            <span class="wn-summary">{f.title}</span>
            {f.breaking && <span class="wn-breaking" title="Breaking change">⚠ breaking</span>}
            <span class="wn-date">{fmtDay(f.added)}</span>
            {commitUrl && (
              <a class="wn-sha" href={commitUrl} target="_blank" rel="noopener">{f.short}</a>
            )}
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .whats-new {
    margin: 0 0 2rem;
    padding: 1rem 1.1rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 6px;
  }
  .whats-new header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }
  .whats-new h2 {
    margin: 0;
    padding: 0;
    border-bottom: none;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0;
  }
  .whats-new h2 .release-tag {
    margin-left: 0.5rem;
    color: var(--color-muted);
    font-weight: 500;
    font-size: 0.85rem;
  }
  .whats-new h2 .release-tag code {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--color-accent);
  }
  .whats-new-cta {
    font-size: 0.82rem;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .whats-new ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .whats-new li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.25rem 0;
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .wn-kind {
    flex: 0 0 auto;
    padding: 0.05rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 3px;
    background: rgba(88, 128, 220, 0.16);
    color: #cfdcff;
    align-self: center;
  }
  .wn-summary {
    flex: 1;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .wn-breaking {
    color: var(--color-bad);
    font-size: 0.76rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .wn-date {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-muted);
  }
  .wn-sha {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-muted);
  }
  .wn-sha:hover { color: var(--color-accent); }
  /* Light theme — domain badge needs stronger contrast */
  :root[data-theme="light"] .wn-kind { background: rgba(88, 128, 220, 0.12); color: #3a4a8a; }
</style>
