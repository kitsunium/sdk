---
// ApiDropdown — selects the API major (v1, v2, …). Same custom-
// combobox pattern as ReleaseDropdown; the controlling JS is
// factored out into Default.astro (it activates every element
// with [data-combobox]).
//
// Hides itself when only one major exists — switching makes no
// sense with a single entry.
import { withBase } from "../../scripts/lib/base.mjs";

interface Release {
  version: string;
  default: boolean;
}
interface Version {
  major: string;
  eol: boolean;
  releases: Release[];
}

interface Props {
  currentMajor: string;
  versions: Version[];
}

const { currentMajor, versions } = Astro.props;

function defaultReleaseOf(v: Version): string {
  return (v.releases.find(r => r.default) ?? v.releases[0])?.version ?? "local";
}

const active =
  versions.find(v => v.major === currentMajor) ?? versions[0];
const activeLabel = active ? active.major + (active.eol ? " (EOL)" : "") : "v?";
---

{versions.length > 1 && (
  <div class="api-combo" data-combobox>
    <button
      type="button"
      class="api-pill"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label={`API major: ${activeLabel}. Click to switch.`}
    >
      <span class="api-label">API</span>
      <span class="api-version">{activeLabel}</span>
      <span class="api-caret" aria-hidden="true">▾</span>
    </button>
    <ul class="api-listbox" role="listbox" tabindex="-1" hidden>
      {versions.map((v, idx) => (
        <li
          role="option"
          id={`api-opt-${idx}`}
          aria-selected={v.major === currentMajor}
          class:list={[v.major === currentMajor && "active"]}
        >
          <a href={withBase(`/${defaultReleaseOf(v)}/${v.major}/`)}>
            <span class="opt-version">{v.major}</span>
            {v.eol && <span class="opt-eol">(EOL)</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .api-combo {
    position: relative;
    display: inline-block;
  }

  /* Discreet outlined pill — sits on the left of the header band
     so the API axis reads as a meta-control next to the build date,
     not the page's primary "live" coordinate (that's the release
     pill on the right). */
  .api-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.84rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    cursor: pointer;
    transition: background 80ms ease, border-color 80ms ease, color 80ms ease;
  }
  .api-pill:hover,
  .api-pill:focus-visible {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.4);
    color: #fff;
    outline: none;
  }
  .api-label {
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .api-version { letter-spacing: 0.02em; }
  .api-caret {
    opacity: 0.7;
    font-size: 0.75em;
    margin-left: 0.1rem;
    transform: translateY(-1px);
    transition: transform 120ms ease;
  }
  .api-pill[aria-expanded="true"] .api-caret {
    transform: rotate(180deg) translateY(1px);
  }

  /* Listbox: shared visual language with ReleaseDropdown but
     anchored to the LEFT edge of its combobox (vs right for the
     release pill). */
  .api-listbox {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 100%;
    margin: 0;
    padding: 0.25rem 0;
    list-style: none;
    background: #1a1f24;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    z-index: 50;
  }
  .api-listbox[hidden] { display: none; }
  .api-listbox li { margin: 0; }
  .api-listbox a {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    color: rgba(255, 255, 255, 0.85);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .api-listbox a:hover,
  .api-listbox a:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    outline: none;
  }
  .api-listbox li.active a { color: #cfd8ff; }
  .api-listbox li.active a::before {
    content: "✓";
    color: rgba(255, 255, 255, 0.85);
    margin-right: 0.1rem;
  }
  .opt-eol { opacity: 0.55; font-size: 0.78rem; }
</style>
