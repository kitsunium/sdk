{
  "name": "kitsunium-sdk-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "kitsunium/sdk documentation portal — philosophy, package guides, ADRs, benchmarks. Built via `make docs` at the repo root.",
  "scripts": {
    "dev": "node scripts/sync-versions.mjs && node scripts/gen-symbols.mjs && astro dev",
    "prebuild": "node scripts/sync-versions.mjs && node scripts/gen-symbols.mjs",
    "build": "astro build && pagefind --site dist --output-subdir _pagefind",
    "preview": "astro preview",
    "test": "node --test \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^5.14.1",
    "astro-expressive-code": "^0.42.0",
    "marked": "^15.0.7",
    "mermaid": "^11.15.0",
    "rehype-slug": "^6.0.0",
    "remark-github-blockquote-alert": "^2.1.0"
  },
  "devDependencies": {
    "minisearch": "^7.2.0",
    "pagefind": "^1.4.0"
  }
}
