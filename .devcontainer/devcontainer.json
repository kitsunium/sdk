{
  "name": "${localWorkspaceFolderBasename} Dev Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/kodflow/devcontainer-features/nodejs:1": {},
    "ghcr.io/kodflow/devcontainer-features/kubernetes:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false,
      "installDockerBuildx": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/kodflow/devcontainer-features/go:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh"
          }
        },
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "files.exclude": {
          "**/.grepai": true,
          "**/.git": true,
          "bazel-*": true
        }
      },
      "extensions": [
        "vscode-icons-team.vscode-icons",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "bierner.markdown-mermaid",
        "ms-azuretools.vscode-docker",
        "hashicorp.terraform"
      ]
    }
  },
  "waitFor": "onCreateCommand",
  "initializeCommand": "[ -f \"${localWorkspaceFolder}/.devcontainer/hooks/lifecycle/initialize.sh\" ] && bash \"${localWorkspaceFolder}/.devcontainer/hooks/lifecycle/initialize.sh\" || true",
  "onCreateCommand": "/etc/devcontainer-hooks/lifecycle/onCreate.sh",
  "updateContentCommand": "/etc/devcontainer-hooks/lifecycle/updateContent.sh",
  "postCreateCommand": "/etc/devcontainer-hooks/lifecycle/postCreate.sh",
  "postStartCommand": "/etc/devcontainer-hooks/lifecycle/postStart.sh",
  "postAttachCommand": "/etc/devcontainer-hooks/lifecycle/postAttach.sh",
  "forwardPorts": [],
  "remoteUser": "vscode",
  "shutdownAction": "none"
}
