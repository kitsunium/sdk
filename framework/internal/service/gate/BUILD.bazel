load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "gate",
    srcs = ["gate.go"],
    importpath = "github.com/kitsunium/sdk/framework/internal/service/gate",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
    deps = [
        "//framework/internal/core/entitlement",
        "//framework/internal/core/gate",
    ],
)

alias(
    name = "go_default_library",
    actual = ":gate",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

go_test(
    name = "gate_test",
    srcs = ["gate_internal_test.go"],
    embed = [":gate"],
    deps = [
        "//framework/internal/core/entitlement",
        "//framework/internal/core/gate",
    ],
)
