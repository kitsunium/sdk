load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "storekit",
    srcs = [
        "database.go",
        "doc.go",
        "document.go",
        "file.go",
        "refusal.go",
        "sql.go",
        "storekit.go",
        "storekit_compliance.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/internal/kit/storekit",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
    deps = [
        "//framework/internal/kit/plug",
        "//framework/model",
        "//pkg/v1/clock",
        "//pkg/v1/data/docstore",
        "//pkg/v1/data/queue",
        "//pkg/v1/data/sql",
        "//pkg/v1/data/vfs",
        "//pkg/v1/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":storekit",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

go_test(
    name = "storekit_test",
    srcs = ["api_gen_test.go"],
    deps = [":storekit"],
)
