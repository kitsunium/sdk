load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "queuekit",
    srcs = [
        "broker.go",
        "clock.go",
        "doc.go",
        "outbox.go",
        "queuekit.go",
        "queuekit_compliance.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/internal/kit/queuekit",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
    deps = [
        "//framework/internal/kit/plug",
        "//framework/internal/kit/storekit",
        "//framework/model",
        "//pkg/v1/clock",
        "//pkg/v1/data/queue",
        "//pkg/v1/data/sql",
        "//pkg/v1/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":queuekit",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

go_test(
    name = "queuekit_test",
    srcs = ["api_gen_test.go"],
    deps = [
        ":queuekit",
        "//framework/internal/kit/plug",
        "//pkg/v1/data/queue",
    ],
)
