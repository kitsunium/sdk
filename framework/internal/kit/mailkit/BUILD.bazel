load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "mailkit",
    srcs = [
        "clock.go",
        "doc.go",
        "mailkit.go",
        "mailkit_compliance.go",
        "spool.go",
        "transport.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/internal/kit/mailkit",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
    deps = [
        "//framework/internal/kit/plug",
        "//framework/internal/kit/queuekit",
        "//framework/internal/kit/storekit",
        "//pkg/v1/app/mail",
        "//pkg/v1/app/mail/spool",
        "//pkg/v1/app/resilience",
        "//pkg/v1/clock",
        "//pkg/v1/data/sql",
        "//pkg/v1/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":mailkit",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

go_test(
    name = "mailkit_test",
    srcs = [
        "api_gen_test.go",
        "mailkit_internal_test.go",
    ],
    embed = [":mailkit"],
    deps = [
        "//framework/internal/kit/plug",
        "//pkg/v1/app/mail",
        "//pkg/v1/app/mail/spool",
        "//pkg/v1/errs",
    ],
)
