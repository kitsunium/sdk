load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "queueengine",
    srcs = [
        "broker.go",
        "clock.go",
        "doc.go",
        "outbox.go",
        "queueengine.go",
        "queueengine_compliance.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/internal/app/queueengine",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
    deps = [
        "//framework/internal/app/plug",
        "//framework/internal/app/storeengine",
        "//framework/model",
        "//pkg/v1/clock",
        "//pkg/v1/data/queue",
        "//pkg/v1/data/sql",
        "//pkg/v1/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":queueengine",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

go_test(
    name = "queueengine_test",
    srcs = ["api_gen_test.go"],
    deps = [
        ":queueengine",
        "//framework/internal/app/plug",
        "//pkg/v1/data/queue",
    ],
)
