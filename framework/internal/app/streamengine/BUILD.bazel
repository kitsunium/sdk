alias(
    name = "go_default_library",
    actual = ":streamengine",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

go_test(
    name = "streamengine_test",
    srcs = ["gen_api_test.go"],
    deps = [":streamengine"],
