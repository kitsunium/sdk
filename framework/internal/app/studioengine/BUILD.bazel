load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "studioengine",
    srcs = [
        "devtools.go",
        "doc.go",
        "env.go",
        "events.go",
        "profile.go",
        "routes.go",
        "source.go",
        "studioengine.go",
        "studioengine_compliance.go",
        "words.go",
    ],
    embedsrcs = ["locales/fr.json"],
    importpath = "github.com/kitsunium/sdk/framework/internal/app/studioengine",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
    deps = [
        "//framework/internal/app/plug",
        "//framework/model",
        "//pkg/v1/app/i18n",
        "//pkg/v1/errs",
        "//pkg/v1/net/sse",
        "//pkg/v1/observe/profiling",
    ],
)

alias(
    name = "go_default_library",
    actual = ":studioengine",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

go_test(
    name = "studioengine_test",
    srcs = [
        "env_internal_test.go",
        "gen_api_test.go",
        "profile_internal_test.go",
        "studio_internal_test.go",
        "words_internal_test.go",
    ],
    embed = [":studioengine"],
    deps = [
        "//framework/internal/app/plug",
        "//framework/model",
        "//pkg/v1/app/i18n",
        "//pkg/v1/observe/profiling",
    ],
)
