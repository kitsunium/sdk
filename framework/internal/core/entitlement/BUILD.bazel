load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "entitlement",
    srcs = [
        "codes_gen.go",
        "decl_gen.go",
        "doc.go",
        "grant.go",
        "roster.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/internal/core/entitlement",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":entitlement",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

go_test(
    name = "entitlement_test",
    srcs = [
        "api_gen_test.go",
        "grant_internal_test.go",
        "port_internal_test.go",
        "roster_internal_test.go",
    ],
    embed = [":entitlement"],
    deps = ["//internal/kernel/errs"],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
