load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "gate",
    srcs = [
        "codes.go",
        "decision.go",
        "errors.go",
        "gate.go",
        "policy.go",
        "update_action.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/internal/core/gate",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":gate",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

go_test(
    name = "gate_test",
    srcs = [
        "api_gen_test.go",
        "policy_internal_test.go",
    ],
    embed = [":gate"],
    deps = ["//internal/kernel/errs"],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
