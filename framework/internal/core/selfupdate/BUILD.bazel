load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "selfupdate",
    srcs = [
        "codes_gen.go",
        "selfupdate.go",
        "selfupdate_interface.go",
        "update_value.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/internal/core/selfupdate",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":selfupdate",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)

go_test(
    name = "selfupdate_test",
    srcs = ["api_gen_test.go"],
    deps = [
        ":selfupdate",
        "//internal/kernel/errs",
    ],
)
