load("@rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "git",
    srcs = [
        "codes.go",
        "errors.go",
        "git.go",
        "line_range.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/internal/core/git",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":git",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
