load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "git",
    srcs = [
        "codes_gen.go",
        "doc.go",
        "git.go",
        "line_range.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/internal/core/git",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":git",
    visibility = [
        "//framework:__subpackages__",
        "//visibility:public",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)

go_test(
    name = "git_test",
    srcs = ["api_gen_test.go"],
    deps = [
        ":git",
        "//internal/kernel/errs",
    ],
)
