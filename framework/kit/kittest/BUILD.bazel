load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "kittest",
    srcs = [
        "doc.go",
        "kittest.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/kit/kittest",
    visibility = ["//visibility:public"],
    deps = [
        "//framework/kit",
        "//pkg/v1/data/vfs",
        "//pkg/v1/proc",
    ],
)

alias(
    name = "go_default_library",
    actual = ":kittest",
    visibility = ["//visibility:public"],
)

go_test(
    name = "kittest_test",
    srcs = [
        "api_gen_test.go",
        "kittest_external_test.go",
    ],
    deps = [
        ":kittest",
        "//framework/kit",
        "//framework/kit/server",
    ],
)
