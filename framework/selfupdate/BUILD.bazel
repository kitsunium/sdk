load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "selfupdate",
    srcs = ["selfupdate.go"],
    importpath = "github.com/kitsunium/sdk/framework/selfupdate",
    visibility = ["//visibility:public"],
    deps = [
        "//framework/internal/core/selfupdate",
        "//framework/internal/service/selfupdate",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":selfupdate",
    visibility = ["//visibility:public"],
)

go_test(
    name = "selfupdate_test",
    srcs = [
        "api_gen_test.go",
        "selfupdate_external_test.go",
    ],
    deps = [
        ":selfupdate",
        "//framework/internal/core/selfupdate",
        "//framework/internal/service/selfupdate",
        "//internal/kernel/errs",
        "//pkg/v1/errs",
    ],
)
