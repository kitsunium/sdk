load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/kitsunium/sdk/framework/connectors/postgres

# framework/connectors/postgres is a Go module of its own (ADR 0147 §7): one
# database driver behind the framework's engine port.

package(default_visibility = ["//visibility:public"])

go_library(
    name = "postgres",
    srcs = [
        "codes_gen.go",
        "credentials.go",
        "doc.go",
        "postgres.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/connectors/postgres",
    deps = [
        "//framework/app",
        "//framework/app/store",
        "//pkg/v1/errs",
        "//pkg/v1/security/secret",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//stdlib",
    ],
)

alias(
    name = "go_default_library",
    actual = ":postgres",
    visibility = ["//visibility:public"],
)

go_test(
    name = "postgres_test",
    srcs = [
        "api_gen_test.go",
        "app_test.go",
        "database_test.go",
        "former_journal_test.go",
        "former_keys_test.go",
        "former_refs_test.go",
        "former_test.go",
        "postgres_test.go",
        "server_test.go",
        "subsystems_test.go",
    ],
    deps = [
        ":postgres",
        "//framework/app",
        "//framework/app/server",
        "//framework/app/storetest",
        "//framework/model",
        "//pkg/v1/errs",
        "//pkg/v1/security/secret",
        "@com_github_jackc_pgx_v5//:pgx",
    ],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
