load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/kitsunium/sdk/framework/connectors/sqlite

# framework/connectors/sqlite is a Go module of its own (ADR 0147 §7): one
# database driver behind the framework's engine port.

package(default_visibility = ["//visibility:public"])

go_library(
    name = "sqlite",
    srcs = [
        "driver.go",
        "driver_none.go",
        "sqlite.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/connectors/sqlite",
    deps = [
        "//framework/kit",
        "//pkg/v1/errs",
        "//pkg/v1/proc",
        "//pkg/v1/secret",
        "//pkg/v1/sql",
    ] + select({
        "@rules_go//go/platform:aix": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:android": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:darwin": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:freebsd": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:ios": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:js": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:linux": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:netbsd": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:openbsd": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:osx": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:plan9": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:qnx": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "@rules_go//go/platform:windows": [
            "@org_modernc_sqlite//:sqlite",
        ],
        "//conditions:default": [],
    }),
)

alias(
    name = "go_default_library",
    actual = ":sqlite",
    visibility = ["//visibility:public"],
)

go_test(
    name = "sqlite_test",
    srcs = [
        "filestore_test.go",
        "keys_test.go",
        "revisions_test.go",
        "sqlite_internal_test.go",
        "sqlite_test.go",
        "subsystems_test.go",
    ],
    embed = [":sqlite"],
    deps = [
        "//framework/kit",
        "//framework/kit/server",
        "//framework/kit/storetest",
        "//framework/model",
        "//pkg/v1/secret",
        "//pkg/v1/sql",
    ],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
