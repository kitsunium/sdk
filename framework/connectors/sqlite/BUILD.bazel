load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/kitsunium/sdk/framework/connectors/sqlite

# framework/connectors/sqlite is a Go module of its own (ADR 0147 §7): one
# database driver behind the framework's engine port.

package(default_visibility = ["//visibility:public"])

go_library(
    name = "sqlite",
    srcs = ["sqlite.go"],
    importpath = "github.com/kitsunium/sdk/framework/connectors/sqlite",
    deps = [
        "//framework/kit",
        "//pkg/v1/errs",
        "//pkg/v1/secret",
        "//pkg/v1/sql",
        "@org_modernc_sqlite//:sqlite",
    ],
)

alias(
    name = "go_default_library",
    actual = ":sqlite",
    visibility = ["//visibility:public"],
)

go_test(
    name = "sqlite_test",
    srcs = [
        "filestore_test.go",
        "sqlite_internal_test.go",
        "sqlite_test.go",
        "subsystems_test.go",
    ],
    embed = [":sqlite"],
    deps = [
        "//framework/kit",
        "//framework/kit/server",
        "//framework/model",
        "//pkg/v1/secret",
        "//pkg/v1/sql",
    ],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
