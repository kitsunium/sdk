load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/kitsunium/sdk/framework/connectors/mysql

# framework/connectors/mysql is a Go module of its own (ADR 0147 §7): one
# database driver behind the framework's engine port.

package(default_visibility = ["//visibility:public"])

go_library(
    name = "mysql",
    srcs = [
        "credentials.go",
        "mysql.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/connectors/mysql",
    deps = [
        "//framework/kit",
        "//pkg/v1/data/sql",
        "//pkg/v1/errs",
        "//pkg/v1/security/secret",
        "@com_github_go_sql_driver_mysql//:mysql",
    ],
)

alias(
    name = "go_default_library",
    actual = ":mysql",
    visibility = ["//visibility:public"],
)

go_test(
    name = "mysql_test",
    srcs = [
        "api_gen_test.go",
        "app_test.go",
        "database_test.go",
        "mysql_test.go",
        "server_test.go",
        "subsystems_test.go",
    ],
    deps = [
        ":mysql",
        "//framework/kit",
        "//framework/kit/server",
        "//framework/kit/storetest",
        "//framework/model",
        "//pkg/v1/data/sql",
        "//pkg/v1/errs",
        "//pkg/v1/security/secret",
    ],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
