load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "gate",
    srcs = ["gate.go"],
    importpath = "github.com/kitsunium/sdk/framework/gate",
    visibility = ["//visibility:public"],
    deps = [
        "//framework/internal/core/gate",
        "//framework/internal/service/gate",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":gate",
    visibility = ["//visibility:public"],
)

go_test(
    name = "gate_test",
    srcs = ["gate_external_test.go"],
    deps = [
        ":gate",
        "//framework/entitlement",
        "//pkg/v1/errs",
    ],
)
