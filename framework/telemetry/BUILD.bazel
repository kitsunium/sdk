load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "telemetry",
    srcs = [
        "codes_gen.go",
        "doc.go",
        "exporter.go",
        "exporter_compliance.go",
        "telemetry.go",
        "telemetry_interface.go",
    ],
    importpath = "github.com/kitsunium/sdk/framework/telemetry",
    visibility = ["//visibility:public"],
    deps = [
        "//framework/model",
        "//internal/kernel/errs",
        "//pkg/v1/proc/ipc",
    ],
)

alias(
    name = "go_default_library",
    actual = ":telemetry",
    visibility = ["//visibility:public"],
)

