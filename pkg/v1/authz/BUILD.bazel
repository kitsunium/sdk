load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "authz",
    srcs = ["authz.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/authz",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/authz",
        "//internal/service/authz",
        "//pkg/v1/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":authz",
    visibility = ["//visibility:public"],
)

go_test(
    name = "authz_test",
    size = "small",
    srcs = ["authz_external_test.go"],
    deps = [
        ":authz",
        "//pkg/v1/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
