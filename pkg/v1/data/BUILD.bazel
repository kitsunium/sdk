# pkg/v1/data is a Go module of its own (ADR 0171): the data family's public packages.
# This directory holds no package; the file marks the module root as a Bazel
# package so gazelle's go_deps extension can load //pkg/v1/data:go.mod, which go.work
# names.

package(default_visibility = ["//visibility:public"])
