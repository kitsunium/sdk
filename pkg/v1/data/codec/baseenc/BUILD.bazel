alias(
    name = "go_default_library",
    actual = ":baseenc",
    visibility = ["//visibility:public"],
)

go_test(
    name = "baseenc_test",
    srcs = [
        "api_gen_test.go",
        "baseenc_external_test.go",
    ],
    deps = [
        ":baseenc",
        "//internal/core/data/codec",
        "//internal/kernel/errs",
        "//pkg/v1/errs",
    ],
