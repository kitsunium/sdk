load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "baseenc",
    srcs = [
        "baseenc.go",
        "facade_gen.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/data/codec/baseenc",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/data/codec/baseenc",
        "//internal/kernel/errs",
        "//internal/service/data/codec/baseenc",
