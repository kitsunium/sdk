load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "yaml",
    srcs = [
        "doc.go",
        "facade_gen.go",
        "yaml.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/data/codec/yaml",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/data/codec/yaml",
        "//internal/kernel/errs",
        "//internal/service/data/codec/yaml",
    ],
)

alias(
    name = "go_default_library",
    actual = ":yaml",
    visibility = ["//visibility:public"],
)

go_test(
    name = "yaml_test",
    srcs = [
        "api_gen_test.go",
        "yaml_external_test.go",
    ],
    deps = [
        ":yaml",
        "//internal/core/data/codec",
        "//internal/kernel/errs",
        "//pkg/v1/app/config",
        "//pkg/v1/errs",
    ],
)
