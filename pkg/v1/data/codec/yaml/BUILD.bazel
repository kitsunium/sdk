load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "yaml",
    srcs = ["yaml.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/data/codec/yaml",
    visibility = ["//visibility:public"],
    deps = ["//internal/service/data/codec/yaml"],
)

alias(
    name = "go_default_library",
    actual = ":yaml",
    visibility = ["//visibility:public"],
)

go_test(
    name = "yaml_test",
    srcs = ["yaml_external_test.go"],
    deps = [
        ":yaml",
        "//internal/core/data/codec",
        "//pkg/v1/app/config",
    ],
)
