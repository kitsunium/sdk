load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "csv",
    srcs = [
        "csv.go",
        "doc.go",
        "facade_gen.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/data/codec/csv",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/data/codec/csv",
        "//internal/kernel/errs",
        "//internal/service/data/codec/csv",
    ],
)

alias(
    name = "go_default_library",
    actual = ":csv",
    visibility = ["//visibility:public"],
)

go_test(
    name = "csv_test",
    srcs = [
        "api_gen_test.go",
        "csv_external_test.go",
    ],
    deps = [
        ":csv",
        "//internal/core/data/codec",
        "//internal/kernel/errs",
        "//pkg/v1/errs",
    ],
)
