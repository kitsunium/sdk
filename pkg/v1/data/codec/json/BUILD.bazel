load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "json",
    srcs = [
        "doc.go",
        "gen_facade.go",
        "json.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/data/codec/json",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/data/codec/json",
        "//internal/kernel/errs",
        "//internal/service/data/codec/json",
    ],
)

alias(
    name = "go_default_library",
    actual = ":json",
    visibility = ["//visibility:public"],
)

go_test(
    name = "json_test",
    srcs = [
        "gen_api_test.go",
        "json_external_test.go",
    ],
    deps = [
        ":json",
        "//internal/core/app/config",
        "//internal/core/data/codec",
        "//internal/kernel/errs",
        "//internal/service/app/config",
        "//pkg/v1/errs",
    ],
)
