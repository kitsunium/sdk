)

go_test(
    name = "stream_test",
    srcs = [
        "gen_api_test.go",
        "stream_external_test.go",
    ],
    deps = [
        ":stream",
        "//internal/core/data/stream",
        "//internal/kernel/errs",
        "//internal/service/data/stream",
        "//pkg/v1/data/sql",
        "//pkg/v1/data/vfs",
