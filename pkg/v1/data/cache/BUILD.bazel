load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "cache",
    srcs = [
        "doc.go",
        "facade_gen.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/data/cache",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/data/cache",
        "//internal/kernel/collections/cache",
        "//internal/service/data/cache",
    ],
)

alias(
    name = "go_default_library",
    actual = ":cache",
    visibility = ["//visibility:public"],
)

go_test(
    name = "cache_test",
    srcs = [
        "api_gen_test.go",
        "cache_external_test.go",
    ],
    deps = [
        ":cache",
        "//internal/core/data/cache",
        "//internal/kernel/collections/cache",
        "//internal/kernel/errs",
        "//internal/service/data/cache",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
