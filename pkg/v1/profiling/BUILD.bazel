load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "profiling",
    srcs = ["profiling.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/profiling",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/kernel/errs",
        "//internal/service/profiling",
    ],
)

alias(
    name = "go_default_library",
    actual = ":profiling",
    visibility = ["//visibility:public"],
)

go_test(
    name = "profiling_test",
    srcs = ["profiling_external_test.go"],
    deps = [
        ":profiling",
        "//pkg/v1/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
