load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "lock",
    srcs = ["lock.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/lock",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/lock",
        "//internal/service/lock",
    ],
)

alias(
    name = "go_default_library",
    actual = ":lock",
    visibility = ["//visibility:public"],
)

go_test(
    name = "lock_test",
    size = "small",
    srcs = ["lock_external_test.go"],
    deps = [
        ":lock",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
