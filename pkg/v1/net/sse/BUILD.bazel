load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "sse",
    srcs = ["sse.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/net/sse",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/net",
        "//internal/service/net/sse",
    ],
)

alias(
    name = "go_default_library",
    actual = ":sse",
    visibility = ["//visibility:public"],
)

go_test(
    name = "sse_test",
    srcs = [
        "api_gen_test.go",
        "sse_external_test.go",
    ],
    deps = [
        ":sse",
        "//internal/core/net",
        "//internal/service/net/sse",
        "//pkg/v1/net/server",
    ],
)
