load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "client",
    srcs = [
        "client.go",
        "facade_gen.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/net/client",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/net",
        "//internal/service/net/client",
        "//pkg/v1/net/tlsid",
    ],
)

alias(
    name = "go_default_library",
    actual = ":client",
    visibility = ["//visibility:public"],
)

go_test(
    name = "client_test",
    srcs = [
        "api_gen_test.go",
        "client_bench_test.go",
        "client_external_test.go",
    ],
    deps = [
        ":client",
        "//internal/core/net",
        "//internal/service/net/client",
        "//pkg/v1/net/tlsid",
    ],
)
