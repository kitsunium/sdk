alias(
    name = "go_default_library",
    actual = ":tlsid",
    visibility = ["//visibility:public"],
)

go_test(
    name = "tlsid_test",
    srcs = [
        "api_gen_test.go",
        "tlsid_external_test.go",
    ],
    deps = [
        ":tlsid",
        "//internal/core/net",
    ],
