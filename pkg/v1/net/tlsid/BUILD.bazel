load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "tlsid",
    srcs = ["tlsid.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/net/tlsid",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/net",
        "//internal/service/net/tlsid",
    ],
