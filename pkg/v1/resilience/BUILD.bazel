load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "resilience",
    srcs = ["resilience.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/resilience",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/resilience",
        "//internal/service/resilience",
    ],
)

alias(
    name = "go_default_library",
    actual = ":resilience",
    visibility = ["//visibility:public"],
)

go_test(
    name = "resilience_test",
    srcs = [
        "resilience_bench_test.go",
        "resilience_external_test.go",
    ],
    deps = [
        ":resilience",
        "//pkg/v1/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
