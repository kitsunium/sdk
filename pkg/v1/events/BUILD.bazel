load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "events",
    srcs = ["events.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/events",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/events",
        "//internal/service/events",
    ],
)

alias(
    name = "go_default_library",
    actual = ":events",
    visibility = ["//visibility:public"],
)

go_test(
    name = "events_test",
    size = "small",
    srcs = ["events_external_test.go"],
    deps = [
        ":events",
        "//pkg/v1/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
