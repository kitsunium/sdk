load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "clock",
    srcs = [
        "doc.go",
        "facade_gen.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/clock",
    visibility = ["//visibility:public"],
    deps = ["//internal/kernel/clock"],
)

alias(
    name = "go_default_library",
    actual = ":clock",
    visibility = ["//visibility:public"],
)

go_test(
    name = "clock_test",
    srcs = [
        "api_gen_test.go",
        "clock_external_test.go",
    ],
    deps = [
        ":clock",
        "//internal/kernel/clock",
    ],
)
