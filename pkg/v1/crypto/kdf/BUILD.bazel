load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "kdf",
    srcs = ["kdf.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/crypto/kdf",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/crypto",
        "//internal/service/crypto/kdf/hkdfsha256",
        "//internal/service/crypto/kdf/keytree",
    ],
)

alias(
    name = "go_default_library",
    actual = ":kdf",
    visibility = ["//visibility:public"],
)

go_test(
    name = "kdf_test",
    srcs = [
        "kdf_bench_test.go",
        "kdf_external_test.go",
    ],
    deps = [
        ":kdf",
        "//pkg/v1/errs",
    ],
)
