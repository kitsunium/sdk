load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "crypto",
    srcs = ["crypto.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/crypto",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/crypto",
        "//internal/service/crypto/aesgcm",
        "//internal/service/crypto/keyenvelope",
        "//internal/service/crypto/streamaead",
    ],
)

alias(
    name = "go_default_library",
    actual = ":crypto",
    visibility = ["//visibility:public"],
)

go_test(
    name = "crypto_test",
    srcs = ["crypto_external_test.go"],
    deps = [":crypto"],
)
