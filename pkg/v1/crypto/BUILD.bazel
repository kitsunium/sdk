load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "crypto",
    srcs = [
        "crypto.go",
        "doc.go",
        "facade_gen.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/crypto",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/crypto",
        "//internal/service/crypto/aead/aesgcm",
        "//internal/service/crypto/aead/streamaead",
        "//internal/service/crypto/key/keyenvelope",
    ],
)

alias(
    name = "go_default_library",
    actual = ":crypto",
    visibility = ["//visibility:public"],
)

go_test(
    name = "crypto_test",
    srcs = [
        "api_gen_test.go",
        "crypto_bench_test.go",
        "crypto_external_test.go",
    ],
    deps = [
        ":crypto",
        "//internal/core/crypto",
    ],
)
