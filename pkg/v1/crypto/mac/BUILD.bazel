load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "mac",
    srcs = [
        "doc.go",
        "facade_gen.go",
        "mac.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/crypto/mac",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/crypto",
        "//internal/service/crypto/mac/hmacsha2",
    ],
)

alias(
    name = "go_default_library",
    actual = ":mac",
    visibility = ["//visibility:public"],
)

go_test(
    name = "mac_test",
    srcs = [
        "api_gen_test.go",
        "mac_bench_test.go",
        "mac_external_test.go",
    ],
    deps = [
        ":mac",
        "//internal/core/crypto",
        "//pkg/v1/errs",
    ],
)
