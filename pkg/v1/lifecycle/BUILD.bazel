load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "lifecycle",
    srcs = ["lifecycle.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/lifecycle",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/lifecycle",
        "//internal/core/proc",
        "//internal/service/lifecycle",
    ],
)

alias(
    name = "go_default_library",
    actual = ":lifecycle",
    visibility = ["//visibility:public"],
)

go_test(
    name = "lifecycle_test",
    size = "small",
    srcs = ["lifecycle_external_test.go"],
    deps = [
        ":lifecycle",
        "//pkg/v1/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
