load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:exclude codec_bench_test.go
# Reason: codec_bench_test.go is wired into a dedicated `codec_bench_test`
# go_test target (tagged "manual") so it never runs under `bazel test //...`.
# Without this exclude, gazelle merges it into the default codec_test target
# on every run — the bench file would then be linked into the regular test
# binary even though its package-level fixtures cost setup time for no gain.

package(default_visibility = ["//visibility:public"])

go_library(
    name = "codec",
    srcs = [
        "codec.go",
        "codes.go",
        "compressed.go",
        "errors.go",
        "promote.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/codec",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/codec",
        "//internal/core/transform",
        "//internal/kernel/errs",
        "//internal/service/codec/asn1",
        "//internal/service/codec/baseenc",
        "//internal/service/codec/bson",
        "//internal/service/codec/cbor",
        "//internal/service/codec/csv",
        "//internal/service/codec/flatbuffers",
        "//internal/service/codec/json",
        "//internal/service/codec/msgpack",
        "//internal/service/codec/multipart",
        "//internal/service/codec/ndjson",
        "//internal/service/codec/pem",
        "//internal/service/codec/tlv",
        "//internal/service/codec/toml",
        "//internal/service/codec/xml",
        "//internal/service/codec/yaml",
        "//internal/service/transform",
        "//pkg/v1/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":codec",
    visibility = ["//visibility:public"],
)

go_test(
    name = "codec_test",
    size = "small",
    srcs = [
        "codec_external_test.go",
        "codec_internal_test.go",
        "compressed_external_test.go",
        "compressed_internal_test.go",
        "fixtures_integration_test.go",
        "promote_internal_test.go",
    ],
    embed = [":codec"],
    deps = [
        "//internal/core/codec",
        "//internal/core/transform",
        "//internal/kernel/errs",
        "//internal/service/codec/flatbuffers",
        "//pkg/v1/errs",
    ],
)

# Per-codec benchmark suite — 18 Format names × 3 payload sizes × up to 7
# operations (Marshal / Unmarshal / *Parallel / Append / StreamEncode /
# StreamDecode). The `manual` tag keeps the target OUT of the `bazel test //...`
# wildcard so PR CI stays fast. Re-uses helpers from codec_external_test.go via
# shared package codec_test.
#
# Two ways to invoke:
#
#   • `make bench` — runs `bazel run //pkg/v1/codec:codec_bench_test --
#     -test.run=TestGenerateBenchMD …` which executes the matrix
#     programmatically (via testing.Benchmark) and writes BENCH.md to the
#     source tree using $BUILD_WORKSPACE_DIRECTORY.
#
#   • `bazel test //pkg/v1/codec:codec_bench_test --test_arg=-test.bench=.
#     --test_arg=-test.benchmem` — the legacy mode used by developers who
#     want stdout-streamed numbers without regenerating BENCH.md.
#
# `tags = ["benchmark", "manual"]` are Bazel target tags: `manual` keeps this
# target OUT of `bazel test //...` (wildcard CI), and `benchmark` labels intent.
# The target compiles codec_bench_test.go (the matrix + the BENCH.md generator);
# there is no separate build-tag-gated file.
#
# `size = "enormous"` + `timeout = "eternal"` lift the default 5-min cap so
# the full matrix at `-test.benchtime=2s` always completes — slower machines
# (ARM emulation, CI sandboxes) need every bit of that budget. The `manual`
# tag still keeps this OUT of `bazel test //...`, so the enormous size doesn't
# slow down regular PR CI runs.
go_test(
    name = "codec_bench_test",
    size = "enormous",
    timeout = "eternal",
    srcs = [
        "codec_bench_test.go",
        "codec_external_test.go",
    ],
    args = [
        "-test.run=^$$",
        "-test.bench=.",
        "-test.benchmem",
    ],
    embed = [":codec"],
    tags = [
        "benchmark",
        "manual",
    ],
    deps = [
        "//internal/core/codec",
        "//internal/kernel/errs",
    ],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
