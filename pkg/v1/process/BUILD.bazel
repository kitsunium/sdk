load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "process",
    srcs = [
        "process.go",
        "signals.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/process",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/proc",
        "//internal/service/proc/exec",
    ],
)

alias(
    name = "go_default_library",
    actual = ":process",
    visibility = ["//visibility:public"],
)

go_test(
    name = "process_test",
    srcs = ["process_external_test.go"],
    deps = [
        ":process",
        "//internal/core/proc",
        "//internal/kernel/errs",
    ],
)
