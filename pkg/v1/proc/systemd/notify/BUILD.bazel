    name = "notify",
    srcs = ["sdnotify.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/proc/systemd/notify",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/proc",
        "//internal/service/proc/systemd/notify",
    ],
)

