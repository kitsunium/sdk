load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "process",
    srcs = [
        "facade_gen.go",
        "process.go",
        "signals.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/proc/process",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/proc",
        "//internal/service/proc/exec",
        "//internal/service/proc/self",
    ],
)

alias(
    name = "go_default_library",
    actual = ":process",
    visibility = ["//visibility:public"],
)

go_test(
    name = "process_test",
    srcs = [
        "api_gen_test.go",
        "process_external_test.go",
        "process_other_test.go",
        "process_unix_external_test.go",
        "process_windows_test.go",
        "self_external_test.go",
    ],
    deps = [
        ":process",
        "//internal/core/proc",
        "//internal/kernel/errs",
        "//internal/service/proc/self",
    ],
)
