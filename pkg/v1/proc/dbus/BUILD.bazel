    name = "go_default_library",
    actual = ":dbus",
    visibility = ["//visibility:public"],
)

go_test(
    name = "dbus_test",
    srcs = [
        "dbus_external_test.go",
        "gen_api_test.go",
    ],
    deps = [
        ":dbus",
        "//internal/kernel/errs",
        "//internal/service/proc/dbus",
        "//pkg/v1/errs",
        "//pkg/v1/proc/service",
    ],
