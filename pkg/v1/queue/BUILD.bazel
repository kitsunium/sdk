load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "queue",
    srcs = ["queue.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/queue",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/queue",
        "//internal/service/queue",
    ],
)

alias(
    name = "go_default_library",
    actual = ":queue",
    visibility = ["//visibility:public"],
)

go_test(
    name = "queue_test",
    size = "small",
    srcs = ["queue_external_test.go"],
    deps = [
        ":queue",
        "//pkg/v1/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
