load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "trace",
    srcs = [
        "facade_gen.go",
        "trace.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/observe/trace",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/net",
        "//internal/core/observe/otel",
        "//internal/core/observe/trace",
        "//internal/service/observe/trace",
    ],
)

alias(
    name = "go_default_library",
    actual = ":trace",
    visibility = ["//visibility:public"],
)

go_test(
    name = "trace_test",
    srcs = [
        "api_gen_test.go",
        "facade_bench_test.go",
        "trace_bench_test.go",
        "trace_external_test.go",
    ],
    deps = [
        ":trace",
        "//internal/core/net",
        "//internal/core/observe/otel",
        "//internal/core/observe/trace",
        "//internal/service/observe/trace",
        "//pkg/v1/observe/metrics",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
