load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "logger",
    srcs = [
        "codes_gen.go",
        "encoder.go",
        "facade_gen.go",
        "fromconfig.go",
        "logger.go",
        "sink.go",
        "topology.go",
        "tracecontext.go",
        "version.go",
        "witherror.go",
        "writer.go",
        "writer_entry.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/observe/logger",
    visibility = ["//visibility:public"],
    # keep
    x_defs = {
        "github.com/kitsunium/sdk/pkg/v1/observe/logger.Version": "{STABLE_VERSION}",
    },
    deps = [
        "//internal/core/data/codec",
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/level",
        "//internal/core/observe/logger/writer",
        "//internal/core/observe/trace",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/observe/logger",
        "//internal/service/observe/logger/encoder",
        "//internal/service/observe/logger/middleware/multi",
        "//internal/service/observe/logger/sink/console",
        "//internal/service/observe/logger/sink/memory",
        "//internal/service/observe/logger/writer/levelgate",
    ],
)

alias(
    name = "go_default_library",
    actual = ":logger",
    visibility = ["//visibility:public"],
)

go_test(
    name = "logger_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "builder_external_test.go",
        "builder_integration_test.go",
        "caller_external_test.go",
        "encoder_external_test.go",
        "fanout_integration_test.go",
        "fromconfig_external_test.go",
        "fromconfig_internal_test.go",
        "levelgate_external_test.go",
        "levelvar_external_test.go",
        "logger_bench_test.go",
        "logger_external_test.go",
        "memory_external_test.go",
        "sink_external_test.go",
        "tracecontext_external_test.go",
        "tracecontext_integration_test.go",
        "version_external_test.go",
        "witherror_external_test.go",
        "witherror_internal_test.go",
        "writer_external_test.go",
    ],
    # keep: BENCH.md is read at test time by the V116 doc-guard (TestV116BenchDocRetractsZeroAllocClaim).
    data = ["BENCH.md"],
    embed = [":logger"],
    deps = [
        "//internal/core/data/codec",
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/level",
        "//internal/core/observe/logger/writer",
        "//internal/kernel/errs",
        "//internal/service/data/codec/json",
        "//internal/service/observe/logger",
        "//internal/service/observe/logger/encoder",
        "//internal/service/observe/logger/sink/memory",
        "//pkg/v1/errs",
        "//pkg/v1/observe/logger/writer",
        "//pkg/v1/observe/trace",
    ],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
