load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "slogbridge",
    srcs = [
        "convert.go",
        "doc.go",
        "gen_codes.go",
        "handler.go",
        "slogbridge.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/observe/logger/slogbridge",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/kernel/errs",
        "//pkg/v1/observe/logger",
    ],
)

alias(
    name = "go_default_library",
    actual = ":slogbridge",
    visibility = ["//visibility:public"],
)

go_test(
    name = "slogbridge_test",
    srcs = [
        "convert_internal_test.go",
        "gen_api_test.go",
        "handler_internal_test.go",
        "slogbridge_external_test.go",
    ],
    embed = [":slogbridge"],
    deps = [
        "//internal/core/security/secret",
        "//internal/kernel/errs",
        "//pkg/v1/errs",
        "//pkg/v1/observe/logger",
    ],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
