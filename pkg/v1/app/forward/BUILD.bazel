    name = "go_default_library",
    actual = ":forward",
    visibility = ["//visibility:public"],
)

go_test(
    name = "forward_test",
    srcs = [
        "forward_external_test.go",
        "gen_api_test.go",
    ],
    deps = [
        ":forward",
        "//internal/core/observe/metrics",
        "//internal/core/observe/trace",
        "//internal/kernel/errs",
        "//internal/service/app/forward",
        "//pkg/v1/data/queue",
        "//pkg/v1/errs",
        "//pkg/v1/observe/trace",
    ],
