load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "forward",
    srcs = [
        "doc.go",
        "gen_facade.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/app/forward",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/app/forward",
        "//internal/core/observe/metrics",
        "//internal/core/observe/trace",
