load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "view",
    srcs = ["view.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/app/view",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/app/view",
        "//internal/service/app/view",
    ],
)

alias(
    name = "go_default_library",
    actual = ":view",
    visibility = ["//visibility:public"],
)

go_test(
    name = "view_test",
    size = "small",
    srcs = ["view_external_test.go"],
    deps = [":view"],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
