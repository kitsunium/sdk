load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "i18n",
    srcs = [
        "facade_gen.go",
        "i18n.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/app/i18n",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/app/i18n",
        "//internal/core/data/codec",
        "//internal/service/app/i18n",
    ],
)

alias(
    name = "go_default_library",
    actual = ":i18n",
    visibility = ["//visibility:public"],
)

go_test(
    name = "i18n_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "i18n_external_test.go",
    ],
    deps = [
        ":i18n",
        "//internal/core/app/i18n",
        "//internal/core/data/codec",
        "//internal/service/app/i18n",
        "//pkg/v1/data/codec",
        "//pkg/v1/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
