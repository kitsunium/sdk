load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "id",
    srcs = ["id.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/app/id",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/app/id",
        "//internal/service/app/id",
    ],
)

alias(
    name = "go_default_library",
    actual = ":id",
    visibility = ["//visibility:public"],
)

go_test(
    name = "id_test",
    srcs = [
        "api_gen_test.go",
        "id_bench_test.go",
        "id_external_test.go",
    ],
    deps = [
        ":id",
        "//internal/core/app/id",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
