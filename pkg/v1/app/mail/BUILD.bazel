load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "mail",
    srcs = ["mail.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/app/mail",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/app/mail",
        "//internal/service/app/mail",
    ],
)

alias(
    name = "go_default_library",
    actual = ":mail",
    visibility = ["//visibility:public"],
)

go_test(
    name = "mail_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "mail_external_test.go",
    ],
    deps = [
        ":mail",
        "//internal/core/app/mail",
        "//internal/service/app/mail",
        "//pkg/v1/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
