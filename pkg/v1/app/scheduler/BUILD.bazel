load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "scheduler",
    srcs = [
        "doc.go",
        "gen_facade.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/v1/app/scheduler",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/app/scheduler",
        "//internal/service/app/scheduler",
    ],
)

alias(
    name = "go_default_library",
    actual = ":scheduler",
    visibility = ["//visibility:public"],
)

go_test(
    name = "scheduler_test",
    size = "small",
    srcs = [
        "gen_api_test.go",
        "scheduler_bench_test.go",
        "scheduler_external_test.go",
    ],
    deps = [
        ":scheduler",
        "//internal/core/app/scheduler",
        "//internal/service/app/scheduler",
        "//pkg/v1/app/health",
        "//pkg/v1/app/lifecycle",
        "//pkg/v1/app/lock",
        "//pkg/v1/clock",
        "//pkg/v1/data/cache",
        "//pkg/v1/data/queue",
        "//pkg/v1/data/sql",
        "//pkg/v1/errs",
        "//pkg/v1/security/session",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
