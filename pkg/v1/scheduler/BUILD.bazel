load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "scheduler",
    srcs = ["scheduler.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/scheduler",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/scheduler",
        "//internal/service/scheduler",
    ],
)

alias(
    name = "go_default_library",
    actual = ":scheduler",
    visibility = ["//visibility:public"],
)

go_test(
    name = "scheduler_test",
    size = "small",
    srcs = [
        "scheduler_bench_test.go",
        "scheduler_external_test.go",
    ],
    deps = [
        ":scheduler",
        "//pkg/v1/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
