load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "health",
    srcs = ["health.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/health",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/health",
        "//internal/core/lifecycle",
        "//internal/service/health",
    ],
)

alias(
    name = "go_default_library",
    actual = ":health",
    visibility = ["//visibility:public"],
)

go_test(
    name = "health_test",
    srcs = ["health_external_test.go"],
    deps = [
        ":health",
        "//pkg/v1/errs",
        "//pkg/v1/lifecycle",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
