load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "secret",
    srcs = ["secret.go"],
    importpath = "github.com/kitsunium/sdk/pkg/v1/secret",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/secret",
        "//internal/service/secret",
        "//pkg/v1/crypto",
    ],
)

alias(
    name = "go_default_library",
    actual = ":secret",
    visibility = ["//visibility:public"],
)

go_test(
    name = "secret_test",
    srcs = ["secret_external_test.go"],
    deps = [
        ":secret",
        "//pkg/v1/clock",
        "//pkg/v1/codec",
        "//pkg/v1/config",
        "//pkg/v1/errs",
        "//pkg/v1/logger",
        "//pkg/v1/proc",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
