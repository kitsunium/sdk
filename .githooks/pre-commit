#!/usr/bin/env bash
# ============================================================================
# pre-commit hook — chains the devcontainer template checks AND the project's
# own pre-commit guards.
#
# Template checks (multi-language lint/build/test) live in the devcontainer
# image and are auto-synced via `/update`. Project-local checks live in
# scripts/pre-commit/ and ship in this repo so every clone gets them via
# `git config core.hooksPath .githooks` (run once after clone).
#
# This file and every guard it runs work with the tools a Mac ships — the
# /bin/bash 3.2 and the BSD find in /usr/bin — as well as with bash 5 and GNU
# find (#260). scripts/pre-commit/test-pre-commit-guards.bats holds them to it.
# ============================================================================

set -euo pipefail

WORKSPACE="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
TEMPLATE_SCRIPT="$HOME/.claude/scripts/pre-commit-checks.sh"

if [ ! -f "$TEMPLATE_SCRIPT" ]; then
    TEMPLATE_SCRIPT="$WORKSPACE/.devcontainer/images/.claude/scripts/pre-commit-checks.sh"
fi

# 1) Template-provided multi-language checks (optional — only when devcontainer
#    is present).
#
#    The template script is written for the devcontainer's bash: it declares an
#    associative array, which bash added in 4.0, so under macOS's /bin/bash 3.2
#    it stops on its first line of work — `declare: -A: invalid option`, exit 2
#    — and used to take every commit down with it. It belongs to the template
#    (.devcontainer/ is template-seeded and synced), so it is not rewritten
#    here: under an older bash the step is SKIPPED, and says so, and the
#    project guards below still run. The check asks the bash that will run the
#    script, not the one running this hook, because the two can differ.
if [ -f "$TEMPLATE_SCRIPT" ]; then
    if bash -c '[ "${BASH_VERSINFO[0]}" -ge 4 ]'; then
        bash "$TEMPLATE_SCRIPT" "$WORKSPACE" || exit $?
    else
        echo "pre-commit: template checks SKIPPED — $TEMPLATE_SCRIPT needs bash 4 or later, and" \
            "$(command -v bash) is $(bash -c 'echo "$BASH_VERSION"')." >&2
        echo "  The project guards (scripts/pre-commit/) run below; put a bash 4+ first on PATH to run the template's too." >&2
    fi
fi

# 2) Project-local checks. Every executable *.sh under scripts/pre-commit/
#    runs in lexical order; a non-zero exit aborts the commit.
LOCAL_DIR="$WORKSPACE/scripts/pre-commit"
if [ -d "$LOCAL_DIR" ]; then
    while IFS= read -r -d '' check; do
        bash "$check" "$WORKSPACE" || exit $?
    done < <(find "$LOCAL_DIR" -maxdepth 1 -type f -name '*.sh' -perm -u+x -print0 | sort -z)
fi

exit 0
