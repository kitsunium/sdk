load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "cgroup",
    srcs = [
        "cgroup.go",
        "cgroup_freebsd.go",
        "cgroup_linux.go",
        "cgroup_other.go",
        "cgroup_windows.go",
        "doc.go",
        "groupstat_freebsd.go",
        "groupstat_freebsd_compliance.go",
        "groupstat_linux.go",
        "groupstat_linux_compliance.go",
        "groupstat_windows.go",
        "groupstat_windows_compliance.go",
        "members_linux.go",
        "membership_linux.go",
        "membership_other.go",
        "option.go",
        "tree_linux.go",
        "tune_linux.go",
        "watch_linux.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/proc/cgroup",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/proc",
    ] + select({
        "@rules_go//go/platform:android": [
            "//internal/kernel/errs",
            "//internal/service/proc/internal/cgroupfs",
        ],
        "@rules_go//go/platform:freebsd": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/kernel/errs",
            "//internal/service/proc/internal/cgroupfs",
        ],
        "@rules_go//go/platform:windows": [
            "//internal/kernel/errs",
        ],
        "//conditions:default": [],
    }),
)

alias(
    name = "go_default_library",
    actual = ":cgroup",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "cgroup_test",
    srcs = [
        "cgroup_external_test.go",
        "cgroup_linux_bench_test.go",
        "cgroup_linux_internal_test.go",
        "cgroup_live_linux_bench_test.go",
        "cgroup_other_test.go",
        "cgroup_windows_test.go",
        "gen_api_test.go",
        "groupstat_linux_external_test.go",
        "groupstat_linux_internal_test.go",
        "groupstat_other_test.go",
        "groupstat_windows_test.go",
        "host_linux_external_test.go",
        "host_other_external_test.go",
        "option_external_test.go",
        "option_internal_test.go",
        "probe_linux_external_test.go",
        "probe_other_external_test.go",
        "s0g_linux_internal_test.go",
        "s1_linux_external_test.go",
        "s1_linux_internal_test.go",
        "s2_linux_external_test.go",
    ],
    embed = [":cgroup"],
    deps = [
        "//internal/core/proc",
        "//internal/kernel/errs",
    ] + select({
        "@rules_go//go/platform:android": [
            "//internal/core/proc/service",
            "//internal/service/proc/exec",
            "//internal/service/proc/internal/cgroupfs",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/core/proc/service",
            "//internal/service/proc/exec",
            "//internal/service/proc/internal/cgroupfs",
        ],
        "//conditions:default": [],
    }),
)
