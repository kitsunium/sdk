alias(
    name = "go_default_library",
    actual = ":childwait",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "childwait_test",
    srcs = [
        "childwait_internal_test.go",
        "childwait_unix_internal_test.go",
    ],
    embed = [":childwait"],
