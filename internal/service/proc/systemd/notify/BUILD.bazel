load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "notify",
    srcs = [
        "assignments.go",
        "detach_unix.go",
        "dial.go",
        "dial_windows.go",
        "doc.go",
        "listen_freebsd.go",
        "listen_linux.go",
        "listen_other.go",
        "listen_unix.go",
        "notify.go",
        "sdnotify.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/proc/systemd/notify",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/proc",
        "//internal/kernel/errs",
    ] + select({
        "@rules_go//go/platform:freebsd": [
            "//internal/service/proc/internal/bsdabi",
        ],
        "//conditions:default": [],
    }),
)

alias(
    name = "go_default_library",
    actual = ":notify",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "notify_test",
    srcs = [
        "assignments_internal_test.go",
        "gen_api_1_test.go",
        "gen_api_2_test.go",
        "gen_api_test.go",
        "listen_linux_external_test.go",
        "listen_linux_internal_test.go",
        "notify_bounded_linux_external_test.go",
        "notify_external_test.go",
        "notify_internal_test.go",
        "notify_windows_test.go",
        "sdnotify_bench_test.go",
        "sdnotify_external_test.go",
        "sdnotify_internal_test.go",
        "sdnotify_other_test.go",
        "transport_freebsd_internal_test.go",
        "transport_internal_test.go",
        "transport_linux_internal_test.go",
    ],
    embed = [":notify"],
    deps = [
        "//internal/core/proc",
        "//internal/kernel/errs",
    ],
)
