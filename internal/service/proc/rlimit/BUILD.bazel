load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "rlimit",
    srcs = [
        "rlimit.go",
        "rlimit_linux.go",
        "rlimit_other.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/proc/rlimit",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/proc",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":rlimit",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "rlimit_test",
    srcs = ["rlimit_external_test.go"],
    embed = [":rlimit"],
    deps = [
        "//internal/core/proc",
        "//internal/kernel/errs",
    ],
)
