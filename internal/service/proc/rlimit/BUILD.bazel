load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "rlimit",
    srcs = [
        "rlimit.go",
        "rlimit_linux.go",
        "rlimit_other.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/proc/rlimit",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/proc",
    ] + select({
        "@rules_go//go/platform:android": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/kernel/errs",
        ],
        "//conditions:default": [],
    }),
)

alias(
    name = "go_default_library",
    actual = ":rlimit",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "rlimit_test",
    srcs = [
        "rlimit_external_test.go",
        "rlimit_other_test.go",
    ],
    deps = [
        ":rlimit",
        "//internal/core/proc",
        "//internal/kernel/errs",
    ],
)
