load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "rlimit",
    srcs = [
        "rlimit.go",
        "rlimit_linux.go",
        "rlimit_other.go",
        "rlimit_table_as.go",
        "rlimit_table_openbsd.go",
        "rlimit_unix.go",
        "rlimit_value_default.go",
        "rlimit_value_signed.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/proc/rlimit",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/proc",
    ] + select({
        "@rules_go//go/platform:aix": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:android": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:darwin": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:dragonfly": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:freebsd": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:illumos": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:ios": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:netbsd": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:openbsd": [
            "//internal/kernel/errs",
        ],
        "@rules_go//go/platform:solaris": [
            "//internal/kernel/errs",
        ],
        "//conditions:default": [],
    }),
)

alias(
    name = "go_default_library",
    actual = ":rlimit",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "rlimit_test",
    srcs = [
        "rlimit_bench_test.go",
        "rlimit_external_test.go",
        "rlimit_linux_bench_test.go",
        "rlimit_linux_internal_test.go",
        "rlimit_other_test.go",
        "rlimit_value_default_internal_test.go",
        "rlimit_value_signed_internal_test.go",
    ],
    embed = [":rlimit"],
    deps = [
        "//internal/core/proc",
        "//internal/kernel/errs",
    ],
)
