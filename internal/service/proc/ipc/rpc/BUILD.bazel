load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "rpc",
    srcs = [
        "client.go",
        "config.go",
        "doc.go",
        "frame.go",
        "keeper.go",
        "router.go",
        "rpc_compliance.go",
        "server.go",
        "serverconn.go",
        "stream.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/proc/ipc/rpc",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/data/codec",
        "//internal/core/proc/ipc",
        "//internal/core/proc/ipc/rpc",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":rpc",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "rpc_test",
    srcs = [
        "frames_external_test.go",
        "gen_api_test.go",
        "gen_perf_test.go",
        "perf_fixtures_test.go",
        "rpc_bench_test.go",
        "rpc_external_test.go",
        "socket_unix_external_test.go",
    ],
    deps = [
        ":rpc",
        "//internal/core/data/codec",
        "//internal/core/proc/ipc",
        "//internal/core/proc/ipc/rpc",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/data/codec/json",
        "//internal/service/data/codec/msgpack",
    ] + select({
        "@rules_go//go/platform:aix": [
            "//internal/service/proc/ipc",
        ],
        "@rules_go//go/platform:android": [
            "//internal/service/proc/ipc",
        ],
        "@rules_go//go/platform:darwin": [
            "//internal/service/proc/ipc",
        ],
        "@rules_go//go/platform:dragonfly": [
            "//internal/service/proc/ipc",
        ],
        "@rules_go//go/platform:freebsd": [
            "//internal/service/proc/ipc",
        ],
        "@rules_go//go/platform:illumos": [
            "//internal/service/proc/ipc",
        ],
        "@rules_go//go/platform:ios": [
            "//internal/service/proc/ipc",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/service/proc/ipc",
        ],
        "@rules_go//go/platform:netbsd": [
            "//internal/service/proc/ipc",
        ],
        "@rules_go//go/platform:openbsd": [
            "//internal/service/proc/ipc",
        ],
        "@rules_go//go/platform:solaris": [
            "//internal/service/proc/ipc",
        ],
        "//conditions:default": [],
    }),
)
