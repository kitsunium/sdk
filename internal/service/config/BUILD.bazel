load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "config",
    srcs = [
        "env_source.go",
        "file_source.go",
        "load.go",
        "merge.go",
        "poll_watcher.go",
        "wrap.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/config",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/codec",
        "//internal/core/config",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":config",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "config_test",
    srcs = ["config_external_test.go"],
    deps = [
        ":config",
        "//internal/core/config",
        "//internal/kernel/errs",
        "//internal/service/codec/json",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
