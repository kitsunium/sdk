load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "goruntime",
    srcs = [
        "doc.go",
        "runtime.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/observe/metrics/goruntime",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = ["//internal/core/observe/metrics"],
)

alias(
    name = "go_default_library",
    actual = ":goruntime",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "goruntime_test",
    srcs = [
        "gen_api_test.go",
        "runtime_external_test.go",
    ],
    deps = [
        ":goruntime",
        "//internal/core/observe/metrics",
        "//internal/service/observe/metrics",
    ],
)
