load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "otlp",
    srcs = [
        "any_value.go",
        "http_config.go",
        "key_value.go",
        "marshal.go",
        "otlp.go",
        "resource_message.go",
        "response.go",
        "scalar.go",
        "scope_message.go",
        "sender.go",
        "signal_spec.go",
        "stream.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/observe/internal/otlp",
    visibility = [
        "//internal/service:service_consumers",
        "//internal/service/observe:__subpackages__",
    ],
    deps = [
        "//internal/core/observe/otel",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":otlp",
    visibility = [
        "//internal/service:service_consumers",
        "//internal/service/observe:__subpackages__",
    ],
)

go_test(
    name = "otlp_test",
    srcs = [
        "api_gen_test.go",
        "marshal_bench_test.go",
        "sender_external_test.go",
        "wire_external_test.go",
    ],
    deps = [
        ":otlp",
        "//internal/core/observe/otel",
        "//internal/kernel/errs",
    ],
)
