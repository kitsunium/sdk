load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "async",
    srcs = [
        "async_sink.go",
        "async_sink_policy.go",
        "config.go",
        "drainer.go",
        "entry.go",
        "runtime.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/observe/logger/middleware/async",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/middleware/async",
        "//internal/kernel/collections/ring",
        "//internal/kernel/concur/recycler",
        "//internal/kernel/concur/worker",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":async",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "async_test",
    srcs = [
        "async_sink_external_test.go",
        "async_sink_internal_test.go",
        "drainer_internal_test.go",
        "entry_internal_test.go",
        "runtime_internal_test.go",
    ],
    embed = [":async"],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/level",
        "//internal/core/observe/logger/middleware/async",
        "//internal/kernel/concur/recycler",
        "//internal/kernel/concur/worker",
        "//internal/kernel/errs",
        "//internal/service/observe/logger/sink/console",
    ],
)
