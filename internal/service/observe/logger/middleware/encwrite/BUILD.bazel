        "encwrite_external_test.go",
        "encwrite_internal_test.go",
        "frame_overflow_internal_test.go",
    ],
    embed = [":encwrite"],
    deps = [
        "//internal/core/crypto",
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/middleware/encwrite",
