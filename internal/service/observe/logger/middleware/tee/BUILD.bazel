load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "tee",
    srcs = [
        "decl_gen.go",
        "doc.go",
        "tee.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/observe/logger/middleware/tee",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/middleware/tee",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":tee",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "tee_test",
    srcs = [
        "api_gen_test.go",
        "tee_external_test.go",
        "tee_internal_test.go",
    ],
    embed = [":tee"],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/middleware/tee",
        "//internal/kernel/errs",
    ],
)
