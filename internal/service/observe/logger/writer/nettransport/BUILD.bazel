load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "nettransport",
    srcs = [
        "client.go",
        "config.go",
        "decode.go",
        "doc.go",
        "netsink.go",
        "nettransport.go",
        "wrap.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/observe/logger/writer/nettransport",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/level",
        "//internal/core/observe/logger/writer",
        "//internal/core/observe/logger/writer/nettransport",
        "//internal/kernel/errs",
        "//internal/service/observe/logger/middleware/async",
        "//internal/service/observe/logger/writer/levelgate",
    ],
)

alias(
    name = "go_default_library",
    actual = ":nettransport",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "nettransport_test",
    srcs = [
        "api_gen_test.go",
        "client_internal_test.go",
        "config_external_test.go",
        "config_internal_test.go",
        "decode_internal_test.go",
        "netsink_bench_test.go",
        "netsink_internal_test.go",
        "nettransport_external_test.go",
        "nettransport_internal_test.go",
        "wrap_internal_test.go",
    ],
    embed = [":nettransport"],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/level",
        "//internal/core/observe/logger/writer",
        "//internal/core/observe/logger/writer/nettransport",
        "//internal/kernel/errs",
    ],
)

