load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "otlpjson",
    srcs = [
        "doc.go",
        "encode.go",
        "exporter.go",
        "sink.go",
        "sink_compliance.go",
        "writer.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/observe/logger/writer/otlpjson",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/level",
        "//internal/core/observe/logger/writer",
        "//internal/core/observe/logger/writer/otlpjson",
        "//internal/core/observe/otel",
        "//internal/kernel/errs",
        "//internal/service/observe/internal/otlp",
        "//internal/service/observe/logger/middleware/async",
        "//internal/service/observe/logger/writer/levelgate",
    ],
)

alias(
    name = "go_default_library",
    actual = ":otlpjson",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "otlpjson_test",
    srcs = [
        "encode_external_test.go",
        "gen_api_test.go",
        "sink_bench_test.go",
    ],
    embed = [":otlpjson"],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/level",
        "//internal/core/observe/logger/writer",
        "//internal/core/observe/otel",
        "//internal/kernel/errs",
    ],
)
