load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "memory",
    srcs = [
        "decl_gen.go",
        "doc.go",
        "memory.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/observe/logger/sink/memory",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/observe/logger",
    ],
)

alias(
    name = "go_default_library",
    actual = ":memory",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "memory_test",
    srcs = [
        "api_gen_test.go",
        "memory_external_test.go",
        "memory_internal_test.go",
    ],
    embed = [":memory"],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/level",
    ],
)
