load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "cache",
    srcs = [
        "cache_compliance.go",
        "chain.go",
        "chain_config.go",
        "codes.go",
        "config.go",
        "errors.go",
        "memory.go",
        "record.go",
        "refuse.go",
        "tagindex.go",
        "tier.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/cache",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/cache",
        "//internal/kernel/cache",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/kernel/singleflight",
    ],
)

alias(
    name = "go_default_library",
    actual = ":cache",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "cache_test",
    size = "small",
    srcs = [
        "cache_bench_test.go",
        "chain_external_test.go",
        "memory_external_test.go",
        "memory_internal_test.go",
    ],
    embed = [":cache"],
    deps = [
        "//internal/core/cache",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
