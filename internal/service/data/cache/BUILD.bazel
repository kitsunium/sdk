load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "cache",
    srcs = [
        "cache_compliance.go",
        "chain.go",
        "chain_config.go",
        "config.go",
        "memory.go",
        "record.go",
        "refuse.go",
        "tagindex.go",
        "tier.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/data/cache",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/data/cache",
        "//internal/kernel/clock",
        "//internal/kernel/collections/cache",
        "//internal/kernel/concur/singleflight",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":cache",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "cache_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "cache_bench_test.go",
        "chain_external_test.go",
        "memory_external_test.go",
        "memory_internal_test.go",
    ],
    embed = [":cache"],
    deps = [
        "//internal/core/data/cache",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)
