load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "sql",
    srcs = [
        "config.go",
        "dialect_sql.go",
        "doc.go",
        "executor.go",
        "health.go",
        "join.go",
        "migrate.go",
        "migrate_config.go",
        "migrate_filelock.go",
        "migrate_lock.go",
        "migrate_plan.go",
        "migrate_table.go",
        "resolved.go",
        "savepoint_stmts.go",
        "scope_key_type.go",
        "sql.go",
        "statements.go",
        "tx.go",
        "txscope.go",
        "txstate.go",
        "withheld.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/data/sql",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/data/sql",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":sql",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "sql_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "config_external_test.go",
        "harness_external_test.go",
        "health_external_test.go",
        "join_external_test.go",
        "migrate_external_test.go",
        "migrate_filelock_external_test.go",
        "nosleep_external_test.go",
        "sql_bench_test.go",
        "tx_external_test.go",
        "txcancel_external_test.go",
        "withheld_external_test.go",
    ],
    # keep: TestPackageNeverWaitsOnTheWallClock parses this package's own .go
    # files at runtime. Bazel's sandbox strips the source-tree relationship, so
    # the sources have to reach the test as runfiles — :audit_srcs ships them,
    # and //:audit_sources the go.work that roots the tree, the same mechanism
    # //internal/kernel/errs uses for its AST audits. The package declares no
    # code since ADR 0160, so //:audit_sources no longer lists it.
    data = [
        ":audit_srcs",
        "//:audit_sources",
    ],
    deps = [
        ":sql",
        "//internal/core/data/sql",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to its own wall-clock audit
# (nosleep_external_test.go), which reads them at runtime.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
)
