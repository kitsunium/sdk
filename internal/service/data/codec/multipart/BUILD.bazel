load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "multipart",
    srcs = [
        "boundary.go",
        "codec.go",
        "counter.go",
        "decoder.go",
        "disposition.go",
        "encoder.go",
        "form.go",
        "limits.go",
        "multipart_compliance.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/data/codec/multipart",
    visibility = ["//internal/service:service_consumers"],
    deps = [
        "//internal/core/data/codec",
        "//internal/core/data/codec/multipart",
        "//internal/core/data/codec/scratch",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":multipart",
    visibility = ["//internal/service:service_consumers"],
)

go_test(
    name = "multipart_test",
    size = "small",
    srcs = [
        "boundary_internal_test.go",
        "codec_external_test.go",
        "decoder_internal_test.go",
        "encoder_internal_test.go",
        "limits_internal_test.go",
        "multipart_bench_test.go",
    ],
    embed = [":multipart"],
    deps = [
        "//internal/core/data/codec",
        "//internal/core/data/codec/multipart",
        "//internal/kernel/errs",
    ],
)
