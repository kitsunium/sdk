load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "baseenc",
    srcs = [
        "base45.go",
        "base58.go",
        "base62.go",
        "base_convert.go",
        "buffering_writer.go",
        "codec.go",
        "decode_all_reader.go",
        "decoder.go",
        "encoder.go",
        "helpers.go",
        "spec.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/data/codec/baseenc",
    visibility = ["//internal/service:service_consumers"],
    deps = [
        "//internal/core/data/codec",
        "//internal/core/data/codec/baseenc",
        "//internal/core/data/codec/scratch",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":baseenc",
    visibility = ["//internal/service:service_consumers"],
)

go_test(
    name = "baseenc_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "base45_internal_test.go",
        "base_convert_internal_test.go",
        "baseenc_bench_test.go",
        "buffering_writer_internal_test.go",
        "codec_external_test.go",
        "codec_integration_test.go",
        "codec_internal_test.go",
        "decode_all_reader_internal_test.go",
        "decoder_internal_test.go",
        "encoder_internal_test.go",
        "fuzz_internal_test.go",
        "helpers_internal_test.go",
        "spec_internal_test.go",
    ],
    embed = [":baseenc"],
    deps = [
        "//internal/core/data/codec",
        "//internal/core/data/codec/baseenc",
        "//internal/core/data/codec/scratch",
        "//internal/kernel/errs",
    ],
)
