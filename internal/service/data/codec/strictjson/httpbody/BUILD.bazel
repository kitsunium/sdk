load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "httpbody",
    srcs = ["httpbody.go"],
    importpath = "github.com/kitsunium/sdk/internal/service/data/codec/strictjson/httpbody",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/data/codec/strictjson",
        "//internal/service/data/codec/strictjson",
