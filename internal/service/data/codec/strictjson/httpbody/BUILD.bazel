    name = "go_default_library",
    actual = ":httpbody",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "httpbody_test",
    srcs = [
        "api_gen_test.go",
        "httpbody_external_test.go",
    ],
    deps = [
        ":httpbody",
        "//internal/core/data/codec/strictjson",
        "//internal/kernel/errs",
    ],
