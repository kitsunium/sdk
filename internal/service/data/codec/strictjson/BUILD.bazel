load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "strictjson",
    srcs = [
        "doc.go",
        "reader.go",
        "strictjson.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/data/codec/strictjson",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/data/codec/strictjson",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":strictjson",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "strictjson_test",
    srcs = [
        "api_gen_test.go",
        "strictjson_external_test.go",
        "strictjson_internal_test.go",
    ],
    embed = [":strictjson"],
    deps = [
        "//internal/core/data/codec/strictjson",
        "//internal/kernel/errs",
    ],
)
