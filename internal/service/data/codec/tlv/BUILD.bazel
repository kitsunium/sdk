load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "tlv",
    srcs = [
        "codec.go",
        "decoder.go",
        "decoder_typed.go",
        "doc.go",
        "encoder.go",
        "helpers.go",
        "typeinfo.go",
        "types.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/data/codec/tlv",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/data/codec",
        "//internal/core/data/codec/scratch",
        "//internal/core/data/codec/tlv",
        "//internal/kernel/concur/recycler",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":tlv",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "tlv_test",
    srcs = [
        "api_gen_test.go",
        "codec_external_test.go",
        "codec_integration_test.go",
        "codec_internal_test.go",
        "decoder_internal_test.go",
        "decoder_typed_internal_test.go",
        "encoder_internal_test.go",
        "fuzz_external_test.go",
        "helpers_internal_test.go",
        "tlv_bench_test.go",
        "typeinfo_internal_test.go",
        "types_internal_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":tlv"],
    deps = [
        "//internal/core/data/codec",
        "//internal/core/data/codec/scratch",
        "//internal/kernel/errs",
    ],
)
