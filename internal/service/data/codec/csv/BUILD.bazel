load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "csv",
    srcs = [
        "codec.go",
        "decoder.go",
        "doc.go",
        "encode.go",
        "encoder.go",
        "schema.go",
        "typed.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/data/codec/csv",
    visibility = ["//internal/service:service_consumers"],
    deps = [
        "//internal/core/data/codec",
        "//internal/core/data/codec/csv",
        "//internal/core/data/codec/scratch",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":csv",
    visibility = ["//internal/service:service_consumers"],
)

go_test(
    name = "csv_test",
    size = "small",
    srcs = [
        "append_bench_test.go",
        "append_external_test.go",
        "append_fixtures_external_test.go",
        "append_integration_test.go",
        "codec_external_test.go",
        "codec_integration_test.go",
        "codec_internal_test.go",
        "encode_internal_test.go",
        "fuzz_external_test.go",
        "gen_api_test.go",
        "sizing_integration_test.go",
        "typed_bench_test.go",
        "typed_external_test.go",
    ],
    embed = [":csv"],
    deps = [
        "//internal/core/data/codec",
        "//internal/core/data/codec/csv",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to //internal/core/data/codec's
# registration-order audit (supervizio/agent#305). The package declares no error
# code; it is listed because that test reads its sources at runtime, and under
# Bazel they reach it only as those runfiles.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
