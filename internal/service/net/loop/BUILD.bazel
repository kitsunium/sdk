    ],
)

# The suite runs under the loopdebug build tag (the thread check compiled in)
# and with the backends it must find compiled in, failing closed on Linux
# (ADR 0186): a backend missing on a lane fails the target. This lane asks for
# epoll alone and no capability: Bazel runs on the hosted runner, whose
# kernel's io_uring this repository does not control, and the required check
# must not hang on it. e2e-cross's linux-init lanes, on kernels they pin,
# require iouring,epoll; net-kernel-gate's legs declare both lists each.
go_test(
    name = "loop_test",
    srcs = [
        "batch_cost_internal_test.go",
        "conformance_caps_linux_test.go",
        "conformance_caps_uring_linux_test.go",
        "conformance_linux_test.go",
        "conformance_uring_linux_test.go",
        "core_internal_test.go",
        "gen_api_test.go",
        "memory_linux_test.go",
        "parts_internal_test.go",
        "uring_abi_linux_internal_test.go",
    ],
    embed = [":loop"],
    gotags = ["loopdebug"],  # keep
    # keep
    x_defs = {
        "github.com/kitsunium/sdk/internal/service/net/loop.requiredBackends": "epoll",
        "github.com/kitsunium/sdk/internal/service/net/loop.requiredCaps": "none",
    },
    deps = [
        "//internal/core/net",
        "//internal/kernel/errs",
    ],
)

# The idle-connection memory budget (memory_linux_test.go, //go:build !race),
# its own target so the race-off lane (tools/alloc-lane-targets.txt) runs it
# by name; under race it compiles to nothing it runs.
# keep
go_test(
    name = "loop_memory_test",
    srcs = [
        "conformance_linux_test.go",
        "memory_linux_test.go",
    ],
    args = ["-test.run=^TestMemory_"],
    embed = [":loop"],
    x_defs = {
        "github.com/kitsunium/sdk/internal/service/net/loop.requiredBackends": "epoll",
        "github.com/kitsunium/sdk/internal/service/net/loop.requiredCaps": "none",
    },
    deps = [
        "//internal/core/net",
    ],
)
