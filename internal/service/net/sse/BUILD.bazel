load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "sse",
    srcs = [
        "decl_gen.go",
        "doc.go",
        "frame.go",
        "options.go",
        "sse.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/net/sse",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/net",
        "//internal/kernel/clock",
        "//internal/kernel/concur/worker",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":sse",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "sse_test",
    srcs = [
        "api_gen_test.go",
        "frame_bench_test.go",
        "frame_external_test.go",
        "sse_alloc_internal_test.go",
        "sse_bench_test.go",
        "sse_external_test.go",
        "sse_internal_test.go",
    ],
    embed = [":sse"],
    deps = [
        "//internal/core/net",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)
