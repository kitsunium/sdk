load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "sse",
    srcs = [
        "doc.go",
        "frame.go",
        "gen_ports.go",
        "loop.go",
        "options.go",
        "sse.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/net/sse",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/net",
        "//internal/kernel/clock",
        "//internal/kernel/concur/worker",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":sse",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "sse_test",
    srcs = [
        "allocwindow_test.go",
        "frame_bench_test.go",
        "frame_external_test.go",
        "gen_api_test.go",
        "gen_perf_test.go",
        "loop_bench_test.go",
        "loop_engine_linux_test.go",
        "loop_external_test.go",
        "loop_memory_linux_test.go",
        "perf_fixtures_test.go",
        "sse_alloc_internal_test.go",
        "sse_bench_test.go",
        "sse_external_test.go",
        "sse_internal_test.go",
    ],
    embed = [":sse"],
    deps = [
        "//internal/core/net",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/net/http1",
    ] + select({
        "@rules_go//go/platform:android": [
            "//internal/service/net/server",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/service/net/server",
        ],
        "//conditions:default": [],
    }),
)
