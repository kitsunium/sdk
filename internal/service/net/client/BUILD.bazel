load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "client",
    srcs = [
        "capped_body.go",
        "client.go",
        "conjunction.go",
        "defaults.go",
        "deny_policy.go",
        "guard.go",
        "method_policy.go",
        "path.go",
        "path_policy.go",
        "policies.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/net/client",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/net",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":client",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "client_test",
    srcs = [
        "capped_body_internal_test.go",
        "client_alloc_internal_test.go",
        "client_bench_test.go",
        "client_external_test.go",
        "client_internal_test.go",
        "conjunction_internal_test.go",
        "defaults_internal_test.go",
        "deny_policy_internal_test.go",
        "guard_internal_test.go",
        "method_policy_internal_test.go",
        "path_equivalence_internal_test.go",
        "path_internal_test.go",
        "path_policy_internal_test.go",
        "policies_external_test.go",
        "policies_internal_test.go",
    ],
    embed = [":client"],
    deps = [
        "//internal/core/net",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
