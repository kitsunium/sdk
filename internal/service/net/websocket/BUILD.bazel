load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "websocket",
    srcs = [
        "close.go",
        "decl_gen.go",
        "doc.go",
        "frame.go",
        "handshake.go",
        "handshake_key.go",
        "options.go",
        "text.go",
        "websocket.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/net/websocket",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/net",
        "//internal/kernel/clock",
        "//internal/kernel/concur/worker",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":websocket",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "websocket_test",
    srcs = [
        "api_gen_test.go",
        "frame_bench_test.go",
        "frame_fuzz_external_test.go",
        "frame_mask_external_test.go",
        "options_internal_test.go",
        "websocket_alloc_internal_test.go",
        "websocket_bench_test.go",
        "websocket_external_test.go",
        "websocket_internal_test.go",
        "wire_external_test.go",
    ],
    embed = [":websocket"],
    deps = [
        "//internal/core/net",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)
