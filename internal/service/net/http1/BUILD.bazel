load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "http1",
    srcs = [
        "chain.go",
        "doc.go",
        "file_body.go",
        "files.go",
        "files_compliance.go",
        "lanes.go",
        "loop.go",
        "loop_body.go",
        "loop_pending.go",
        "parse.go",
        "ratelimit.go",
        "refusal.go",
        "stream.go",
        "target.go",
        "write.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/net/http1",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/net",
        "//internal/core/observe/trace",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/kernel/swar",
        "//internal/service/net/static",
    ],
)

alias(
    name = "go_default_library",
    actual = ":http1",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "http1_test",
    srcs = [
        "access_external_test.go",
        "chain_external_test.go",
        "corpus_external_test.go",
        "cors_external_test.go",
        "files_external_test.go",
        "fuzz_external_test.go",
        "gen_api_test.go",
        "gen_perf_test.go",
        "http1_bench_test.go",
        "loop_body_alloc_external_test.go",
        "loop_body_external_test.go",
        "loop_external_test.go",
        "loop_fixtures_test.go",
        "loop_pending_alloc_external_test.go",
        "loop_pending_external_test.go",
        "perf_fixtures_test.go",
        "ratelimit_external_test.go",
        "requestid_external_test.go",
        "stream_external_test.go",
        "target_external_test.go",
        "trace_alloc_external_test.go",
        "trace_external_test.go",
        "write_external_test.go",
    ],
    data = glob(["testdata/**"]),
    deps = [
        ":http1",
        "//internal/core/net",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/net/server",
        "//internal/service/net/static",
