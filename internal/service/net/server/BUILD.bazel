    # TestCapabilityRegistry_matchesTheDesign reads design/net.yaml.
    data = glob(["*.go"]) + [
        "//:design/net.yaml",
        "//pkg/v1/net/server:gen_facade.go",
    ],
    embed = [":server"],
    # keep: these tests bind a loopback socket. Bazel's linux-sandbox gives the
    # action its own network namespace, so bind and dial fail inside it. Running
    # the test locally is the only mechanism that restores a usable loopback;
    # the `requires-network` tag alone does not (measured, both ways).
    local = True,
    # The suite outgrew .bazelrc's 60 s on the hosted runner (TIMEOUT in 60.2 s,
    # #1338 and #1345's first runs): four shards, each with its own budget, as
    # loop_test. The children a test re-runs by name drop the shard variables
    # (unsharded), or they would find their test in another shard's share.
    shard_count = 4,
    deps = [
