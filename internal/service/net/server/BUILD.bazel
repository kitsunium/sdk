load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "server",
    srcs = [
        "adopt.go",
        "batch.go",
        "batch_compliance.go",
        "batch_portable.go",
        "conn.go",
        "conn_compliance.go",
        "datagram_source_linux.go",
        "datagram_source_other.go",
        "http_adapter.go",
        "http_listener.go",
        "kernel_len_linux.go",
        "lifecycle.go",
        "linux_compliance.go",
        "listen.go",
        "multireader_linux.go",
        "multireader_mmsghdr_linux.go",
        "options.go",
        "packet.go",
        "packet_group.go",
        "packet_listen.go",
        "packet_loop.go",
        "pool.go",
        "raw_conn_provider_linux.go",
        "reuseport_bsd.go",
        "reuseport_linux.go",
        "reuseport_other.go",
        "server.go",
        "sockaddr_linux.go",
        "stream_group.go",
        "stream_group_limiter.go",
        "swallow.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/net/server",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/net",
        "//internal/core/resilience",
        "//internal/kernel/buffer",
        "//internal/kernel/errs",
        "//internal/kernel/recycler",
        "//internal/kernel/worker",
        "//internal/service/proc/sdlisten",
        "//internal/service/resilience",
    ],
)

alias(
    name = "go_default_library",
    actual = ":server",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "server_test",
    srcs = [
        "adopt_external_test.go",
        "batch_bench_test.go",
        "batch_internal_test.go",
        "kernel_len_internal_test.go",
        "limiter_external_test.go",
        "packet_external_test.go",
        "server_bench_test.go",
        "server_external_test.go",
        "shards_external_test.go",
        "shards_internal_test.go",
    ],
    embed = [":server"],
    # keep: these tests bind a loopback socket. Bazel's linux-sandbox gives the
    # action its own network namespace, so bind and dial fail inside it. Running
    # the test locally is the only mechanism that restores a usable loopback;
    # the `requires-network` tag alone does not (measured, both ways).
    local = True,
    deps = [
        "//internal/core/net",
        "//internal/kernel/errs",
    ],
)
