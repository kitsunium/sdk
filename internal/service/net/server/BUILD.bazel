        "server_bench_test.go",
        "server_external_test.go",
        "server_internal_test.go",
        "sockaddr_linux_internal_test.go",
        "stall_internal_test.go",
        "stream_group_external_test.go",
        "stream_group_internal_test.go",
        "stream_group_limiter_internal_test.go",
        "swallow_internal_test.go",
        "testsockets_external_test.go",
        "testsockets_internal_test.go",
        "testsockets_other_internal_test.go",
        "testsockets_unix_internal_test.go",
        "truncation_windows_internal_test.go",
    ],
    # keep: TestGroupOption_recordsItsKind reads pkg/v1/net/server's facade
    # and this package's own sources, from the package directory;
    # TestCapabilityRegistry_matchesTheDesign reads design/net.yaml.
    data = glob(["*.go"]) + [
        "//:design/net.yaml",
        "//pkg/v1/net/server:gen_facade.go",
    ],
    embed = [":server"],
    # keep: these tests bind a loopback socket. Bazel's linux-sandbox gives the
    # action its own network namespace, so bind and dial fail inside it. Running
    # the test locally is the only mechanism that restores a usable loopback;
    # the `requires-network` tag alone does not (measured, both ways).
    local = True,
    deps = [
        "//internal/core/app/health",
        "//internal/core/net",
        "//internal/core/proc",
        "//internal/kernel/clock",
        "//internal/kernel/concur/worker",
        "//internal/kernel/errs",
        "//internal/service/net/http1",
    ],
)
