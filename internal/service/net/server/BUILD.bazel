load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "server",
    srcs = [
        "batch.go",
        "batch_compliance.go",
        "batch_portable.go",
        "conn.go",
        "conn_compliance.go",
        "datagram_source_linux.go",
        "datagram_source_other.go",
        "http_adapter.go",
        "http_listener.go",
        "lifecycle.go",
        "linux_compliance.go",
        "listen.go",
        "multireader_linux.go",
        "multireader_mmsghdr_linux.go",
        "options.go",
        "packet.go",
        "packet_group.go",
        "packet_listen.go",
        "packet_loop.go",
        "pool.go",
        "raw_conn_provider_linux.go",
        "reuseport_bsd.go",
        "reuseport_linux.go",
        "reuseport_other.go",
        "server.go",
        "sockaddr_linux.go",
        "stream_group.go",
        "swallow.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/net/server",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/net",
        "//internal/kernel/buffer",
        "//internal/kernel/errs",
        "//internal/kernel/recycler",
        "//internal/kernel/worker",
    ],
)

alias(
    name = "go_default_library",
    actual = ":server",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "server_test",
    srcs = [
        "batch_bench_test.go",
        "batch_internal_test.go",
        "packet_external_test.go",
        "server_bench_test.go",
        "server_external_test.go",
        "shards_external_test.go",
        "shards_internal_test.go",
    ],
    embed = [":server"],
    deps = [
        "//internal/core/net",
        "//internal/kernel/errs",
    ],
)
