load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "secret",
    srcs = [
        "doc.go",
        "env.go",
        "file.go",
        "file_config.go",
        "file_record.go",
        "fileguard_other.go",
        "fileguard_unix.go",
        "keyfile.go",
        "keyring.go",
        "keyring_view.go",
        "memory.go",
        "rotator.go",
        "subjectbox.go",
        "subjectcache.go",
        "subjectkeys.go",
        "subjectmemory.go",
        "subjectrewrap.go",
        "versions.go",
        "wrap.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/security/secret",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/app/lock",
        "//internal/core/crypto",
        "//internal/core/data/vfs",
        "//internal/core/proc",
        "//internal/core/security/secret",
