load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "redact",
    srcs = [
        "attrs.go",
        "fields.go",
        "json.go",
        "plan.go",
        "redact.go",
        "redact_compliance.go",
        "text.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/security/redact",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/security/redact",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":redact",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "redact_test",
    srcs = [
        "api_gen_test.go",
        "attrs_external_test.go",
        "redact_external_test.go",
        "redact_internal_test.go",
    ],
    embed = [":redact"],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/security/redact",
        "//internal/kernel/errs",
    ],
)
