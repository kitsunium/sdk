load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "metrics",
    srcs = [
        "carved.go",
        "codes.go",
        "config.go",
        "errors.go",
        "exporter_otlphttp.go",
        "exporter_otlpjson.go",
        "exporter_prometheus.go",
        "exporter_text.go",
        "gauge.go",
        "histogram.go",
        "meter.go",
        "meter_observable.go",
        "name_state.go",
        "otlp_export_response.go",
        "otlp_request.go",
        "otlphttp_config.go",
        "series.go",
        "series_entry.go",
        "series_store.go",
        "sum.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/metrics",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/metrics",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":metrics",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "metrics_test",
    srcs = [
        "cardinality_external_test.go",
        "exporter_otlphttp_external_test.go",
        "exporter_otlpjson_external_test.go",
        "exporter_prometheus_external_test.go",
        "exporter_prometheus_internal_test.go",
        "exporter_text_external_test.go",
        "exporter_text_internal_test.go",
        "gauge_internal_test.go",
        "histogram_internal_test.go",
        "meter_alloc_test.go",
        "meter_bench_test.go",
        "meter_external_test.go",
        "meter_internal_test.go",
        "name_state_internal_test.go",
        "observable_external_test.go",
        "series_internal_test.go",
        "sum_internal_test.go",
    ],
    embed = [":metrics"],
    deps = [
        "//internal/core/metrics",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
