load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "id",
    srcs = [
        "codes.go",
        "common.go",
        "errors.go",
        "ksuid.go",
        "nanoid.go",
        "snowflake.go",
        "typeid.go",
        "ulid.go",
        "uuidv4.go",
        "uuidv7.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/id",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/id",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":id",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "id_test",
    srcs = [
        "common_internal_test.go",
        "ksuid_external_test.go",
        "ksuid_internal_test.go",
        "nanoid_external_test.go",
        "nanoid_internal_test.go",
        "snowflake_external_test.go",
        "snowflake_internal_test.go",
        "typeid_external_test.go",
        "typeid_internal_test.go",
        "ulid_external_test.go",
        "ulid_internal_test.go",
        "uuidv4_external_test.go",
        "uuidv4_internal_test.go",
        "uuidv7_external_test.go",
        "uuidv7_internal_test.go",
    ],
    embed = [":id"],
    deps = [
        "//internal/core/id",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
