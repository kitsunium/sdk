load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "mail",
    srcs = [
        "address.go",
        "attachment.go",
        "compose.go",
        "composer.go",
        "composer_config.go",
        "composition.go",
        "doc.go",
        "entity.go",
        "envelope.go",
        "errors.go",
        "header.go",
        "headerwrite.go",
        "line_wrapper.go",
        "memory.go",
        "session.go",
        "smtp.go",
        "smtp_compliance.go",
        "smtpconfig.go",
        "smtpconfig_render.go",
        "smtpurl.go",
        "validate.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/app/mail",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/app/mail",
        "//internal/core/net",
        "//internal/core/security/secret",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":mail",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "mail_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "compose_bench_test.go",
        "compose_external_test.go",
        "fakesmtp_external_test.go",
        "header_external_test.go",
        "memory_external_test.go",
        "smtp_external_test.go",
        "smtpconfig_render_external_test.go",
        "smtpurl_external_test.go",
        "validate_external_test.go",
    ],
    deps = [
        ":mail",
        "//internal/core/app/mail",
        "//internal/core/net",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)
