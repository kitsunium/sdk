load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "raft",
    srcs = [
        "debug.go",
        "doc.go",
        "leader.go",
        "leaderrecord.go",
        "log.go",
        "mutation.go",
        "peerstat.go",
        "progress.go",
        "raft.go",
        "step.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/app/consensus/raft",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/app/consensus",
        "//internal/kernel/errs",
        "//internal/service/app/consensus/wire",
    ],
)

alias(
    name = "go_default_library",
    actual = ":raft",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "raft_test",
    srcs = [
        "admissionat_internal_test.go",
        "chainrefusal_internal_test.go",
        "checks_internal_test.go",
        "compactbase_internal_test.go",
        "deniedvoucher_internal_test.go",
        "denypin_internal_test.go",
        "gen_api_test.go",
        "leaderrecord_internal_test.go",
        "lincheck_internal_test.go",
        "matchbound_internal_test.go",
        "membershippub_internal_test.go",
        "notable_heartbeat_internal_test.go",
        "origin_internal_test.go",
        "protocol2_internal_test.go",
        "readresp_internal_test.go",
        "removestrands_internal_test.go",
        "silentreplicate_internal_test.go",
        "sim_internal_test.go",
        "sim_scenarios_internal_test.go",
        "slowack_internal_test.go",
        "soak_internal_test.go",
        "staletail_internal_test.go",
        "strictsilent_internal_test.go",
        "timing_internal_test.go",
        "transferissuer_internal_test.go",
        "transit_internal_test.go",
        "truncatedsilence_internal_test.go",
        "unadmittedpromote_internal_test.go",
        "unansweredvoter_internal_test.go",
        "unapplied_internal_test.go",
        "unappliedstart_internal_test.go",
        "uniquekey_internal_test.go",
        "unlistedleader_internal_test.go",
        "unreachedleader_internal_test.go",
        "unreachedtail_internal_test.go",
        "updatelimit_internal_test.go",
        "upgrade_internal_test.go",
        "votewindowraise_internal_test.go",
        "voucheraddress_internal_test.go",
        "wholelogsilence_internal_test.go",
        "wirebatch_internal_test.go",
    ],
    embed = [":raft"],
    # The deterministic simulations take ~300 CPU-seconds under race and
    # coverage, and .bazelrc caps every target at 60 s (#126). rules_go
    # deals TOP-LEVEL tests to shards by index modulo the count, so the two
    # 60-seed suites are twelve top-level tests each and the 30-seed one
    # three (seedPart), every seed loop runs its seeds as parallel subtests
    # (eachSeed), and 26 shards hold each shard near 20 CPU-seconds: at
    # eight, two shards of ~55 overran 60 s on CI (#304). At 26 the
    # fourth shard held both TestChecksPassUnmutated and
    # TestLinearizableUnderFaults, about 17 CPU-seconds each under race,
    # and overran 60 s under coverage on main; 27 deals them apart.
    shard_count = 27,
    deps = [
        "//internal/core/app/consensus",
        "//internal/kernel/errs",
        "//internal/service/app/consensus/wire",
    ],
)
