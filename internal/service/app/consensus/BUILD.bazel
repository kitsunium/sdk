        "boot_darwin.go",
        "boot_other.go",
        "bootstrap.go",
        "config.go",
        "datadir.go",
        "errors.go",
        "filelog.go",
        "filesnap.go",
        "memlog.go",
        "memsnap.go",
        "memtransport.go",
        "node.go",
        "observe.go",
        "offline.go",
        "ops.go",
        "pem.go",
        "queue.go",
        "snapcodec.go",
        "snapshot.go",
        "sync_linux.go",
        "sync_other.go",
        "tcp.go",
