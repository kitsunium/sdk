# The allocation gates of the range read (filelog_alloc_internal_test.go,
# #913), of the receive path (receive_alloc_internal_test.go, #1110), of
# the leader turn (sendshared_alloc_internal_test.go, #912) and of applied1
# (applied_alloc_internal_test.go, #1109), all //go:build !race, in their own
# target so the race-off lane
# (tools/alloc-lane-targets.txt) runs the gates and the window's negative
# control, not the whole suite; under race it compiles to nothing it runs.
# keep
go_test(
    name = "consensus_alloc_test",
    srcs = [
        "allocwindow_test.go",
        "applied_alloc_internal_test.go",
        "appliedwait_internal_test.go",
        "filelog_alloc_internal_test.go",
        "receive_alloc_internal_test.go",
        "sendshared_alloc_internal_test.go",
        "sendshared_internal_test.go",
    ],
    args = ["-test.run=^(TestEntriesOfASyncedRunAllocateTheBufferAndTheSlice|TestACompactionThroughASegmentBoundaryCopiesNoEntries|TestAFollowerStepKeepsTheFramesPayloads|TestALeaderTurnEncodesItsEntriesOnceWhateverItsFollowers|TestApplied1KeepsAResultWithoutAllocating|TestAllocWindowCountsARealAllocation)$$"],
    embed = [":consensus"],
    deps = [
        "//internal/core/app/consensus",
        "//internal/kernel/fs/flock",
        "//internal/service/app/consensus/raft",
        "//internal/service/app/consensus/wire",
    ],
)

# The hand-run bench lane (#911): `make bench-consensus` runs
# `bazel run` on it with -test.run=TestGenerateBenchMD, which writes BENCH.md
# under $BUILD_WORKSPACE_DIRECTORY. `manual` keeps it out of
# `bazel test //...`; race off, as the alloc lane, because the numbers are
# the engine's and not the race detector's. The file uses the package's
# production code alone, so it is its only source.
go_test(
    name = "consensus_bench_test",
    size = "enormous",
    timeout = "eternal",
    srcs = ["consensus_bench_test.go"],
    args = ["-test.run=^$$"],
    embed = [":consensus"],
    race = "off",
    tags = [
        "benchmark",
        "manual",
    ],
    deps = [
        "//internal/core/app/consensus",
        "//internal/kernel/errs",
        "//internal/service/app/consensus/wire",
    ],
)
