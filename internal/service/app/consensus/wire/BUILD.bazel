load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "wire",
    srcs = [
        "admin.go",
        "codec.go",
        "doc.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/app/consensus/wire",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/app/consensus",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":wire",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "wire_test",
    srcs = [
        "export_test.go",
        "fuzz_external_test.go",
        "gen_api_test.go",
        "metav2_external_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":wire"],
    deps = [
        "//internal/core/app/consensus",
    ],
)
