load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "scheduler",
    srcs = [
        "config.go",
        "cron.go",
        "cursor.go",
        "doc.go",
        "entry.go",
        "every.go",
        "field_spec.go",
        "reject.go",
        "run.go",
        "scheduler.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/app/scheduler",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/app/scheduler",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":scheduler",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "scheduler_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "config_external_test.go",
        "cron_dst_external_test.go",
        "cron_external_test.go",
        "nosleep_external_test.go",
        "run_external_test.go",
    ],
    # keep: TestPackageNeverWaitsOnTheWallClock parses this package's own .go
    # files at runtime. Bazel's sandbox strips the source-tree relationship, so
    # the sources have to reach the test as runfiles — the same mechanism
    # //internal/kernel/errs uses for its AST audits.
    data = ["//:audit_sources"],
    deps = [
        ":scheduler",
        "//internal/core/app/scheduler",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files through //:audit_sources. The package
# declares no error code (ADR 0160: they are in its core mirror); it stays listed
# because this package's own test reads its sources at runtime, and under Bazel
# they reach it only as those runfiles.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
