load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "cli",
    srcs = [
        "cli.go",
        "config.go",
        "errors.go",
        "execute.go",
        "flagsource.go",
        "help.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/app/cli",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/app/cli",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":cli",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "cli_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "cli_bench_test.go",
        "execute_external_test.go",
        "flagsource_external_test.go",
        "harness_external_test.go",
        "help_external_test.go",
        "new_external_test.go",
        "noexit_external_test.go",
    ],
    # keep: TestPackageNeverEndsTheProcess parses the .go files of all three
    # cli packages at runtime. Bazel's sandbox strips the source-tree
    # relationship, so the sources have to reach the test as runfiles — the
    # same mechanism //internal/kernel/errs uses for its AST audits.
    data = ["//:audit_sources"],
    deps = [
        ":cli",
        "//internal/core/app/cli",
        "//internal/core/app/config",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files through //:audit_sources. The package
# declares no error code (ADR 0160: they are in its core mirror); it stays listed
# because this package's own test reads its sources at runtime, and under Bazel
# they reach it only as those runfiles.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
