load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "config",
    srcs = [
        "env_source.go",
        "file_source.go",
        "fs_source.go",
        "load.go",
        "merge.go",
        "origins.go",
        "poll_watcher.go",
        "schema.go",
        "schema_defaults.go",
        "schema_keys.go",
        "schema_presence.go",
        "schema_reject.go",
        "schema_source.go",
        "schema_spec.go",
        "wrap.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/app/config",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/app/config",
        "//internal/core/app/validation",
        "//internal/core/data/codec",
        "//internal/core/security/secret",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/app/validation",
    ],
)

alias(
    name = "go_default_library",
    actual = ":config",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "config_test",
    srcs = [
        "env_source_external_test.go",
        "env_source_internal_test.go",
        "file_source_external_test.go",
        "file_source_internal_test.go",
        "fs_source_external_test.go",
        "load_external_test.go",
        "load_internal_test.go",
        "merge_internal_test.go",
        "origins_external_test.go",
        "poll_watcher_external_test.go",
        "poll_watcher_internal_test.go",
        "schema_bench_test.go",
        "schema_external_test.go",
        "schema_keys_internal_test.go",
        "schema_shape_external_test.go",
        "wrap_internal_test.go",
    ],
    embed = [":config"],
    deps = [
        "//internal/core/app/config",
        "//internal/core/app/validation",
        "//internal/core/data/codec",
        "//internal/core/security/secret",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/data/codec/json",
        "//internal/service/data/codec/yaml",
    ],
)
