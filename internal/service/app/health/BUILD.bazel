load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "health",
    srcs = [
        "ask.go",
        "body.go",
        "component.go",
        "config.go",
        "entry.go",
        "handler.go",
        "handler_config.go",
        "health.go",
        "inflight.go",
        "notify.go",
        "probe.go",
        "runner.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/app/health",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/app/health",
        "//internal/core/app/lifecycle",
        "//internal/kernel/clock",
        "//internal/kernel/concur/group",
        "//internal/kernel/errs",
        "//internal/service/proc/systemd/notify",
    ],
)

alias(
    name = "go_default_library",
    actual = ":health",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "health_test",
    srcs = [
        "ask_external_test.go",
        "ask_internal_test.go",
        "component_external_test.go",
        "handler_external_test.go",
        "harness_external_test.go",
        "nosleep_external_test.go",
        "notify_bounded_external_test.go",
        "notify_external_test.go",
        "notify_linux_external_test.go",
        "probe_external_test.go",
        "runner_external_test.go",
    ],
    data = ["//:audit_sources"],
    embed = [":health"],
    deps = [
        "//internal/core/app/health",
        "//internal/core/app/lifecycle",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/app/lifecycle",
    ] + select({
        "@rules_go//go/platform:android": [
            "//internal/core/proc",
            "//internal/service/proc/systemd/notify",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/core/proc",
            "//internal/service/proc/systemd/notify",
        ],
        "//conditions:default": [],
    }),
)

# audit_srcs ships this package's .go files through //:audit_sources. The package
# declares no error code (ADR 0160: they are in its core mirror); it stays listed
# because this package's own test reads its sources at runtime, and under Bazel
# they reach it only as those runfiles.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
