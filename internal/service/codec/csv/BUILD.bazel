load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "csv",
    srcs = [
        "codec.go",
        "codes.go",
        "errors.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/codec/csv",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/codec",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":csv",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "csv_test",
    srcs = [
        "codec_external_test.go",
        "codec_internal_test.go",
    ],
    embed = [":csv"],
    deps = [
        "//internal/core/codec",
        "//internal/kernel/errs",
    ],
)
