load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "keytree",
    srcs = [
        "decl_gen.go",
        "doc.go",
        "keytree.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/crypto/kdf/keytree",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/core/crypto",
        "//internal/service/crypto/kdf/hkdfsha256",
    ],
)

go_test(
    name = "keytree_test",
    srcs = [
        "api_gen_test.go",
        "keytree_external_test.go",
        "keytree_internal_test.go",
    ],
    embed = [":keytree"],
    deps = [
        "//internal/core/crypto",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":keytree",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)
