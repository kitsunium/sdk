load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "x25519",
    srcs = ["x25519.go"],
    importpath = "github.com/kitsunium/sdk/internal/service/crypto/x25519",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/crypto",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":x25519",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "x25519_test",
    srcs = [
        "x25519_external_test.go",
        "x25519_internal_test.go",
    ],
    embed = [":x25519"],
    deps = [
        "//internal/core/crypto",
        "//internal/kernel/errs",
    ],
)
