load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "logger",
    srcs = [
        "codes.go",
        "errors.go",
        "handler.go",
        "logger.go",
        "text_handler.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/logger",
    visibility = ["//internal/service:service_consumers"],
    deps = [
        "//internal/core/logger",
        "//internal/core/logger/level",
        "//internal/kernel/buffer",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/logger/encoder",
    ],
)

alias(
    name = "go_default_library",
    actual = ":logger",
    visibility = ["//internal/service:service_consumers"],
)

go_test(
    name = "logger_test",
    size = "small",
    srcs = [
        "handler_external_test.go",
        "handler_internal_test.go",
        "logger_external_test.go",
        "logger_internal_test.go",
        "text_handler_external_test.go",
        "text_handler_internal_test.go",
    ],
    embed = [":logger"],
    deps = [
        "//internal/core/logger",
        "//internal/core/logger/level",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/logger/encoder",
        "//internal/service/logger/sink/console",
    ],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
