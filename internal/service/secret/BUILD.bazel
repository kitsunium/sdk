load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "secret",
    srcs = [
        "codes.go",
        "env.go",
        "errors.go",
        "file.go",
        "file_config.go",
        "file_record.go",
        "fileguard_other.go",
        "fileguard_unix.go",
        "keyfile.go",
        "keyring.go",
        "memory.go",
        "rotator.go",
        "versions.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/secret",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/crypto",
        "//internal/core/lock",
        "//internal/core/proc",
        "//internal/core/secret",
        "//internal/core/vfs",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/crypto/aesgcm",
        "//internal/service/crypto/hkdfsha256",
        "//internal/service/crypto/hmacsha2",
        "//internal/service/lock",
        "//internal/service/vfs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":secret",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "secret_test",
    srcs = [
        "env_external_test.go",
        "file_external_test.go",
        "file_other_external_test.go",
        "keyfile_external_test.go",
        "keyring_external_test.go",
        "rotator_external_test.go",
        "store_external_test.go",
    ],
    deps = [
        ":secret",
        "//internal/core/crypto",
        "//internal/core/proc",
        "//internal/core/secret",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/lock",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
