load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "journald",
    srcs = [
        "codes.go",
        "decode.go",
        "errors.go",
        "journald.go",
        "journald_config.go",
        "journald_sink.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/writer/journald",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/logger",
        "//internal/core/logger/level",
        "//internal/core/writer",
        "//internal/kernel/errs",
        "//internal/service/logger/middleware/async",
        "//internal/service/writer/levelgate",
    ],
)

alias(
    name = "go_default_library",
    actual = ":journald",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "journald_test",
    srcs = [
        "decode_internal_test.go",
        "errors_external_test.go",
        "errors_internal_test.go",
        "journald_config_external_test.go",
        "journald_external_test.go",
        "journald_internal_test.go",
        "journald_sink_internal_test.go",
    ],
    embed = [":journald"],
    deps = [
        "//internal/core/logger",
        "//internal/core/logger/level",
        "//internal/core/writer",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's *.go to the errs AST audit (ADR 0015); the
# package defines new dotted-quad codes so it must be listed in the root
# //:audit_sources filegroup.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
