load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "gate",
    srcs = ["gate.go"],
    importpath = "github.com/kitsunium/sdk/internal/service/gate",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/entitlement",
        "//internal/core/gate",
    ],
)

alias(
    name = "go_default_library",
    actual = ":gate",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "gate_test",
    srcs = ["gate_internal_test.go"],
    embed = [":gate"],
    deps = [
        "//internal/core/entitlement",
        "//internal/core/gate",
    ],
)
