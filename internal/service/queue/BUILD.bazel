load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/service:service_consumers"])

go_library(
    name = "queue",
    srcs = [
        "codes.go",
        "consume.go",
        "consume_config.go",
        "dirtrust_posix.go",
        "dirtrust_windows.go",
        "errors.go",
        "file.go",
        "file_config.go",
        "file_dead.go",
        "file_name.go",
        "file_receive.go",
        "file_replay.go",
        "lease_expiry.go",
        "mem_record.go",
        "memory.go",
        "memory_config.go",
        "queue.go",
        "retry.go",
        "sql.go",
        "sql_config.go",
        "sql_dead.go",
        "sql_dialect.go",
        "sql_migration.go",
        "sql_receive.go",
        "wake.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/service/queue",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
    deps = [
        "//internal/core/queue",
        "//internal/core/sql",
        "//internal/core/vfs",
        "//internal/kernel/backoff",
        "//internal/kernel/clock",
        "//internal/kernel/collections/heap",
        "//internal/kernel/concur/group",
        "//internal/kernel/errs",
        "//internal/service/sql",
        "//internal/service/vfs",
    ] + select({
        "@rules_go//go/platform:windows": [
            "//internal/service/lock",
        ],
        "//conditions:default": [],
    }),
)

alias(
    name = "go_default_library",
    actual = ":queue",
    visibility = [
        "//:__subpackages__",
        "//internal/service:service_consumers",
    ],
)

go_test(
    name = "queue_test",
    size = "medium",
    srcs = [
        "conformance_external_test.go",
        "consume_external_test.go",
        "deadletter_external_test.go",
        "death_external_test.go",
        "dirtrust_internal_windows_test.go",
        "file_layout_external_test.go",
        "file_layout_windows_test.go",
        "harness_external_test.go",
        "order_external_test.go",
        "queue_bench_test.go",
        "sql_export_test.go",
        "sql_external_test.go",
        "sql_statements_external_test.go",
        "sqlfake_external_test.go",
        "wake_external_test.go",
        "wake_internal_test.go",
    ],
    embed = [":queue"],
    deps = [
        "//internal/core/proc",
        "//internal/core/queue",
        "//internal/core/sql",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/service/sql",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
