load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "logger",
    srcs = [
        "codes_gen.go",
        "decl_gen.go",
        "design_gen.go",
        "doc.go",
        "errors.go",
        "kind.go",
        "trace_context.go",
        "value.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/observe/logger",
    visibility = ["//internal/core:core_consumers"],
    deps = [
        "//internal/core/observe/logger/level",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":logger",
    visibility = ["//internal/core:core_consumers"],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)

go_test(
    name = "logger_test",
    srcs = [
        "api_gen_test.go",
        "kind_external_test.go",
        "kind_internal_test.go",
        "trace_context_external_test.go",
        "value_external_test.go",
        "value_internal_test.go",
    ],
    embed = [":logger"],
    deps = [
        "//internal/core/observe/logger/level",
        "//internal/kernel/errs",
    ],
)
