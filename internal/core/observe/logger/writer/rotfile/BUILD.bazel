load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "rotfile",
    srcs = [
        "codes_gen.go",
        "doc.go",
        "errors.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/observe/logger/writer/rotfile",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":rotfile",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "rotfile_test",
    srcs = [
        "api_gen_test.go",
        "errors_external_test.go",
        "errors_internal_test.go",
    ],
    embed = [":rotfile"],
    deps = ["//internal/kernel/errs"],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
