load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "writer",
    srcs = [
        "codes_gen.go",
        "config_console.go",
        "credentials.go",
        "decl_gen.go",
        "design_gen.go",
        "doc.go",
        "errors.go",
        "registry.go",
        "writer.go",
        "writer_spec.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/observe/logger/writer",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/level",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/kernel/plugin",
    ],
)

alias(
    name = "go_default_library",
    actual = ":writer",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "writer_test",
    srcs = [
        "api_gen_test.go",
        "config_decoder_external_test.go",
        "credentials_external_test.go",
        "registry_external_test.go",
        "registry_guard_external_test.go",
        "registry_internal_test.go",
        "writer_external_test.go",
    ],
    embed = [":writer"],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/level",
        "//internal/kernel/clock",
        "//internal/kernel/errs",
        "//internal/kernel/plugin",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST
# audit (//:audit_sources) so its errs.Define call sites are scanned under Bazel.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
