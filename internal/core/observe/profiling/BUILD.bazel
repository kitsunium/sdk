load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "profiling",
    srcs = [
        "codes.go",
        "errors.go",
        "folded.go",
        "goroutine.go",
        "profile.go",
        "profiling.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/observe/profiling",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":profiling",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "profiling_test",
    srcs = [
        "api_gen_test.go",
        "errors_external_test.go",
    ],
    deps = [
        ":profiling",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
