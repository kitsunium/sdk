load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "trace",
    srcs = [
        "attrs.go",
        "codes.go",
        "context.go",
        "design_gen.go",
        "errors.go",
        "event_value.go",
        "exporter.go",
        "identifier.go",
        "link_value.go",
        "sampler.go",
        "sampling_params.go",
        "scope.go",
        "span_context.go",
        "span_kind.go",
        "span_value.go",
        "spans_value.go",
        "state_builder.go",
        "state_value.go",
        "status_value.go",
        "trace.go",
        "trace_state_entry.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/observe/trace",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = [
        "//internal/core/observe/otel",
        "//internal/kernel/errs",
        "//internal/kernel/plugin",
    ],
)

alias(
    name = "go_default_library",
    actual = ":trace",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)

go_test(
    name = "trace_test",
    srcs = [
        "api_gen_test.go",
        "carrier_external_test.go",
        "model_external_test.go",
        "registry_guard_external_test.go",
        "span_context_external_test.go",
        "trace_bench_test.go",
        "trace_state_external_test.go",
    ],
    deps = [
        ":trace",
        "//internal/core/observe/metrics",
        "//internal/core/observe/otel",
        "//internal/kernel/errs",
    ],
)
