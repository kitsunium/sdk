load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "metrics",
    srcs = [
        "attrs.go",
        "codes_gen.go",
        "counter.go",
        "design_gen.go",
        "exporter.go",
        "gauge_value.go",
        "histogram_value.go",
        "observable.go",
        "scope.go",
        "snapshot_value.go",
        "sum_value.go",
        "temporality.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/observe/metrics",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = [
        "//internal/core/observe/otel",
        "//internal/kernel/errs",
        "//internal/kernel/plugin",
    ],
)

alias(
    name = "go_default_library",
    actual = ":metrics",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)

go_test(
    name = "metrics_test",
    srcs = [
        "api_gen_test.go",
        "describer_external_test.go",
        "exporter_external_test.go",
        "model_external_test.go",
        "registry_guard_external_test.go",
    ],
    deps = [
        ":metrics",
        "//internal/core/observe/otel",
        "//internal/kernel/errs",
    ],
)
