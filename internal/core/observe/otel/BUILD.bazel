load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "otel",
    srcs = [
        "attr_value.go",
        "decl_gen.go",
        "doc.go",
        "resource_value.go",
        "scope_value.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/observe/otel",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

alias(
    name = "go_default_library",
    actual = ":otel",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "otel_test",
    srcs = [
        "api_gen_test.go",
        "attr_bench_test.go",
        "model_external_test.go",
    ],
    deps = [
        ":otel",
        "//internal/kernel/errs",
    ],
)
