load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "view",
    srcs = [
        "codes.go",
        "config.go",
        "errors.go",
        "factory.go",
        "registry.go",
        "trusted.go",
        "view.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/view",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = [
        "//internal/kernel/errs",
        "//internal/kernel/snapshot",
    ],
)

alias(
    name = "go_default_library",
    actual = ":view",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "view_test",
    size = "small",
    srcs = [
        "registry_external_test.go",
        "view_external_test.go",
    ],
    # keep: TestTrustHTMLIsTheOnlyTrustConstructorTheDomainOffers parses this
    # package's own .go files at runtime to assert the ABSENCE of six symbols.
    # Bazel's sandbox strips the source-tree relationship, so the sources have
    # to reach the test as runfiles — the same mechanism //internal/kernel/errs
    # uses for its AST audits.
    data = ["//:audit_sources"],
    deps = [
        ":view",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
