load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "mail",
    srcs = [
        "address.go",
        "address_value.go",
        "attachment.go",
        "attachment_value.go",
        "codes.go",
        "delivery_value.go",
        "envelope_value.go",
        "errors.go",
        "header.go",
        "header_field_value.go",
        "mail.go",
        "message_value.go",
        "transport_interface.go",
        "validate.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/mail",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":mail",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "mail_test",
    size = "small",
    srcs = [
        "mail_external_test.go",
        "port_external_test.go",
    ],
    deps = [
        ":mail",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
