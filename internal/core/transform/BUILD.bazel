load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "transform",
    srcs = [
        "codes.go",
        "errors.go",
        "registry.go",
        "transform.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/transform",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = [
        "//internal/kernel/errs",
        "//internal/kernel/snapshot",
    ],
)

alias(
    name = "go_default_library",
    actual = ":transform",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "transform_test",
    size = "small",
    srcs = [
        "codes_external_test.go",
        "registry_external_test.go",
        "registry_internal_test.go",
        "transform_external_test.go",
    ],
    embed = [":transform"],
    deps = ["//internal/kernel/errs"],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST
# audit (//:audit_sources) so its errs.Define call sites are scanned under Bazel.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
