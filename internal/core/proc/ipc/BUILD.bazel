load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "ipc",
    srcs = [
        "codes_gen.go",
        "design_gen.go",
        "errors.go",
        "ipc.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/proc/ipc",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":ipc",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "ipc_test",
    srcs = [
        "api_gen_test.go",
        "ipc_external_test.go",
    ],
    deps = [
        ":ipc",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
