load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "rpc",
    srcs = [
        "doc.go",
        "gen_codes.go",
        "gen_ports.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/proc/ipc/rpc",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = [
        "//internal/core/proc/ipc",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":rpc",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "rpc_test",
    srcs = ["gen_api_test.go"],
    deps = [
        ":rpc",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
