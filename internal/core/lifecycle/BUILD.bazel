load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "lifecycle",
    srcs = [
        "codes.go",
        "errors.go",
        "lifecycle.go",
        "lifecycle_component.go",
        "lifecycle_phase.go",
        "lifecycle_transition.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/lifecycle",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":lifecycle",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "lifecycle_test",
    size = "small",
    srcs = ["lifecycle_external_test.go"],
    deps = [
        ":lifecycle",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
