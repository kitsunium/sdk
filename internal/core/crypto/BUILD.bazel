load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "crypto",
    srcs = [
        "aead.go",
        "agreement.go",
        "agreement_registry.go",
        "algorithm.go",
        "codes.go",
        "deriver.go",
        "deriver_registry.go",
        "errors.go",
        "hash_registry.go",
        "hasher.go",
        "key.go",
        "mac.go",
        "mac_registry.go",
        "password_hasher.go",
        "password_registry.go",
        "registry.go",
        "registry_generic.go",
        "seal.go",
        "signer.go",
        "signer_registry.go",
        "stream.go",
        "stream_registry.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/crypto",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = [
        "//internal/kernel/errs",
        "//internal/kernel/snapshot",
    ],
)

alias(
    name = "go_default_library",
    actual = ":crypto",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "crypto_test",
    srcs = [
        "agreement_registry_external_test.go",
        "agreement_registry_internal_test.go",
        "algorithm_external_test.go",
        "deriver_registry_external_test.go",
        "hash_registry_external_test.go",
        "key_external_test.go",
        "mac_registry_external_test.go",
        "password_registry_external_test.go",
        "password_registry_internal_test.go",
        "registry_external_test.go",
        "registry_generic_internal_test.go",
        "registry_internal_test.go",
        "seal_external_test.go",
        "signer_registry_external_test.go",
        "stream_registry_external_test.go",
    ],
    embed = [":crypto"],
    deps = ["//internal/kernel/errs"],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST
# audit (//:audit_sources) so its errs.Define call sites are scanned under Bazel.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
