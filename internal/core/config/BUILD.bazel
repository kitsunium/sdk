load("@rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "config",
    srcs = [
        "codes.go",
        "errors.go",
        "schema.go",
        "source.go",
        "validator.go",
        "watcher.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/config",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":config",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
