load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "cli",
    srcs = [
        "cli.go",
        "cli_command.go",
        "cli_invocation.go",
        "codes_gen.go",
        "design_gen.go",
        "errors.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/app/cli",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":cli",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "cli_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "cli_external_test.go",
    ],
    deps = [
        ":cli",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
