load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "events",
    srcs = [
        "codes_gen.go",
        "decl_gen.go",
        "design_gen.go",
        "doc.go",
        "errors.go",
        "events.go",
        "events_subscription.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/app/events",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":events",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "events_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "events_external_test.go",
    ],
    deps = [
        ":events",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
