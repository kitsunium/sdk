load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "mail",
    srcs = [
        "address_value.go",
        "attachment_value.go",
        "codes.go",
        "errors.go",
        "header.go",
        "mail.go",
        "message_value.go",
        "transport_interface.go",
        "value.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/app/mail",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":mail",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "mail_test",
    size = "small",
    srcs = ["port_external_test.go"],
    deps = [":mail"],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
