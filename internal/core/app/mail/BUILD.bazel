load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "mail",
    srcs = [
        "address_value.go",
        "attachment_value.go",
        "codes_gen.go",
        "design_gen.go",
        "errors.go",
        "header.go",
        "mail.go",
        "message_value.go",
        "value.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/app/mail",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":mail",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "mail_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "port_external_test.go",
    ],
    deps = [
        ":mail",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
