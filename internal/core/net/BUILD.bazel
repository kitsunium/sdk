load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "net",
    srcs = [
        "address.go",
        "call.go",
        "codes.go",
        "duration.go",
        "errors.go",
        "hook.go",
        "identity.go",
        "identity_params.go",
        "material.go",
        "policy.go",
        "request.go",
        "wrap.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/net",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":net",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "net_test",
    srcs = [
        "duration_external_test.go",
        "identity_external_test.go",
        "policy_external_test.go",
        "redaction_external_test.go",
        "testmaterial_external_test.go",
    ],
    deps = [
        ":net",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
