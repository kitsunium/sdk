load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "net",
    srcs = [
        "address.go",
        "call.go",
        "client_config.go",
        "codes.go",
        "conn.go",
        "conn_handler.go",
        "drain.go",
        "duration.go",
        "errors.go",
        "handler_compliance.go",
        "hook.go",
        "identity.go",
        "identity_file_params.go",
        "identity_params.go",
        "limits.go",
        "listener_state.go",
        "material.go",
        "middleware.go",
        "packet.go",
        "packet_handler.go",
        "phase.go",
        "policy.go",
        "policy_compliance.go",
        "request.go",
        "response.go",
        "sse.go",
        "state.go",
        "timeouts.go",
        "websocket.go",
        "websocket_close.go",
        "websocket_frame.go",
        "websocket_message.go",
        "websocket_opcode.go",
        "wrap.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/net",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":net",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "net_test",
    srcs = [
        "address_external_test.go",
        "conn_handler_external_test.go",
        "drain_external_test.go",
        "duration_external_test.go",
        "duration_internal_test.go",
        "identity_external_test.go",
        "identity_internal_test.go",
        "material_internal_test.go",
        "middleware_external_test.go",
        "packet_handler_external_test.go",
        "phase_external_test.go",
        "policy_external_test.go",
        "sse_external_test.go",
        "state_external_test.go",
        "websocket_bench_test.go",
        "websocket_external_test.go",
        "wrap_internal_test.go",
    ],
    embed = [":net"],
    deps = ["//internal/kernel/errs"],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
