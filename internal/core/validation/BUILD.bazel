load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "validation",
    srcs = [
        "codes.go",
        "errors.go",
        "path.go",
        "report.go",
        "validation.go",
        "violation.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/validation",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":validation",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "validation_test",
    size = "small",
    srcs = ["validation_external_test.go"],
    deps = [
        ":validation",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
