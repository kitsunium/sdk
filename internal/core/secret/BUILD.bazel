load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "secret",
    srcs = [
        "codes.go",
        "errors.go",
        "name.go",
        "secret.go",
        "value.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/secret",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":secret",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "secret_test",
    srcs = [
        "name_external_test.go",
        "secret_external_test.go",
        "value_external_test.go",
    ],
    deps = [
        ":secret",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
