load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "metrics",
    srcs = [
        "codes.go",
        "counter.go",
        "errors.go",
        "exporter.go",
        "gauge.go",
        "histogram.go",
        "histogram_value.go",
        "label.go",
        "meter.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/metrics",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = [
        "//internal/kernel/errs",
        "//internal/kernel/snapshot",
    ],
)

alias(
    name = "go_default_library",
    actual = ":metrics",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)

go_test(
    name = "metrics_test",
    srcs = [
        "exporter_external_test.go",
        "exporter_internal_test.go",
    ],
    embed = [":metrics"],
    deps = ["//internal/kernel/errs"],
)
