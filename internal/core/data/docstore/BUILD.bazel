load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "docstore",
    srcs = [
        "codes.go",
        "design_gen.go",
        "docstore.go",
        "errors.go",
        "index.go",
        "value.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/data/docstore",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":docstore",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "docstore_test",
    size = "small",
    srcs = [
        "api_gen_test.go",
        "docstore_external_test.go",
    ],
    deps = [
        ":docstore",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
