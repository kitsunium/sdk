load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "stream",
    srcs = [
        "doc.go",
        "gen_codes.go",
        "gen_ports.go",
        "partition.go",
        "policy.go",
        "record.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/data/stream",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":stream",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "stream_test",
    size = "small",
    srcs = [
        "gen_api_test.go",
        "partition_external_test.go",
        "policy_external_test.go",
        "service_range_external_test.go",
    ],
    deps = [
        ":stream",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
