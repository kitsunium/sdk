load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "codec",
    srcs = [
        "doc.go",
        "errors.go",
        "format.go",
        "gen_codes.go",
        "gen_ports.go",
        "registry.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/data/codec",
    visibility = ["//internal/core:core_consumers"],
    deps = [
        "//internal/kernel/errs",
        "//internal/kernel/plugin",
    ],
)

alias(
    name = "go_default_library",
    actual = ":codec",
    visibility = ["//internal/core:core_consumers"],
)

go_test(
    name = "codec_test",
    size = "small",
    srcs = [
        "appender_external_test.go",
        "format_external_test.go",
        "gen_api_test.go",
        "registration_order_external_test.go",
        "registry_external_test.go",
        "registry_guard_external_test.go",
        "registry_internal_test.go",
    ],
    # keep: TestNoCodecRegistersBeforeTheVariablesItsKeysRead parses every
    # codec's sources under internal/service/data/codec/ and third-party/codec/
    # at runtime. Bazel's sandbox strips the source-tree relationship, so they
    # reach the test as runfiles — the mechanism //internal/kernel/errs uses for
    # its AST audits.
    data = ["//:audit_sources"],
    embed = [":codec"],
    deps = [
        "//internal/kernel/errs",
        "//internal/kernel/plugin",
    ],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
