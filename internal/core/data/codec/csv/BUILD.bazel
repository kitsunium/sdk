load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "csv",
    srcs = [
        "codes.go",
        "errors.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/data/codec/csv",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":csv",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "csv_test",
    srcs = ["codes_external_test.go"],
    deps = [
        ":csv",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
