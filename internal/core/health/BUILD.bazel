load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "health",
    srcs = [
        "codes.go",
        "errors.go",
        "health.go",
        "health_check.go",
        "health_check_liveness.go",
        "health_check_readiness.go",
        "health_probe.go",
        "health_result.go",
        "health_status.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/health",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = ["//internal/kernel/errs"],
)

alias(
    name = "go_default_library",
    actual = ":health",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "health_test",
    srcs = ["health_external_test.go"],
    deps = [":health"],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
