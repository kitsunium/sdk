load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/core:core_consumers"])

go_library(
    name = "redact",
    srcs = [
        "codes_gen.go",
        "design_gen.go",
        "doc.go",
        "redact.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/core/security/redact",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
    deps = [
        "//internal/core/observe/logger",
        "//internal/kernel/errs",
    ],
)

alias(
    name = "go_default_library",
    actual = ":redact",
    visibility = [
        "//:__subpackages__",
        "//internal/core:core_consumers",
    ],
)

go_test(
    name = "redact_test",
    srcs = [
        "api_gen_test.go",
        "redact_external_test.go",
    ],
    deps = [
        ":redact",
        "//internal/kernel/errs",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
