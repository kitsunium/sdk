load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/kernel:kernel_consumers"])

go_library(
    name = "clock",
    srcs = [
        "clock.go",
        "clock_compliance.go",
        "manual.go",
        "manual_ticker.go",
        "manual_timer.go",
        "manual_wait.go",
        "system.go",
        "system_ticker.go",
        "system_timer.go",
        "ticker.go",
        "timer.go",
        "waiter.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/kernel/clock",
    visibility = ["//internal/kernel:kernel_consumers"],
)

alias(
    name = "go_default_library",
    actual = ":clock",
    visibility = ["//internal/kernel:kernel_consumers"],
)

go_test(
    name = "clock_test",
    size = "small",
    srcs = [
        "clock_bench_test.go",
        "clock_external_test.go",
        "clock_internal_test.go",
        "manual_external_test.go",
        "synctest_external_test.go",
        "waiter_external_test.go",
    ],
    embed = [":clock"],
)

filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
