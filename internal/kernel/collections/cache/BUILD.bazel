load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/kernel:kernel_consumers"])

go_library(
    name = "cache",
    srcs = [
        "cache.go",
        "config.go",
        "doc.go",
        "entry.go",
        "eviction.go",
        "ghost.go",
        "list.go",
        "policy.go",
        "s3fifo.go",
        "stats.go",
        "striped.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/kernel/collections/cache",
    visibility = [
        "//:__subpackages__",
        "//internal/kernel:kernel_consumers",
    ],
    deps = [
        "//internal/kernel/clock",
        "//internal/kernel/collections/heap",
    ],
)

alias(
    name = "go_default_library",
    actual = ":cache",
    visibility = [
        "//:__subpackages__",
        "//internal/kernel:kernel_consumers",
    ],
)

go_test(
    name = "cache_test",
    srcs = [
        "cache_bench_test.go",
        "cache_external_test.go",
        "cache_internal_test.go",
        "expire_external_test.go",
        "gen_api_test.go",
        "keys_external_test.go",
        "policy_bench_test.go",
        "policy_external_test.go",
        "striped_bench_test.go",
        "striped_external_test.go",
        "weight_external_test.go",
    ],
    embed = [":cache"],
    deps = ["//internal/kernel/clock"],
)
