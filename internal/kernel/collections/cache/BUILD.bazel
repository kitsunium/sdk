load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/kernel:kernel_consumers"])

go_library(
    name = "cache",
    srcs = [
        "cache.go",
        "decl_gen.go",
        "doc.go",
        "entry.go",
        "eviction.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/kernel/collections/cache",
    visibility = [
        "//:__subpackages__",
        "//internal/kernel:kernel_consumers",
    ],
    deps = ["//internal/kernel/clock"],
)

alias(
    name = "go_default_library",
    actual = ":cache",
    visibility = [
        "//:__subpackages__",
        "//internal/kernel:kernel_consumers",
    ],
)

go_test(
    name = "cache_test",
    srcs = [
        "api_gen_test.go",
        "cache_bench_test.go",
        "cache_external_test.go",
        "cache_internal_test.go",
    ],
    embed = [":cache"],
    deps = ["//internal/kernel/clock"],
)
