load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/kernel:kernel_consumers"])

go_library(
    name = "semver",
    srcs = [
        "doc.go",
        "gen_decls.go",
        "parse.go",
        "pseudo.go",
        "semver.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/kernel/semver",
    visibility = [
        "//:__subpackages__",
        "//internal/kernel:kernel_consumers",
    ],
)

alias(
    name = "go_default_library",
    actual = ":semver",
    visibility = [
        "//:__subpackages__",
        "//internal/kernel:kernel_consumers",
    ],
)

go_test(
    name = "semver_test",
    size = "small",
    srcs = [
        "gen_api_test.go",
        "gen_perf_test.go",
        "oracle_external_test.go",
        "parse_internal_test.go",
        "perf_fixtures_test.go",
        "pseudo_external_test.go",
        "semver_bench_test.go",
        "semver_external_test.go",
    ],
    embed = [":semver"],
)
