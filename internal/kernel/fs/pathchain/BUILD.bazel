load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//internal/kernel:kernel_consumers"])

go_library(
    name = "pathchain",
    srcs = [
        "decl_gen.go",
        "doc.go",
        "pathchain.go",
        "stack.go",
    ],
    importpath = "github.com/kitsunium/sdk/internal/kernel/fs/pathchain",
    visibility = [
        "//:__subpackages__",
        "//internal/kernel:kernel_consumers",
    ],
)

alias(
    name = "go_default_library",
    actual = ":pathchain",
    visibility = [
        "//:__subpackages__",
        "//internal/kernel:kernel_consumers",
    ],
)

go_test(
    name = "pathchain_test",
    srcs = [
        "api_gen_test.go",
        "pathchain_external_test.go",
    ],
    deps = [":pathchain"],
)
