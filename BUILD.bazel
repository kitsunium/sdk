load("@gazelle//:def.bzl", "gazelle")

# ── Gazelle directives ─────────────────────────────────────────────────
# Repo-wide Go import prefix; each layer root re-declares its own prefix
# so multi-module detection works correctly.
# gazelle:prefix github.com/kitsunium/sdk
# gazelle:go_naming_convention import_alias

gazelle(name = "gazelle")

# audit_sources lists every file the internal/kernel/errs AST audit reads
# at runtime. The audit walks internal/, pkg/, and third-party/ looking for
# errs.Define call sites + reads go.work for the workspace sentinel. Under Bazel the
# test sandbox strips the source-tree relationship, so the test target
# ships this filegroup as runfiles and resolves the root via TEST_SRCDIR
# + TEST_WORKSPACE. Filegroup stays in the root BUILD so all layers can
# reuse it if future audits land elsewhere.
filegroup(
    name = "audit_sources",
    srcs = [
        "go.work",
        "//internal/core/cache:audit_srcs",
        "//internal/core/codec:audit_srcs",
        "//internal/core/config:audit_srcs",
        "//internal/core/crypto:audit_srcs",
        "//internal/core/events:audit_srcs",
        "//internal/core/health:audit_srcs",
        "//internal/core/id:audit_srcs",
        "//internal/core/lifecycle:audit_srcs",
        "//internal/core/lock:audit_srcs",
        "//internal/core/logger:audit_srcs",
        "//internal/core/logger/level:audit_srcs",
        "//internal/core/metrics:audit_srcs",
        "//internal/core/net:audit_srcs",
        "//internal/core/proc:audit_srcs",
        "//internal/core/resilience:audit_srcs",
        "//internal/core/scheduler:audit_srcs",
        "//internal/core/session:audit_srcs",
        "//internal/core/token:audit_srcs",
        "//internal/core/trace:audit_srcs",
        "//internal/core/transform:audit_srcs",
