load("@gazelle//:def.bzl", "gazelle")

# ── Gazelle directives ─────────────────────────────────────────────────
# Repo-wide Go import prefix; each layer root re-declares its own prefix
# so multi-module detection works correctly.
# gazelle:prefix github.com/kitsunium/sdk
# gazelle:go_naming_convention import_alias

gazelle(name = "gazelle")

# audit_sources lists every file the internal/kernel/errs AST audit reads
# at runtime. The audit walks internal/, pkg/, third-party/ and framework/
# looking for errs.Define call sites + reads go.work for the workspace sentinel. Under Bazel the
# test sandbox strips the source-tree relationship, so the test target
# ships this filegroup as runfiles and resolves the root via TEST_SRCDIR
# + TEST_WORKSPACE. Filegroup stays in the root BUILD so all layers can
# reuse it if future audits land elsewhere.
filegroup(
    name = "audit_sources",
    srcs = [
        "go.work",
        "//framework/connectors/mysql:audit_srcs",
        "//framework/connectors/postgres:audit_srcs",
        "//framework/connectors/sqlite:audit_srcs",
        "//framework/connectors/ssh:audit_srcs",
        "//framework/internal/core/entitlement:audit_srcs",
        "//framework/internal/core/gate:audit_srcs",
        "//framework/internal/core/git:audit_srcs",
        "//framework/internal/core/selfupdate:audit_srcs",
        "//framework/internal/kit:audit_srcs",
        "//framework/internal/service/entitlement:audit_srcs",
        "//framework/internal/service/selfupdate:audit_srcs",
        "//framework/kit/storetest:audit_srcs",
