load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "s3",
    srcs = [
        "client.go",
        "codes.go",
        "cred_adapter.go",
        "errors.go",
        "s3.go",
        "s3sink.go",
    ],
    importpath = "github.com/kitsunium/sdk/third-party/aws/writer/s3",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/logger",
        "//internal/core/writer",
        "//internal/kernel/batcher",
        "//internal/kernel/errs",
        "//internal/service/logger/middleware/async",
        "//internal/service/writer/levelgate",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
    ],
)

alias(
    name = "go_default_library",
    actual = ":s3",
    visibility = ["//visibility:public"],
)

go_test(
    name = "s3_test",
    srcs = [
        "client_internal_test.go",
        "codes_external_test.go",
        "cred_adapter_internal_test.go",
        "s3_external_test.go",
        "s3_internal_test.go",
        "s3sink_internal_test.go",
    ],
    embed = [":s3"],
    deps = [
        "//internal/core/logger",
        "//internal/core/writer",
        "//internal/kernel/errs",
        "//internal/service/codec/baseenc",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_aws_smithy_go//middleware",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST
# audit (//:audit_sources) so its errs.Define call sites are scanned under Bazel.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
