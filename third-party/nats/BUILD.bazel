# gazelle:prefix github.com/kitsunium/sdk/third-party/nats

# third-party/nats is a Go module of its own (ADR 0157, ADR 0211): the queue
# broker over NATS JetStream (queue/) and its one vendor, nats.go. This
# directory holds no package; the file marks the module root as a Bazel
# package so gazelle's go_deps extension can load //third-party/nats:go.mod,
# which go.work names.

package(default_visibility = ["//visibility:public"])
