load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/kitsunium/sdk/third-party/db/writer/mysql

# third-party/db/writer/mysql is a Go module of its own (ADR 0157): the "mysql"
# logger writer and its one vendor, go-sql-driver/mysql. One vendor per module,
# so a consumer's graph carries the vendor it imports and no other.

package(default_visibility = ["//visibility:public"])

go_library(
    name = "mysql",
    srcs = [
        "client.go",
        "codes_gen.go",
        "errors.go",
        "mysql.go",
        "mysqlsink.go",
    ],
    importpath = "github.com/kitsunium/sdk/third-party/db/writer/mysql",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/writer",
        "//internal/kernel/errs",
        "//internal/service/observe/logger/writer/dbsink",
        "@com_github_go_sql_driver_mysql//:mysql",
    ],
)

alias(
    name = "go_default_library",
    actual = ":mysql",
    visibility = ["//visibility:public"],
)

# audit_srcs ships this package's *.go to the errs AST audit (ADR 0015); the
# package defines new dotted-quad codes (0.3.32.*) so it must be listed in the
# root //:audit_sources filegroup.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)

go_test(
    name = "mysql_test",
    srcs = [
        "api_gen_test.go",
        "client_internal_test.go",
        "errors_external_test.go",
        "errors_internal_test.go",
        "mysql_external_test.go",
        "mysql_internal_test.go",
        "mysqlsink_internal_test.go",
    ],
    embed = [":mysql"],
    deps = [
        "//internal/core/observe/logger",
        "//internal/core/observe/logger/level",
        "//internal/core/observe/logger/writer",
        "//internal/kernel/errs",
    ],
)
