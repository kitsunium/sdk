load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "protobuf",
    srcs = [
        "codec.go",
        "codes.go",
        "errors.go",
    ],
    importpath = "github.com/kitsunium/sdk/third-party/codec/protobuf",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/codec",
        "//internal/kernel/errs",
        "@org_golang_google_protobuf//proto",
    ],
)

alias(
    name = "go_default_library",
    actual = ":protobuf",
    visibility = ["//visibility:public"],
)

go_test(
    name = "protobuf_test",
    srcs = [
        "codec_external_test.go",
        "codec_internal_test.go",
    ],
    embed = [":protobuf"],
    deps = [
        "//internal/core/codec",
        "//internal/kernel/errs",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/structpb",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
