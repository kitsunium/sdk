load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/kitsunium/sdk/third-party/codec/protobuf

# third-party/codec/protobuf is a Go module of its own (ADR 0157): the Protocol
# Buffers codec and its one vendor, google.golang.org/protobuf. One vendor per
# module, so a consumer's graph carries the vendor it imports and no other.

package(default_visibility = ["//visibility:public"])

go_library(
    name = "protobuf",
    srcs = [
        "codec.go",
        "codes.go",
        "errors.go",
    ],
    importpath = "github.com/kitsunium/sdk/third-party/codec/protobuf",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/codec",
        "//internal/kernel/errs",
        "@org_golang_google_protobuf//proto",
    ],
)

alias(
    name = "go_default_library",
    actual = ":protobuf",
    visibility = ["//visibility:public"],
)

go_test(
    name = "protobuf_test",
    srcs = [
        "codec_bench_test.go",
        "codec_external_test.go",
        "codec_internal_test.go",
    ],
    embed = [":protobuf"],
    deps = [
        "//internal/core/codec",
        "//internal/kernel/errs",
        "//internal/service/codec/cbor",
        "//internal/service/codec/json",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/descriptorpb",
        "@org_golang_google_protobuf//types/known/structpb",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
