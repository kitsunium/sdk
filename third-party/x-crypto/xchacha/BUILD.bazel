load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "xchacha",
    srcs = ["xchacha.go"],
    importpath = "github.com/kitsunium/sdk/third-party/x-crypto/xchacha",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/crypto",
        "//internal/kernel/errs",
        "@org_golang_x_crypto//chacha20poly1305",
    ],
)

alias(
    name = "go_default_library",
    actual = ":xchacha",
    visibility = ["//visibility:public"],
)

go_test(
    name = "xchacha_test",
    srcs = [
        "xchacha_external_test.go",
        "xchacha_internal_test.go",
    ],
    embed = [":xchacha"],
    deps = [
        "//internal/core/crypto",
        "//internal/kernel/errs",
    ],
)
