load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/kitsunium/sdk/third-party/transform

# third-party/transform is a Go module of its own (ADR 0157): the zstd and s2
# compressors and their one vendor, klauspost/compress. One vendor per module,
# so a consumer's graph carries the vendor it imports and no other.

package(default_visibility = ["//visibility:public"])

go_library(
    name = "transform",
    srcs = [
        "bounded.go",
        "bounded_compliance.go",
        "doc.go",
        "errors.go",
        "gen_codes.go",
        "s2.go",
        "stream.go",
        "transform.go",
        "zstd.go",
    ],
    importpath = "github.com/kitsunium/sdk/third-party/transform",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/data/transform",
        "//internal/kernel/concur/recycler",
        "//internal/kernel/errs",
        "@com_github_klauspost_compress//s2",
        "@com_github_klauspost_compress//zstd",
    ],
)

alias(
    name = "go_default_library",
    actual = ":transform",
    visibility = ["//visibility:public"],
)

go_test(
    name = "transform_test",
    srcs = [
        "allocwindow_test.go",
        "bomb_external_test.go",
        "bounded_external_test.go",
        "conformance_external_test.go",
        "decompress_alloc_test.go",
        "dictionary_external_test.go",
        "fuzz_external_test.go",
        "gen_api_test.go",
        "main_external_test.go",
        "snapshot_bench_test.go",
        "snapshot_external_test.go",
        "stream_external_test.go",
        "transform_bench_test.go",
        "transform_external_test.go",
        "transform_internal_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":transform"],
    deps = [
        "//internal/core/app/consensus",
        "//internal/core/data/transform",
        "//internal/kernel/errs",
        "//internal/service/app/consensus",
        "//internal/service/data/transform",
        "@com_github_klauspost_compress//s2",
        "@com_github_klauspost_compress//zstd",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST
# audit (errs.Define emitters must be in //:audit_sources).
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
