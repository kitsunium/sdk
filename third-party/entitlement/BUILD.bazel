load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "entitlement",
    srcs = [
        "discover.go",
        "enroll.go",
        "key.go",
        "key_unix.go",
        "key_windows.go",
        "sshidentity.go",
        "sshidentity_compliance.go",
    ],
    importpath = "github.com/kitsunium/sdk/third-party/entitlement",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/core/entitlement",
        "//internal/service/entitlement",
        "@org_golang_x_crypto//ssh",
    ],
)

alias(
    name = "go_default_library",
    actual = ":entitlement",
    visibility = ["//visibility:public"],
)

go_test(
    name = "entitlement_test",
    srcs = [
        "cache_external_test.go",
        "enroll_external_test.go",
        "enroll_internal_test.go",
        "enroll_unix_external_test.go",
        "grant_external_test.go",
        "identity_external_test.go",
        "key_external_test.go",
        "key_internal_test.go",
        "key_unix_internal_test.go",
        "key_windows_internal_test.go",
        "origin_external_test.go",
        "product_external_test.go",
        "roster_parse_external_test.go",
        "service_external_test.go",
        "service_unix_external_test.go",
        "version_external_test.go",
    ],
    embed = [":entitlement"],
    deps = [
        "//internal/core/entitlement",
        "//internal/service/entitlement",
        "@org_golang_x_crypto//ssh",
    ],
)

# audit_srcs ships this package's .go files to the //internal/kernel/errs AST audit.
filegroup(
    name = "audit_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
